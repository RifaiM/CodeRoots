---

<LessonLayout
    title="Project 08: Reusable React Components | Level 5 React Dojo"
    description="Build modular, reusable React UI components by composing small functional pieces into interactive application views."
    levelTag="Level 5 • React Dojo"
    lessonNum={8}
    lessonTitle="Reusable React Components"
    xpAmount={150}
    completionKey="partC_lesson8_remake_complete"
    nextLessonUrl="/3. partC/lesson9/lesson9_remake.html"
    hubUrl="/3. partC/hub.html"
    hubTitle="Level 5 Hub"
    hubIcon="⚛️"
    fileTab="App.jsx"
    starterCode={starterCode}
    mode="html"
    jumpLessons={level5Lessons}
    certificateUrl="/3. partC/certificate.html"
    trackPrefix="partC"
>
    <!-- Intro Slot -->
    <p class="lesson-subtitle" slot="intro">
        Build modular, reusable React UI components by composing small functional pieces into interactive application views.
    </p>

        <!-- Concept Slot (Left Pane) -->
    <div slot="concept" style="display: flex; flex-direction: column; gap: 16px;">
        
        <!-- Core Concept & Analogy -->
        <article class="concept-card">
            <h3><span>💡</span> Core Concept &amp; Mental Model</h3>
            <div class="analogy-callout">
                <strong>Real-World Analogy:</strong> props.children is like a picture frame. The frame provides the border, padding, and layout, while whatever elements you place inside <CardShell>...</CardShell> are rendered within the frame.
            </div>
        </article>

        <!-- Interactive Feature Explorer -->
        <article class="concept-card">
            <h3><span>⚛️</span> Component Composition & Children</h3>
            <p style="color: #475569; font-size: 0.88rem; margin: 0 0 10px 0;">Key syntax building blocks and architecture patterns:</p>
            <div class="tag-demo">
                <div class="tag-example">
                    <div class="tag-code">function Shell({ children })</div>
                    <div class="tag-result">Receives nested JSX elements as children prop</div>
                </div>
                <div class="tag-example">
                    <div class="tag-code"><Shell><p>Nested</p></Shell></div>
                    <div class="tag-result">Passes inner elements between component tags</div>
                </div>
                <div class="tag-example">
                    <div class="tag-code"><Shell {...props}></div>
                    <div class="tag-result">Forwards layout styles and wrapper architecture</div>
                </div>
            </div>
        </article>

        <!-- Working Reference Code & Architecture Snippet -->
        <article class="concept-card">
            <h3><span>💻</span> Reference Architecture Pattern</h3>
            <p style="color: #475569; font-size: 0.88rem; margin: 0 0 8px 0;">How this pattern is structured in production React applications:</p>
            <div class="code-snippet-box">
                <button class="snippet-copy-btn" onclick="navigator.clipboard.writeText(document.getElementById('refCodeBox_8')?.innerText || '')">📋 Copy</button>
                <pre><code id="refCodeBox_8">function CardShell({ title, children }) {
  return (
    &lt;div className="shell-container"&gt;
      &lt;h3&gt;{title}&lt;/h3&gt;
      &lt;div className="shell-body"&gt;
        {children}
      &lt;/div&gt;
    &lt;/div&gt;
  );
}</code></pre>
            </div>
        </article>

        <!-- Task Instructions Card -->
        <article class="concept-card" style="border-left: 4px solid #2563eb;">
            <h3><span>🎯</span> Your Hands-On Coding Goal</h3>
            <ol style="color: #334155; font-size: 0.90rem; line-height: 1.7; padding-left: 20px; margin: 0;">
                <li>Render <code>&#123;children&#125;</code> inside <code>CardShell</code>.</li>
                <li>Compose elements between <code>&lt;CardShell&gt;...&lt;/CardShell&gt;</code> tags.</li>
            </ol>
        </article>

    </div>
</LessonLayout>

<!-- Client-Side Scripts & Verification Engine -->
<script>
    import { DojoEngine } from '../../../scripts/dojo';

    function initLesson() {
        const editor = document.getElementById('lessonEditor') as HTMLTextAreaElement | null;
        const lineNumbers = document.getElementById('ideLineNumbers');
        const lineNumbersInner = document.getElementById('ideLineNumbersInner') || lineNumbers;
        const previewIframe = document.getElementById('livePreviewIframe') as HTMLIFrameElement | null;
        const checkBtn = document.getElementById('checkAnswerBtn');
        const resetBtn = document.getElementById('resetEditorBtn');

        if (!editor) return;

        const DRAFT_KEY = 'novicodes_draft_partC_lesson8';
        const DEFAULT_STARTER = `// 🖼️ Lesson 8: Component Composition & props.children!

function CardShell(props) {
  return (
    <div style={{ background: '#ffffff', border: '1px solid #cbd5e1', borderRadius: '14px', padding: '16px', marginBottom: '14px' }}>
      {/* Step 1: Render props.children inside this container */}
    </div>
  );
}

function DevDashboard() {
  return (
    <div style={{ padding: '16px', fontFamily: 'sans-serif', maxWidth: '440px', margin: '0 auto' }}>
      {/* Step 2: Compose children between CardShell tags */}
    </div>
  );
}

const root = ReactDOM.createRoot(document.getElementById('root'));
root.render(<DevDashboard />);`;

        // 1. Initialize Real-Time Conceptual Checklist
        DojoEngine.initChecklist([
            {
                id: 'children',
                label: 'Render <code>{children}</code> inside container',
                fn: (code) => /\{\s*children\s*\}|\{\s*props\.children\s*\}/i.test(code)
            },
            {
                id: 'compose',
                label: 'Compose elements between <code>&lt;CardShell&gt;...&lt;/CardShell&gt;</code>',
                fn: (code) => /<CardShell[^>]*>[\s\S]+<\/CardShell>/i.test(code)
            }
        ], {
            containerId: 'taskChecklist',
            submitBtnId: 'checkAnswerBtn',
            nextBtnId: 'nextLessonBtn',
            mode: 'html'
        });

        // 2. Line numbers & scroll sync
        function syncScroll() {
            if (lineNumbersInner && editor) {
                lineNumbersInner.style.transform = `translateY(-${editor.scrollTop}px)`;
            }
        }

        function updateEditor() {
            if (!editor || !lineNumbersInner) return;
            const lines = editor.value.split('\n');
            const lineCount = Math.max(lines.length, 1);
            lineNumbersInner.textContent = Array.from({ length: lineCount }, (_, i) => i + 1).join('\n');
            syncScroll();

            // Render live React JSX preview inside iframe
            if (previewIframe) {
                const code = editor.value;
                const htmlDoc = `<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <script src="https://unpkg.com/react@18/umd/react.development.js"><\/script>
  <script src="https://unpkg.com/react-dom@18/umd/react-dom.development.js"><\/script>
  <script src="https://unpkg.com/@babel/standalone/babel.min.js"><\/script>
  <style>
    body { margin: 0; padding: 12px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; background: #ffffff; color: #0f172a; }
  </style>
</head>
<body>
  <div id="root"></div>
  <script type="text/babel">
    try {
      ${code}
    } catch (err) {
      document.getElementById('root').innerHTML = '<div style="color:#ef4444; background:#fef2f2; border:1px solid #fecaca; padding:12px; border-radius:8px; font-size:13px; font-family:monospace;"><b>⚠️ Render Error:</b> ' + err.message + '</div>';
    }
  <\/script>
</body>
</html>`;
                previewIframe.srcdoc = htmlDoc;
            }

            // Real-Time Checklist Verification
            DojoEngine.runChecklist(editor.value);
        }

        // 3. Draft Auto-Save & Crash Resilience
        DojoEngine.setupDraftPersistence(editor, DRAFT_KEY, DEFAULT_STARTER, updateEditor);

        editor.addEventListener('scroll', syncScroll);

        editor.addEventListener('keydown', (e) => {
            if (e.key === 'Tab') {
                e.preventDefault();
                const start = editor.selectionStart;
                const end = editor.selectionEnd;
                editor.value = editor.value.substring(0, start) + '  ' + editor.value.substring(end);
                editor.selectionStart = editor.selectionEnd = start + 2;
                updateEditor();
            }
        });

        // 4. Safe Reset Button Handler
        if (resetBtn) {
            DojoEngine.setupResetButton(resetBtn, editor, DRAFT_KEY, DEFAULT_STARTER, updateEditor);
        }

        // 5. Check & Verify Code Action
        if (checkBtn) {
            checkBtn.addEventListener('click', () => {
                const code = editor.value;

                if (DojoEngine.isEmpty(code)) {
                    DojoEngine.showLint('Your code editor is empty! Write your code before verifying.', 'error', 'Follow the step-by-step instructions in the left pane.');
                    return;
                }

                const result = DojoEngine.runChecklist(code);

                if (result.allPassed) {
                    DojoEngine.clearLint();
                    DojoEngine.celebrateCompletion({
                        lessonTitle: 'Project 08: Reusable React Components',
                        xp: 150,
                        completionKey: 'partC_lesson8_remake_complete',
                        nextUrl: '/3. partC/lesson9/lesson9_remake.html',
                        customMessage: 'You have mastered this React Dojo challenge!'
                    });
                } else {
                    DojoEngine.showLint('Project requirements incomplete', 'warning', 'Check the task checklist below to see remaining requirements.');
                }
            });
        }

        updateEditor();
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initLesson);
    } else {
        initLesson();
    }
</script>
