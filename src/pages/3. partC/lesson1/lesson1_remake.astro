const starterCode = "// 🛠️ Level 5 Lesson 1 Practice Task: ES6+ Powers!\n\n// 1. Initial user object:\nconst developer = {\n    name: \"Alex\",\n    role: \"Frontend Developer\",\n    skills: [\"HTML5\", \"CSS3\", \"JavaScript\"]\n};\n\n// Step 1: Use Spread Operator (...) to create an immutable copy named 'updatedDev' with a new property 'level: \"Level 5 Master\"'\n// Write your spread code here:\n\n\n// Step 2: Use Object Destructuring to extract 'name', 'role', 'skills', and 'level' from 'updatedDev'\n// Write your destructuring code here:\n\n\n// Step 3: Write an Arrow Function named 'renderProfile' that returns a formatted HTML template string\nconst renderProfile = () => {\n    // Step 4: Use .map() on the 'skills' array to generate formatted badge strings\n    const skillBadges = \"\";\n\n    return `\n        <div style=\"font-family: sans-serif; padding: 20px; border-radius: 16px; background: #f8fafc; border: 1px solid #cbd5e1; max-width: 380px;\">\n            <h2 style=\"margin: 0 0 6px 0; color: #0f172a;\">👤 ${typeof name !== 'undefined' ? name : 'Developer'}</h2>\n            <p style=\"margin: 0 0 8px 0; color: #64748b; font-weight: 600;\">💻 ${typeof role !== 'undefined' ? role : 'Role'}</p>\n            <p style=\"margin: 0 0 14px 0; color: #059669; font-weight: 700; font-size: 13px;\">🏆 ${typeof level !== 'undefined' ? level : 'Level'}</p>\n            <div>${skillBadges}</div>\n        </div>\n    `;\n};\n\n// Render output to screen\ndocument.getElementById('root').innerHTML = renderProfile();";

