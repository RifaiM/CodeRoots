    // Step 4: Use .map() on the 'skills' array to generate formatted badge strings
    const skillBadges = "";

    return \`
        <div style="font-family: sans-serif; padding: 20px; border-radius: 16px; background: #f8fafc; border: 1px solid #cbd5e1; max-width: 380px;">
            <h2 style="margin: 0 0 6px 0; color: #0f172a;">👤 \${typeof name !== 'undefined' ? name : 'Developer'}</h2>
