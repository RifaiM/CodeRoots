import LessonLayout from '../../../layouts/LessonLayout.astro';

const starterCode = `// 🎁 Lesson 4: Custom Reusable Props & Dynamic Product Cards!

// Step 1: Destructure props { name, price, category, isAvailable } in ProductCard parameter list
function ProductCard(props) {
  return (
    <div style={{ background: '#ffffff', border: '1px solid #e2e8f0', borderRadius: '14px', padding: '16px' }}>
      <div>{props.category}</div>
      <h3>{props.name}</h3>
      <p>\${props.price}</p>
    </div>
  );
}

function App() {
  return (
    <div style={{ fontFamily: 'sans-serif', maxWidth: '440px', margin: '0 auto', padding: '16px' }}>
      <h2>🛍️ DevDojo Gear Store</h2>
      {/* Step 2: Render at least two ProductCard elements */}
      <div style={{ display: 'grid', gridTemplateColumns: '1fr', gap: '12px' }}>
      </div>
    </div>
  );
}

const root = ReactDOM.createRoot(document.getElementById('root'));
root.render(<App />);`;

