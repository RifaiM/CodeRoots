import LessonLayout from '../../../layouts/LessonLayout.astro';

const starterCode = `// 🎁 Lesson 4: Custom Reusable Props & Dynamic Product Cards!

// 👉 STEP 1: Child Component - Destructure { name, price, category, isAvailable } in parameters
function ProductCard(props) {
  return (
    <div style={{ background: '#ffffff', border: '1px solid #e2e8f0', borderRadius: '14px', padding: '16px' }}>
      <div>{props.category}</div>
      <h3>{props.name}</h3>
      <p style={{ fontWeight: '800', color: '#059669' }}>\${props.price}</p>
      <span>{props.isAvailable ? "🟢 In Stock" : "🔴 Out of Stock"}</span>
    </div>
  );
}

// Parent Component: App (Passing Props to Reusable Children)
function App() {
  return (
    <div style={{ padding: '20px', fontFamily: 'sans-serif', maxWidth: '600px', margin: '0 auto' }}>
      <h2>🛍️ DevDojo Gear Store</h2>
      <div style={{ display: 'grid', gridTemplateColumns: 'repeat(auto-fit, minmax(160px, 1fr))', gap: '14px' }}>
        {/* 👉 STEP 2: Render <ProductCard /> with name="Mechanical Keyboard" price={129.99} category="Peripherals" isAvailable={true} */}
        
      </div>
    </div>
  );
}

const root = ReactDOM.createRoot(document.getElementById('root'));
root.render(<App />);
`;
