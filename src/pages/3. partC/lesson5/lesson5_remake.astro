<LessonLayout
    title="Project 05: Array Map & Filter | Level 5 React Dojo"
    description="Add reactive memory to your components with React's useState hook: track user clicks and update the UI instantly."
    levelTag="Level 5 • Framework Dojo"
    lessonNum={5}
    lessonTitle="Interactive State with useState()"
    xpAmount={150}
    completionKey="partC_lesson5_remake_complete"
    nextLessonUrl="/3. partC/lesson6/lesson6_remake.html"
    hubUrl="/3. partC/hub.html"
    hubTitle="Level 5 Hub"
    hubIcon="⚛️"
    fileTab="App.jsx"
    starterCode={starterCode}
    mode="html"
    jumpLessons={level5Lessons}
    certificateUrl="/3. partC/certificate.html"
    trackPrefix="partC"
>
    <!-- Intro Slot -->
    <p class="lesson-subtitle" slot="intro">
        Transform and filter data collections declaratively using array map, filter, and reduce methods in modern JavaScript.
    </p>

    <!-- Concept Slot (Left Pane) -->
    <div slot="concept" style="display: flex; flex-direction: column; gap: 16px;">
        
        <!-- 🎯 PROGATE-STYLE TOP MISSION CARD: Immediately informs learner what to do -->
        <!-- Unified Mission Card -->
        <article class="concept-card mission-card">
            <div class="mission-header">
                <h3><span>🎯</span> Your Mission</h3>
                <span class="checklist-counter" id="checklistCounter">0 / 2</span>
            </div>
            <div class="target-output-preview" style="background: #f1f5f9; border-radius: 8px; padding: 10px 12px; margin: 8px 0 12px 0; border: 1px dashed #94a3b8; font-size: 0.82rem;">
                <strong style="color: #334155;">🖼️ Target Goal:</strong>
                <div style="color: #475569; margin-top: 3px;">An interactive Like button with a live counter 💖 that increments from 0 to 1, 2, 3... every time you click it!</div>
            </div>
            <p class="mission-subtitle">Follow the step-by-step instructions below in the editor:</p>
            <div id="taskChecklist"></div>
        </article>
        
        <!-- Core Concept & Analogy -->
        <article class="concept-card">
            <h3><span>💡</span> Core Concept &amp; Mental Model</h3>
            <div class="analogy-callout">
                <strong>Real-World Analogy:</strong> <code>useState</code> is like a digital clicker tally counter in the palm of your hand. When you click the button, the counter clicks up and the display updates automatically.
            </div>
        </article>

        <!-- Interactive Feature Explorer -->
        <article class="concept-card">
            <h3><span>⚛️</span> React useState Lifecycle</h3>
            <p style="color: #475569; font-size: 0.88rem; margin: 0 0 10px 0;">Key syntax building blocks and architecture patterns:</p>
            <div class="tag-demo">
                <div class="tag-example">
                    <div class="tag-code">{"const [count, setCount] = useState(0)"}</div>
                    <div class="tag-result">{"Initializes state with 0 and returns setter"}</div>
                </div>
                <div class="tag-example">
                    <div class="tag-code">{"setCount(count + 1)"}</div>
                    <div class="tag-result">{"Updates state value and triggers reactive UI re-render"}</div>
                </div>
                <div class="tag-example">
                    <div class="tag-code">{"onClick={() => setCount(0)}"}</div>
                    <div class="tag-result">{"Resets counter on button click event"}</div>
                </div>
            </div>
        </article>

        <!-- Working Reference Code & Architecture Snippet -->
        <article class="concept-card">
            <h3><span>💻</span> Reference Architecture Pattern</h3>
            <p style="color: #475569; font-size: 0.88rem; margin: 0 0 8px 0;">How this pattern is structured in production React applications:</p>
            <div class="code-snippet-box">
                <button class="snippet-copy-btn" onclick="navigator.clipboard.writeText(document.getElementById('refCodeBox_5')?.innerText || '')">📋 Copy</button>
                <pre><code id="refCodeBox_5">{"import React, { useState } from 'react';\n\nfunction Counter() {\n  const [count, setCount] = useState(0);\n\n  return (\n    <div className=\"counter-box\">\n      <h2>Count: {count}</h2>\n      <button onClick={() => setCount(count + 1)}>Increment ➕</button>\n      <button onClick={() => setCount(0)}>Reset 🔄</button>\n    </div>\n  );\n}"}</code></pre>
            </div>
        </article>

        

    </div>
</LessonLayout>

<!-- Client-Side Scripts & Verification Engine -->
<script>
    import { DojoEngine } from '../../../scripts/dojo';

    function initLesson() {
        const editor = document.getElementById('lessonEditor') as HTMLTextAreaElement | null;
        const lineNumbers = document.getElementById('ideLineNumbers');
        const lineNumbersInner = document.getElementById('ideLineNumbersInner') || lineNumbers;
        const previewIframe = document.getElementById('livePreviewIframe') as HTMLIFrameElement | null;
        const checkBtn = document.getElementById('checkAnswerBtn');
        const resetBtn = document.getElementById('resetEditorBtn');

        if (!editor) return;

        const DRAFT_KEY = 'novicodes_draft_partC_lesson5';
        const DEFAULT_STARTER = "// ⚡ Lesson 5: React State (useState) & Interactive Events!\n\nfunction DojoCounterApp() {\n  // Step 1: Declare state 'likes' and setter 'setLikes' using React.useState(0)\n  const likes = 0;\n\n  // Step 2: Component Event Handlers\n  const handleLike = () => {\n    // Write setLikes increment here:\n  };\n\n  const handleReset = () => {\n    // Write setLikes(0) here:\n  };\n\n  return (\n    <div style={{ padding: '24px', fontFamily: 'sans-serif', maxWidth: '420px', margin: '0 auto', textAlign: 'center' }}>\n      <div style={{ background: '#f8fafc', border: '1px solid #cbd5e1', borderRadius: '16px', padding: '24px' }}>\n        <h2>⚡ DevDojo Like Booster</h2>\n        <div style={{ fontSize: '2.5rem', fontWeight: '800', margin: '20px 0' }}>\n          ❤️ {likes} Likes\n        </div>\n        <div style={{ display: 'flex', gap: '8px', justifyContent: 'center' }}>\n          <button onClick={handleLike} style={{ background: '#10b981', color: 'white', border: 'none', padding: '10px 18px', borderRadius: '10px', fontWeight: '700', cursor: 'pointer' }}>\n            👍 Like (+1)\n          </button>\n          <button onClick={handleReset} style={{ background: '#64748b', color: 'white', border: 'none', padding: '10px 18px', borderRadius: '10px', fontWeight: '700', cursor: 'pointer' }}>\n            🔄 Reset\n          </button>\n        </div>\n      </div>\n    </div>\n  );\n}\n\nconst root = ReactDOM.createRoot(document.getElementById('root'));\nroot.render(<DojoCounterApp />);";

        // 1. Initialize Real-Time Conceptual Checklist
        DojoEngine.initChecklist([
            { id: 'usestate', label: 'Declare <code>const [likes, setLikes] = React.useState(0)</code>', fn: (code) => { const c = code.replace(/\/\*[\s\S]*?\*\//g, '').replace(/(?<!:)\/\/[^\r\n]*/g, ''); return /const\s*\[\s*likes\s*,\s*setLikes\s*\]\s*=\s*(?:React\.)?useState\s*\(\s*0\s*\)/i.test(c); } },
            { id: 'setlikes', label: 'Call <code>setLikes(likes + 1)</code> inside handleLike', fn: (code) => { const c = code.replace(/\/\*[\s\S]*?\*\//g, '').replace(/(?<!:)\/\/[^\r\n]*/g, ''); return /setLikes\s*\(\s*likes\s*\+\s*1\s*\)/i.test(c) || /setLikes\s*\(\s*\(?l\)?\s*=>\s*l\s*\+\s*1\s*\)/i.test(c); } }
        ], {
            containerId: 'taskChecklist',
            mode: 'javascript'
        });

        // 2. Line numbers & scroll sync
        function syncScroll() {
            if (lineNumbersInner && editor) {
                lineNumbersInner.style.transform = `translateY(-${editor.scrollTop}px)`;
            }
        }

        function updateEditor() {
            if (!editor || !lineNumbersInner) return;
            const lines = editor.value.split('\n');
            const lineCount = Math.max(lines.length, 1);
            lineNumbersInner.textContent = Array.from({ length: lineCount }, (_, i) => i + 1).join('\n');
            syncScroll();

            // Render live React JSX preview inside iframe
            if (previewIframe) {
                const code = editor.value;
                const htmlDoc = `<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <script src="https://unpkg.com/react@18/umd/react.development.js"><\/script>
  <script src="https://unpkg.com/react-dom@18/umd/react-dom.development.js"><\/script>
  <script src="https://unpkg.com/@babel/standalone/babel.min.js"><\/script>
  <style>
    body { margin: 0; padding: 12px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; background: #ffffff; color: #0f172a; }
  </style>
</head>
<body>
  <div id="root"></div>
  <script type="text/babel">
    try {
      ${code}
    } catch (err) {
      document.getElementById('root').innerHTML = '<div style="color:#ef4444; background:#fef2f2; border:1px solid #fecaca; padding:12px; border-radius:8px; font-size:13px; font-family:monospace;"><b>⚠️ Render Error:</b> ' + err.message + '</div>';
    }
  <\/script>
</body>
</html>`;
                previewIframe.srcdoc = htmlDoc;
            }

            // Real-Time Checklist Verification
            // Real-Time JavaScript & React Diagnostics
            DojoEngine.lint(editor.value, 'javascript');

            // Real-Time Checklist Verification
            DojoEngine.runChecklist(editor.value);
        }

        // 3. Draft Auto-Save & Crash Resilience
        DojoEngine.setupDraftPersistence(editor, DRAFT_KEY, DEFAULT_STARTER, updateEditor);

        editor.addEventListener('scroll', syncScroll);

        editor.addEventListener('keydown', (e) => {
            if (e.key === 'Tab') {
                e.preventDefault();
                const start = editor.selectionStart;
                const end = editor.selectionEnd;
                editor.value = editor.value.substring(0, start) + '  ' + editor.value.substring(end);
                editor.selectionStart = editor.selectionEnd = start + 2;
                updateEditor();
            }
        });

        // 4. Safe Reset Button Handler
        if (resetBtn) {
            DojoEngine.setupResetButton(resetBtn, editor, DRAFT_KEY, DEFAULT_STARTER, () => {
                updateEditor();
            });
        }

        // Initial Paint
        updateEditor();
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initLesson);
    } else {
        initLesson();
    }
</script>
