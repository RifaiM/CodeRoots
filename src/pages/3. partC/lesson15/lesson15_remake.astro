function ReactTaskManager() {
  // Step 1: Declare state 'tasks' initialized with at least two items
  const tasks = [];
  const [inputVal, setInputVal] = React.useState("");

  // Step 2: Add task handler function
  const handleAddTask = (e) => {
    e.preventDefault();
  };

  return (
    <div style={{ padding: '20px', fontFamily: 'sans-serif', maxWidth: '440px', margin: '0 auto' }}>
      <h2>🏆 Task Manager Capstone</h2>
      <form onSubmit={handleAddTask}>
        <input value={inputVal} onChange={e => setInputVal(e.target.value)} placeholder="New task..." />
        <button type="submit">Add</button>
      </form>
      <ul>
        {/* Render tasks list */}
      </ul>
    </div>
  );
}

const root = ReactDOM.createRoot(document.getElementById('root'));
root.render(<ReactTaskManager />);`;

