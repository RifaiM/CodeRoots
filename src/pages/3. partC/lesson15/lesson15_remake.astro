---

<LessonLayout
    title="Project 15: React Capstone App | Level 5 React Dojo"
    description="Build a production-grade single page React application combining state, props, lifecycle effects, and API integration."
    levelTag="Level 5 • Framework Dojo"
    lessonNum={15}
    lessonTitle="React Capstone App"
    xpAmount={150}
    completionKey="partC_lesson15_remake_complete"
    nextLessonUrl="/3. partC/certificate.html"
    hubUrl="/3. partC/hub.html"
    hubTitle="Level 5 Hub"
    hubIcon="⚛️"
    fileTab="App.jsx"
    starterCode={starterCode}
    mode="html"
    jumpLessons={level5Lessons}
    certificateUrl="/3. partC/certificate.html"
    trackPrefix="partC"
>
    <!-- Intro Slot -->
    <p class="lesson-subtitle" slot="intro">
        Build a production-grade single page React application combining state, props, lifecycle effects, and API integration.
    </p>

    <!-- Concept Slot (Left Pane) -->
    <div slot="concept" style="display: flex; flex-direction: column; gap: 16px;">
        
        <!-- Core Concept & Analogy -->
        <article class="concept-card">
            <h3><span>💡</span> Core Concept &amp; Mental Model</h3>
            <div class="analogy-callout">
                <strong>Real-World Analogy:</strong> A Capstone App combines all your tools into a complete production system: state management, real-time list rendering, interactive search filtering, item deletion, and responsive UI feedback.
            </div>
        </article>

        <!-- Interactive Feature Explorer -->
        <article class="concept-card">
            <h3><span>⚛️</span> Fullstack React App Architecture</h3>
            <p style="color: #475569; font-size: 0.88rem; margin: 0 0 10px 0;">Key syntax building blocks and architecture patterns:</p>
            <div class="tag-demo">
                <div class="tag-example">
                    <div class="tag-code">{"const [tasks, setTasks] = useState([...])"}</div>
                    <div class="tag-result">{"Main collection state for data records"}</div>
                </div>
                <div class="tag-example">
                    <div class="tag-code">{"setTasks([...tasks, newTask])"}</div>
                    <div class="tag-result">{"Adds items immutably without direct mutation"}</div>
                </div>
                <div class="tag-example">
                    <div class="tag-code">{"tasks.filter(t => t.id !== id)"}</div>
                    <div class="tag-result">{"Deletes item by filtering out matched ID"}</div>
                </div>
            </div>
        </article>

        <!-- Working Reference Code & Architecture Snippet -->
        <article class="concept-card">
            <h3><span>💻</span> Reference Architecture Pattern</h3>
            <p style="color: #475569; font-size: 0.88rem; margin: 0 0 8px 0;">How this pattern is structured in production React applications:</p>
            <div class="code-snippet-box">
                <button class="snippet-copy-btn" onclick="navigator.clipboard.writeText(document.getElementById('refCodeBox_15')?.innerText || '')">📋 Copy</button>
                <pre><code id="refCodeBox_15">{"function TaskManager() {\n  const [tasks, setTasks] = React.useState([\n    { id: 1, title: \"Master React Hooks\", done: true },\n    { id: 2, title: \"Build Capstone SPA\", done: false }\n  ]);\n  const [input, setInput] = React.useState(\"\");\n\n  const handleAdd = () => {\n    if (!input.trim()) return;\n    setTasks([...tasks, { id: Date.now(), title: input, done: false }]);\n    setInput(\"\");\n  };\n\n  return (\n    <div>\n      <input value={input} onChange={e => setInput(e.target.value)} />\n      <button onClick={handleAdd}>Add Task</button>\n      <ul>{tasks.map(t => <li key={t.id}>{t.title}</li>)}</ul>\n    </div>\n  );\n}"}</code></pre>
            </div>
        </article>

        <!-- Unified Mission Card -->
        <article class="concept-card mission-card">
            <div class="mission-header">
                <h3><span>🎯</span> Your Mission</h3>
                <span class="checklist-counter" id="checklistCounter">0 / 2</span>
            </div>
            <p class="mission-subtitle">Complete all coding goals below in the editor:</p>
            <div id="taskChecklist"></div>
        </article>

    </div>
</LessonLayout>

<!-- Client-Side Scripts & Verification Engine -->
<script>
    import { DojoEngine } from '../../../scripts/dojo';

    function initLesson() {
        const editor = document.getElementById('lessonEditor') as HTMLTextAreaElement | null;
        const lineNumbers = document.getElementById('ideLineNumbers');
        const lineNumbersInner = document.getElementById('ideLineNumbersInner') || lineNumbers;
        const previewIframe = document.getElementById('livePreviewIframe') as HTMLIFrameElement | null;
        const checkBtn = document.getElementById('checkAnswerBtn');
        const resetBtn = document.getElementById('resetEditorBtn');

        if (!editor) return;

        const DRAFT_KEY = 'novicodes_draft_partC_lesson15';
        const DEFAULT_STARTER = `// 🏆 Lesson 15 Capstone: Interactive React Application!

function ReactTaskManager() {
  // 👉 STEP 1: Declare state 'tasks' initialized with at least two default items
  // Format: const [tasks, setTasks] = React.useState([{ id: 1, text: "Master React", completed: true }, { id: 2, text: "Build Capstone", completed: false }]);
  

  // Controlled input state for typing new tasks
  const [inputVal, setInputVal] = React.useState("");

  // 👉 STEP 2: Add task handler function that appends new task to 'tasks' state immutably
  const handleAddTask = () => {
    if (!inputVal.trim()) return;
    // Write code to append new task using setTasks([...tasks, ...]) and clear inputVal with setInputVal(""):

  };

  return (
    <div style={{ padding: '20px', fontFamily: 'sans-serif', maxWidth: '440px', margin: '0 auto' }}>
      <h2>🏆 React Capstone: Task Manager</h2>
      <div style={{ display: 'flex', gap: '8px', marginBottom: '14px' }}>
        <input 
          value={inputVal} 
          onChange={(e) => setInputVal(e.target.value)} 
          placeholder="New task..." 
          style={{ flex: 1, padding: '8px 12px', borderRadius: '8px', border: '1px solid #cbd5e1' }} 
        />
        <button 
          onClick={handleAddTask} 
          style={{ background: '#2563eb', color: 'white', border: 'none', padding: '8px 16px', borderRadius: '8px', cursor: 'pointer' }}
        >
          Add Task
        </button>
      </div>
      <ul style={{ listStyle: 'none', padding: 0 }}>
        {typeof tasks !== 'undefined' && tasks.map(t => (
          <li key={t.id} style={{ padding: '8px 12px', background: '#f8fafc', border: '1px solid #e2e8f0', borderRadius: '8px', marginBottom: '6px' }}>
            {t.completed ? "✅" : "⏳"} {t.text}
          </li>
        ))}
      </ul>
    </div>
  );
}

const root = ReactDOM.createRoot(document.getElementById('root'));
root.render(<ReactTaskManager />);
`;

        // 1. Initialize Real-Time Conceptual Checklist
        DojoEngine.initChecklist([
            {
                id: 'tasks_state',
                label: 'Declare <code>const [tasks, setTasks] = React.useState(...)</code>',
                fn: (code) => /const\s*\[\s*tasks\s*,\s*setTasks\s*\]\s*=\s*(?:React\.)?useState/i.test(code)
            },
            {
                id: 'add_task',
                label: 'Append new task with <code>setTasks([...tasks, ...])</code>',
                fn: (code) => /setTasks\s*\(\s*\[\s*\.\.\.tasks/i.test(code) || /setTasks\s*\(\s*\(?t\)?\s*=>\s*\[\s*\.\.\.t/i.test(code)
            }
        ], {
            containerId: 'taskChecklist',
            submitBtnId: 'checkAnswerBtn',
            nextBtnId: 'nextLessonBtn',
            mode: 'html'
        });

        // 2. Line numbers & scroll sync
        function syncScroll() {
            if (lineNumbersInner && editor) {
                lineNumbersInner.style.transform = `translateY(-${editor.scrollTop}px)`;
            }
        }

        function updateEditor() {
            if (!editor || !lineNumbersInner) return;
            const lines = editor.value.split('\n');
            const lineCount = Math.max(lines.length, 1);
            lineNumbersInner.textContent = Array.from({ length: lineCount }, (_, i) => i + 1).join('\n');
            syncScroll();

            // Render live React JSX preview inside iframe
            if (previewIframe) {
                const code = editor.value;
                const htmlDoc = `<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <script src="https://unpkg.com/react@18/umd/react.development.js"><\/script>
  <script src="https://unpkg.com/react-dom@18/umd/react-dom.development.js"><\/script>
  <script src="https://unpkg.com/@babel/standalone/babel.min.js"><\/script>
  <style>
    body { margin: 0; padding: 12px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; background: #ffffff; color: #0f172a; }
  </style>
</head>
<body>
  <div id="root"></div>
  <script type="text/babel">
    try {
      ${code}
    } catch (err) {
      document.getElementById('root').innerHTML = '<div style="color:#ef4444; background:#fef2f2; border:1px solid #fecaca; padding:12px; border-radius:8px; font-size:13px; font-family:monospace;"><b>⚠️ Render Error:</b> ' + err.message + '</div>';
    }
  <\/script>
</body>
</html>`;
                previewIframe.srcdoc = htmlDoc;
            }

            // Real-Time Checklist Verification
            // Real-Time JavaScript & React Diagnostics
            DojoEngine.lint(editor.value, 'javascript');

            // Real-Time Checklist Verification
            DojoEngine.runChecklist(editor.value);
        }

        // 3. Draft Auto-Save & Crash Resilience
        DojoEngine.setupDraftPersistence(editor, DRAFT_KEY, DEFAULT_STARTER, updateEditor);

        editor.addEventListener('scroll', syncScroll);

        editor.addEventListener('keydown', (e) => {
            if (e.key === 'Tab') {
                e.preventDefault();
                const start = editor.selectionStart;
                const end = editor.selectionEnd;
                editor.value = editor.value.substring(0, start) + '  ' + editor.value.substring(end);
                editor.selectionStart = editor.selectionEnd = start + 2;
                updateEditor();
            }
        });

        // 4. Safe Reset Button Handler
        if (resetBtn) {
            DojoEngine.setupResetButton(resetBtn, editor, DRAFT_KEY, DEFAULT_STARTER, () => {
                updateEditor();
            });
        }

        // Initial Paint
        updateEditor();
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initLesson);
    } else {
        initLesson();
    }
</script>
