---

<LessonLayout
    title="Project 02: Arrow Functions & Scope | Level 5 React Dojo"
    description="Learn concise arrow function syntax, lexical this binding, and implicit returns in modern JavaScript programming."
    levelTag="Level 5 • Framework Dojo"
    lessonNum={2}
    lessonTitle="Arrow Functions & Scope"
    xpAmount={150}
    completionKey="partC_lesson2_remake_complete"
    nextLessonUrl="/3. partC/lesson3/lesson3_remake.html"
    hubUrl="/3. partC/hub.html"
    hubTitle="Level 5 Hub"
    hubIcon="⚛️"
    fileTab="App.jsx"
    starterCode={starterCode}
    mode="html"
    jumpLessons={level5Lessons}
    certificateUrl="/3. partC/certificate.html"
    trackPrefix="partC"
>
    <!-- Intro Slot -->
    <p class="lesson-subtitle" slot="intro">
        Learn concise arrow function syntax, lexical this binding, and implicit returns in modern JavaScript programming.
    </p>

    <!-- Concept Slot (Left Pane) -->
    <div slot="concept" style="display: flex; flex-direction: column; gap: 16px;">
        
        <!-- Core Concept & Analogy -->
        <article class="concept-card">
            <h3><span>💡</span> Core Concept &amp; Mental Model</h3>
            <div class="analogy-callout">
                <strong>Real-World Analogy:</strong> React components are like LEGO bricks. Instead of building an entire castle in one giant piece, you build small, reusable bricks (&lt;Header /&gt;, &lt;Card /&gt;, &lt;Footer /&gt;) and assemble them into a complete page tree.
            </div>
        </article>

        <!-- Interactive Feature Explorer -->
        <article class="concept-card">
            <h3><span>⚛️</span> Component Tree Architecture</h3>
            <p style="color: #475569; font-size: 0.88rem; margin: 0 0 10px 0;">Key syntax building blocks and architecture patterns:</p>
            <div class="tag-demo">
                <div class="tag-example">
                    <div class="tag-code">{"<Header />"}</div>
                    <div class="tag-result">{"Top bar component rendering branding and title"}</div>
                </div>
                <div class="tag-example">
                    <div class="tag-code">{"<Card title='...' />"}</div>
                    <div class="tag-result">{"Reusable content card with dynamic props"}</div>
                </div>
                <div class="tag-example">
                    <div class="tag-code">{"<App />"}</div>
                    <div class="tag-result">{"Root parent component assembling the entire tree"}</div>
                </div>
            </div>
        </article>

        <!-- Working Reference Code & Architecture Snippet -->
        <article class="concept-card">
            <h3><span>💻</span> Reference Architecture Pattern</h3>
            <p style="color: #475569; font-size: 0.88rem; margin: 0 0 8px 0;">How this pattern is structured in production React applications:</p>
            <div class="code-snippet-box">
                <button class="snippet-copy-btn" onclick="navigator.clipboard.writeText(document.getElementById('refCodeBox_2')?.innerText || '')">📋 Copy</button>
                <pre><code id="refCodeBox_2">{"function Header() {\n  return <header><h1>🍱 Component Dojo</h1></header>;\n}\n\nfunction Card({ title, desc }) {\n  return (\n    <div className=\"card-box\">\n      <h3>{title}</h3>\n      <p>{desc}</p>\n    </div>\n  );\n}\n\nfunction App() {\n  return (\n    <main>\n      <Header />\n      <Card title=\"React JSX\" desc=\"Declarative UI syntax\" />\n    </main>\n  );\n}"}</code></pre>
            </div>
        </article>

        <!-- Task Instructions Card -->
        <article class="concept-card" style="border-left: 4px solid #2563eb;">
            <h3><span>🎯</span> Your Hands-On Coding Goal</h3>
            <ol style="color: #334155; font-size: 0.90rem; line-height: 1.7; padding-left: 20px; margin: 0;">
                <li>Define a <code>Header</code> component returning a header tag.</li>
                <li>Define a <code>Card</code> component that receives <code>&#123; title, desc &#125;</code> props.</li>
                <li>Assemble <code>&lt;Header /&gt;</code> and multiple <code>&lt;Card /&gt;</code> inside <code>App</code>.</li>
                <li>Mount to DOM with <code>ReactDOM.createRoot().render(&lt;App /&gt;)</code>.</li>
            </ol>
        </article>

    </div>
</LessonLayout>

<!-- Client-Side Scripts & Verification Engine -->
<script>
    import { DojoEngine } from '../../../scripts/dojo';

    function initLesson() {
        const editor = document.getElementById('lessonEditor') as HTMLTextAreaElement | null;
        const lineNumbers = document.getElementById('ideLineNumbers');
        const lineNumbersInner = document.getElementById('ideLineNumbersInner') || lineNumbers;
        const previewIframe = document.getElementById('livePreviewIframe') as HTMLIFrameElement | null;
        const checkBtn = document.getElementById('checkAnswerBtn');
        const resetBtn = document.getElementById('resetEditorBtn');

        if (!editor) return;

        const DRAFT_KEY = 'novicodes_draft_partC_lesson2';
        const DEFAULT_STARTER = "// 🍱 Lesson 2: Build a React Component Tree!\n\n// Step 1: Define sub-component 'Header' that returns <header><h1>🍱 Component Dojo</h1></header>\n// Write function Header() here:\n\n\n// Step 2: Define sub-component 'Card' that accepts { title, desc } and returns <div className=\"card-box\"><h3>{title}</h3><p>{desc}</p></div>\n// Write function Card({ title, desc }) here:\n\n\n// Step 3: Parent Component: App (Assembles the Component Tree)\nfunction App() {\n  return (\n    <div style={{ padding: '20px', fontFamily: 'sans-serif', maxWidth: '480px', margin: '0 auto' }}>\n      {/* Step 4: Render <Header /> and two <Card /> components here: */}\n      \n    </div>\n  );\n}\n\n// 4. Render Component Tree to DOM\nconst root = ReactDOM.createRoot(document.getElementById('root'));\nroot.render(<App />);";

        // 1. Initialize Real-Time Conceptual Checklist
        DojoEngine.initChecklist([
            {
                id: 'header',
                label: 'Define <code>function Header()</code> component',
                fn: (code) => /function\s+Header\s*\(/i.test(code)
            },
            {
                id: 'card',
                label: 'Define <code>function Card({ title, desc })</code> component',
                fn: (code) => /function\s+Card\s*\(\s*\{\s*title\s*,\s*desc/i.test(code) || /function\s+Card\s*\(\s*props/i.test(code)
            },
            {
                id: 'render_tree',
                label: 'Render <code>&lt;Header /&gt;</code> and <code>&lt;Card /&gt;</code> inside App',
                fn: (code) => /<Header\s*\/?>/i.test(code) && /<Card\s+/i.test(code)
            }
        ], {
            containerId: 'taskChecklist',
            submitBtnId: 'checkAnswerBtn',
            nextBtnId: 'nextLessonBtn',
            mode: 'html'
        });

        // 2. Line numbers & scroll sync
        function syncScroll() {
            if (lineNumbersInner && editor) {
                lineNumbersInner.style.transform = `translateY(-${editor.scrollTop}px)`;
            }
        }

        function updateEditor() {
            if (!editor || !lineNumbersInner) return;
            const lines = editor.value.split('\n');
            const lineCount = Math.max(lines.length, 1);
            lineNumbersInner.textContent = Array.from({ length: lineCount }, (_, i) => i + 1).join('\n');
            syncScroll();

            // Render live React JSX preview inside iframe
            if (previewIframe) {
                const code = editor.value;
                const htmlDoc = `<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <script src="https://unpkg.com/react@18/umd/react.development.js"><\/script>
  <script src="https://unpkg.com/react-dom@18/umd/react-dom.development.js"><\/script>
  <script src="https://unpkg.com/@babel/standalone/babel.min.js"><\/script>
  <style>
    body { margin: 0; padding: 12px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; background: #ffffff; color: #0f172a; }
  </style>
</head>
<body>
  <div id="root"></div>
  <script type="text/babel">
    try {
      ${code}
    } catch (err) {
      document.getElementById('root').innerHTML = '<div style="color:#ef4444; background:#fef2f2; border:1px solid #fecaca; padding:12px; border-radius:8px; font-size:13px; font-family:monospace;"><b>⚠️ Render Error:</b> ' + err.message + '</div>';
    }
  <\/script>
</body>
</html>`;
                previewIframe.srcdoc = htmlDoc;
            }

            // Real-Time Checklist Verification
            DojoEngine.runChecklist(editor.value);
        }

        // 3. Draft Auto-Save & Crash Resilience
        DojoEngine.setupDraftPersistence(editor, DRAFT_KEY, DEFAULT_STARTER, updateEditor);

        editor.addEventListener('scroll', syncScroll);

        editor.addEventListener('keydown', (e) => {
            if (e.key === 'Tab') {
                e.preventDefault();
                const start = editor.selectionStart;
                const end = editor.selectionEnd;
                editor.value = editor.value.substring(0, start) + '  ' + editor.value.substring(end);
                editor.selectionStart = editor.selectionEnd = start + 2;
                updateEditor();
            }
        });

        // 4. Safe Reset Button Handler
        if (resetBtn) {
            DojoEngine.setupResetButton(resetBtn, editor, DRAFT_KEY, DEFAULT_STARTER, () => {
                updateEditor();
            });
        }

        // Initial Paint
        updateEditor();
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initLesson);
    } else {
        initLesson();
    }
</script>
