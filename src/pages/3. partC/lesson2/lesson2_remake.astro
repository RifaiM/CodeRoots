// 👉 STEP 3: Parent Component: App (Assembles the Component Tree)
function App() {
  return (
    <div style={{ padding: '20px', fontFamily: 'sans-serif', maxWidth: '480px', margin: '0 auto' }}>
      {/* Render your <Header /> component and two <Card title="..." desc="..." /> components here: */}
      
    </div>
  );
}

// Render Component Tree to DOM
const root = ReactDOM.createRoot(document.getElementById('root'));
root.render(<App />);
`;
