const starterCode = `// 🍱 Lesson 2: Build a React Component Tree!

// 👉 STEP 1: Define a Header component that returns <h1>🍱 Component Dojo</h1>
// (Hint: function Header() { return <header><h1>🍱 Component Dojo</h1></header>; })


// 👉 STEP 2: Define a Card component that accepts { title, desc } and returns a card container
