import LessonLayout from '../../../layouts/LessonLayout.astro';

const starterCode = `// 🔀 Lesson 10: Conditional Rendering with Ternary & State!

function AuthDashboard() {
  const [isLoggedIn, setIsLoggedIn] = React.useState(false);

  return (
    <div style={{ padding: '20px', fontFamily: 'sans-serif', maxWidth: '420px', margin: '0 auto', textAlign: 'center' }}>
      <div style={{ background: '#f8fafc', border: '1px solid #cbd5e1', borderRadius: '16px', padding: '20px' }}>
        <h2>🔐 Member Portal</h2>
        
        {/* 👉 STEP 1: Use Ternary operator to conditionally render based on isLoggedIn */}
        {/* If isLoggedIn is true: render <div><h3>Welcome, Member! ✅</h3><button onClick={() => setIsLoggedIn(false)}>Log Out</button></div> */}
        {/* If isLoggedIn is false: render <div><h3>Please Sign In</h3><button onClick={() => setIsLoggedIn(true)}>Log In</button></div> */}
        
      </div>
    </div>
  );
}

const root = ReactDOM.createRoot(document.getElementById('root'));
root.render(<AuthDashboard />);
`;
