<LessonLayout
    title="Project 14: React API Data Fetching | Level 5 React Dojo"
    description="Fetch external REST APIs inside useEffect, manage loading states, and handle network error boundaries."
    levelTag="Level 5 • Framework Dojo"
    lessonNum={14}
    lessonTitle="React API Data Fetching"
    xpAmount={150}
    completionKey="partC_lesson14_remake_complete"
    nextLessonUrl="/3. partC/lesson15/lesson15_remake.html"
    hubUrl="/3. partC/hub.html"
    hubTitle="Level 5 Hub"
    hubIcon="⚛️"
    fileTab="App.jsx"
    starterCode={starterCode}
    mode="html"
    jumpLessons={level5Lessons}
    certificateUrl="/3. partC/certificate.html"
    trackPrefix="partC"
>
    <!-- Intro Slot -->
    <p class="lesson-subtitle" slot="intro">
        Fetch external REST APIs inside useEffect, manage loading states, and handle network error boundaries.
    </p>

    <!-- Concept Slot (Left Pane) -->
    <div slot="concept" style="display: flex; flex-direction: column; gap: 16px;">
        
        <!-- Core Concept & Analogy -->
        <article class="concept-card">
            <h3><span>💡</span> Core Concept &amp; Mental Model</h3>
            <div class="analogy-callout">
                <strong>Real-World Analogy:</strong> Debouncing in search filters is like waiting for someone to stop talking before answering. Instead of triggering an API search on every single letter typed, you wait 300ms after the user stops typing.
            </div>
        </article>

        <!-- Interactive Feature Explorer -->
        <article class="concept-card">
            <h3><span>⚛️</span> Debounced Search & Cleanup Effects</h3>
            <p style="color: #475569; font-size: 0.88rem; margin: 0 0 10px 0;">Key syntax building blocks and architecture patterns:</p>
            <div class="tag-demo">
                <div class="tag-example">
                    <div class="tag-code">{"const timer = setTimeout(fn, 300)"}</div>
                    <div class="tag-result">{"Delays execution until user pauses typing"}</div>
                </div>
                <div class="tag-example">
                    <div class="tag-code">{"return () => clearTimeout(timer)"}</div>
                    <div class="tag-result">{"Cleanup function cancels timer if query changes again"}</div>
                </div>
                <div class="tag-example">
                    <div class="tag-code">{"useEffect(() => ..., [query])"}</div>
                    <div class="tag-result">{"Effect re-runs whenever search query changes"}</div>
                </div>
            </div>
        </article>

        <!-- Working Reference Code & Architecture Snippet -->
        <article class="concept-card">
            <h3><span>💻</span> Reference Architecture Pattern</h3>
            <p style="color: #475569; font-size: 0.88rem; margin: 0 0 8px 0;">How this pattern is structured in production React applications:</p>
            <div class="code-snippet-box">
                <button class="snippet-copy-btn" onclick="navigator.clipboard.writeText(document.getElementById('refCodeBox_14')?.innerText || '')">📋 Copy</button>
                <pre><code id="refCodeBox_14">{"function SearchBox() {\n  const [query, setQuery] = React.useState(\"\");\n  const [results, setResults] = React.useState([]);\n\n  React.useEffect(() => {\n    const timer = setTimeout(() => {\n      if (query.trim()) {\n        performSearch(query).then(res => setResults(res));\n      }\n    }, 300);\n\n    return () => clearTimeout(timer);\n  }, [query]);\n\n  return <input value={query} onChange={e => setQuery(e.target.value)} />;\n}"}</code></pre>
            </div>
        </article>

        <!-- Task Instructions Card -->
        <article class="concept-card" style="border-left: 4px solid #2563eb;">
            <h3><span>🎯</span> Your Hands-On Coding Goal</h3>
            <ol style="color: #334155; font-size: 0.90rem; line-height: 1.7; padding-left: 20px; margin: 0;">
                <li>Add <code>useEffect</code> with dependency <code>[query]</code>.</li>
                <li>Set timer with <code>setTimeout</code>.</li>
                <li>Return cleanup function <code>clearTimeout(timer)</code>.</li>
            </ol>
        </article>

    </div>
</LessonLayout>

<!-- Client-Side Scripts & Verification Engine -->
<script>
    import { DojoEngine } from '../../../scripts/dojo';

    function initLesson() {
        const editor = document.getElementById('lessonEditor') as HTMLTextAreaElement | null;
        const lineNumbers = document.getElementById('ideLineNumbers');
        const lineNumbersInner = document.getElementById('ideLineNumbersInner') || lineNumbers;
        const previewIframe = document.getElementById('livePreviewIframe') as HTMLIFrameElement | null;
        const checkBtn = document.getElementById('checkAnswerBtn');
        const resetBtn = document.getElementById('resetEditorBtn');

        if (!editor) return;

        const DRAFT_KEY = 'novicodes_draft_partC_lesson14';
        const DEFAULT_STARTER = "// ⚡ Lesson 14: Search Filter with useEffect Debounce!\n\nfunction LiveUserSearch() {\n  const [query, setQuery] = React.useState(\"\");\n  const [results, setResults] = React.useState([]);\n\n  // Step 1: Use useEffect with dependency [query] to filter results\n  // Step 2: Return a cleanup function clearTimeout(timer)\n  // Write useEffect debounce here:\n\n\n  return (\n    <div style={{ padding: '20px', fontFamily: 'sans-serif', maxWidth: '440px', margin: '0 auto' }}>\n      <h2>🔍 Debounced User Search</h2>\n      <input value={query} onChange={(e) => setQuery(e.target.value)} placeholder=\"Type to search...\" />\n      <p>Search query: <strong>{query}</strong></p>\n    </div>\n  );\n}\n\nconst root = ReactDOM.createRoot(document.getElementById('root'));\nroot.render(<LiveUserSearch />);";

        // 1. Initialize Real-Time Conceptual Checklist
        DojoEngine.initChecklist([
            {
                id: 'search_effect',
                label: 'Run effect on <code>[query]</code>',
                fn: (code) => /(?:React\.)?useEffect\s*\([\s\S]*?,\s*\[\s*query\s*\]\s*\)/i.test(code)
            },
            {
                id: 'cleanup',
                label: 'Return cleanup function <code>() => clearTimeout(...)</code>',
                fn: (code) => /return\s*\(\s*\)\s*=>\s*clearTimeout/i.test(code) || /return\s+function\s*\(\s*\)\s*\{\s*clearTimeout/i.test(code)
            }
        ], {
            containerId: 'taskChecklist',
            submitBtnId: 'checkAnswerBtn',
            nextBtnId: 'nextLessonBtn',
            mode: 'html'
        });

        // 2. Line numbers & scroll sync
        function syncScroll() {
            if (lineNumbersInner && editor) {
                lineNumbersInner.style.transform = `translateY(-${editor.scrollTop}px)`;
            }
        }

        function updateEditor() {
            if (!editor || !lineNumbersInner) return;
            const lines = editor.value.split('\n');
            const lineCount = Math.max(lines.length, 1);
            lineNumbersInner.textContent = Array.from({ length: lineCount }, (_, i) => i + 1).join('\n');
            syncScroll();

            // Render live React JSX preview inside iframe
            if (previewIframe) {
                const code = editor.value;
                const htmlDoc = `<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <script src="https://unpkg.com/react@18/umd/react.development.js"><\/script>
  <script src="https://unpkg.com/react-dom@18/umd/react-dom.development.js"><\/script>
  <script src="https://unpkg.com/@babel/standalone/babel.min.js"><\/script>
  <style>
    body { margin: 0; padding: 12px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; background: #ffffff; color: #0f172a; }
  </style>
</head>
<body>
  <div id="root"></div>
  <script type="text/babel">
    try {
      ${code}
    } catch (err) {
      document.getElementById('root').innerHTML = '<div style="color:#ef4444; background:#fef2f2; border:1px solid #fecaca; padding:12px; border-radius:8px; font-size:13px; font-family:monospace;"><b>⚠️ Render Error:</b> ' + err.message + '</div>';
    }
  <\/script>
</body>
</html>`;
                previewIframe.srcdoc = htmlDoc;
            }

            // Real-Time Checklist Verification
            DojoEngine.runChecklist(editor.value);
        }

        // 3. Draft Auto-Save & Crash Resilience
        DojoEngine.setupDraftPersistence(editor, DRAFT_KEY, DEFAULT_STARTER, updateEditor);

        editor.addEventListener('scroll', syncScroll);

        editor.addEventListener('keydown', (e) => {
            if (e.key === 'Tab') {
                e.preventDefault();
                const start = editor.selectionStart;
                const end = editor.selectionEnd;
                editor.value = editor.value.substring(0, start) + '  ' + editor.value.substring(end);
                editor.selectionStart = editor.selectionEnd = start + 2;
                updateEditor();
            }
        });

        // 4. Safe Reset Button Handler
        if (resetBtn) {
            DojoEngine.setupResetButton(resetBtn, editor, DRAFT_KEY, DEFAULT_STARTER, () => {
                updateEditor();
            });
        }

        // Initial Paint
        updateEditor();
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initLesson);
    } else {
        initLesson();
    }
</script>
