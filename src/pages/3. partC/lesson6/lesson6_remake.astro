<LessonLayout
 title="Project 06: ES Modules & Imports | Level 5 React Dojo"
 description="Build controlled form inputs where React state mirrors the user's typed text in real time via value and onChange handlers."
 levelTag="Level 5 • Framework Dojo"
 lessonNum={6}
 lessonTitle="Real-Time Input Binding"
 xpAmount={150}
 completionKey="partC_lesson6_remake_complete"
 nextLessonUrl="/3. partC/lesson7/lesson7_remake.html"
 hubUrl="/3. partC/hub.html"
 hubTitle="Level 5 Hub"
 hubIcon="️"
 fileTab="App.jsx"
 starterCode={starterCode}
 mode="html"
 jumpLessons={level5Lessons}
 certificateUrl="/3. partC/certificate.html"
 trackPrefix="partC"
>
 <!-- Intro Slot -->
 <p class="lesson-subtitle" slot="intro">
 Organize reusable codebases using JavaScript ES module export and import statements.
 </p>

 <!-- Concept Slot (Left Pane) -->
 <div slot="concept" style="display: flex; flex-direction: column; gap: 16px;">
 
 <!-- PROGATE-STYLE TOP MISSION CARD: Immediately informs learner what to do -->
 <!-- Unified Mission Card -->
 <article class="concept-card mission-card">
 <div class="mission-header">
 <h3><span></span> Your Mission</h3>
 <span class="checklist-counter" id="checklistCounter">0 / 2</span>
 </div>
 <div class="target-output-preview" style="background: #f1f5f9; border-radius: 8px; padding: 10px 12px; margin: 8px 0 12px 0; border: 1px dashed #94a3b8; font-size: 0.82rem;">
 <strong style="color: #334155;">️ Target Goal:</strong>
 <div style="color: #475569; margin-top: 3px;">A live badge preview where whatever text you type in the input box instantly appears formatted in the badge above!</div>
 </div>
 <p class="mission-subtitle">Follow the step-by-step instructions below in the editor:</p>
 <div id="taskChecklist"></div>
 </article>
 
 <!-- Core Concept & Analogy -->
 <article class="concept-card">
 <h3><span></span> Core Concept &amp; Mental Model</h3>
 <div class="analogy-callout">
 <strong>Real-World Analogy:</strong> Controlled input binding is like looking into a bathroom mirror 🪞. The moment you smile or wave (type a letter), the reflection updates simultaneously.
 </div>
 </article>

 <!-- Interactive Feature Explorer -->
 <article class="concept-card">
 <h3><span>️</span> Two-Way Form Binding</h3>
 <p style="color: #475569; font-size: 0.88rem; margin: 0 0 10px 0;">Key syntax building blocks and architecture patterns:</p>
 <div class="tag-demo">
 <div class="tag-example">
 <div class="tag-code">{"value={name}"}</div>
 <div class="tag-result">{"Input always displays current React state value"}</div>
 </div>
 <div class="tag-example">
 <div class="tag-code">{"onChange={e => setName(e.target.value)}"}</div>
 <div class="tag-result">{"Updates state on every keystroke in real-time"}</div>
 </div>
 <div class="tag-example">
 <div class="tag-code">{"e.preventDefault()"}</div>
 <div class="tag-result">{"Prevents page reload on form submit action"}</div>
 </div>
 </div>
 </article>

 <!-- Working Reference Code & Architecture Snippet -->
 <article class="concept-card">
 <h3><span></span> Reference Architecture Pattern</h3>
 <p style="color: #475569; font-size: 0.88rem; margin: 0 0 8px 0;">How this pattern is structured in production React applications:</p>
 <div class="code-snippet-box">
 <button class="snippet-copy-btn" onclick="navigator.clipboard.writeText(document.getElementById('refCodeBox_6')?.innerText || '')"> Copy</button>
 <pre><code id="refCodeBox_6">{"function UserForm() {\n const [name, setName] = React.useState(\"\");\n\n return (\n <form onSubmit={(e) => e.preventDefault()}>\n <label>Enter Name:</label>\n <input \n type=\"text\" \n value={name} \n onChange={(e) => setName(e.target.value)} \n placeholder=\"Type your name...\"\n />\n <p>Preview: <strong>{name || \"Anonymous\"}</strong></p>\n </form>\n );\n}"}</code></pre>
 </div>
 </article>

 

 </div>
</LessonLayout>

<!-- Client-Side Scripts & Verification Engine -->
<script>
 import { DojoEngine } from '../../../scripts/dojo';

 function initLesson() {
 const editor = document.getElementById('lessonEditor') as HTMLTextAreaElement | null;
 const lineNumbers = document.getElementById('ideLineNumbers');
 const lineNumbersInner = document.getElementById('ideLineNumbersInner') || lineNumbers;
 const previewIframe = document.getElementById('livePreviewIframe') as HTMLIFrameElement | null;
 const checkBtn = document.getElementById('checkAnswerBtn');
 const resetBtn = document.getElementById('resetEditorBtn');

 if (!editor) return;

 const DRAFT_KEY = 'novicodes_draft_partC_lesson6';
 const DEFAULT_STARTER = "// Lesson 6: React Controlled Form Inputs & Two-Way Data Binding!\n\nfunction ProfileBadgeGenerator() {\n const [developerName, setDeveloperName] = React.useState(\"\");\n const [specialty, setSpecialty] = React.useState(\"Frontend Architect\");\n\n return (\n <div style={{ padding: '16px', fontFamily: 'sans-serif', maxWidth: '440px', margin: '0 auto' }}>\n <div style={{ background: '#ffffff', border: '1px solid #cbd5e1', borderRadius: '16px', padding: '20px' }}>\n <h2 style={{ margin: '0 0 12px 0', color: '#0f172a' }}> Live Badge Generator</h2>\n \n {/* Step 1: Bind input to developerName state with value and onChange */}\n <div style={{ marginBottom: '14px' }}>\n <label style={{ display: 'block', fontSize: '13px', fontWeight: '700', marginBottom: '4px' }}>Developer Name:</label>\n <input \n type=\"text\" \n placeholder=\"Type your name...\"\n style={{ width: '100%', padding: '8px 12px', border: '1px solid #cbd5e1', borderRadius: '8px', boxSizing: 'border-box' }}\n />\n </div>\n\n {/* Live Badge Preview */}\n <div style={{ background: '#f0fdf4', border: '1px solid #86efac', padding: '14px', borderRadius: '12px', textAlign: 'center' }}>\n <h3 style={{ margin: '0 0 4px 0', color: '#166534' }}>️ {developerName || \"Your Name Here\"}</h3>\n <p style={{ margin: 0, fontSize: '12px', color: '#15803d', fontWeight: '600' }}> {specialty}</p>\n </div>\n </div>\n </div>\n );\n}\n\nconst root = ReactDOM.createRoot(document.getElementById('root'));\nroot.render(<ProfileBadgeGenerator />);";

 // 1. Initialize Real-Time Conceptual Checklist
 DojoEngine.initChecklist([
 { id: 'input_bind', label: 'Bind input with <code>value={developerName}</code>', fn: (code) => { const c = code.replace(/\/\*[\s\S]*?\*\//g, '').replace(/(?<!:)\/\/[^\r\n]*/g, ''); return /value\s*=\s*\{\s*developerName\s*\}/i.test(c); } },
 { id: 'target_value', label: 'Update state with <code>onChange={(e) => setDeveloperName(e.target.value)}</code>', fn: (code) => { const c = code.replace(/\/\*[\s\S]*?\*\//g, '').replace(/(?<!:)\/\/[^\r\n]*/g, ''); return /setDeveloperName\s*\(\s*e\.target\.value\s*\)/i.test(c); } }
 ], {
 containerId: 'taskChecklist',
 mode: 'javascript'
 });

 // 2. Line numbers & scroll sync
 function syncScroll() {
 if (lineNumbersInner && editor) {
 lineNumbersInner.style.transform = `translateY(-${editor.scrollTop}px)`;
 }
 }

 function updateEditor() {
 if (!editor || !lineNumbersInner) return;
 const lines = editor.value.split('\n');
 const lineCount = Math.max(lines.length, 1);
 lineNumbersInner.textContent = Array.from({ length: lineCount }, (_, i) => i + 1).join('\n');
 syncScroll();

 // Render live React JSX preview inside iframe
 if (previewIframe) {
 const code = editor.value;
 const htmlDoc = `<!DOCTYPE html>
<html>
<head>
 <meta charset="utf-8">
 <meta name="viewport" content="width=device-width, initial-scale=1.0">
 <script src="https://unpkg.com/react@18/umd/react.development.js"><\/script>
 <script src="https://unpkg.com/react-dom@18/umd/react-dom.development.js"><\/script>
 <script src="https://unpkg.com/@babel/standalone/babel.min.js"><\/script>
 <style>
 body { margin: 0; padding: 12px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; background: #ffffff; color: #0f172a; }
 </style>
</head>
<body>
 <div id="root"></div>
 <script type="text/babel">
 try {
 ${code}
 } catch (err) {
 document.getElementById('root').innerHTML = '<div style="color:#ef4444; background:#fef2f2; border:1px solid #fecaca; padding:12px; border-radius:8px; font-size:13px; font-family:monospace;"><b>️ Render Error:</b> ' + err.message + '</div>';
 }
 <\/script>
</body>
</html>`;
 previewIframe.srcdoc = htmlDoc;
 }

 // Real-Time Checklist Verification
 // Real-Time JavaScript & React Diagnostics
 DojoEngine.lint(editor.value, 'javascript');

 // Real-Time Checklist Verification
 DojoEngine.runChecklist(editor.value);
 }

 // 3. Draft Auto-Save & Crash Resilience
 DojoEngine.setupDraftPersistence(editor, DRAFT_KEY, DEFAULT_STARTER, updateEditor);

 editor.addEventListener('scroll', syncScroll);

 editor.addEventListener('keydown', (e) => {
 if (e.key === 'Tab') {
 e.preventDefault();
 const start = editor.selectionStart;
 const end = editor.selectionEnd;
 editor.value = editor.value.substring(0, start) + ' ' + editor.value.substring(end);
 editor.selectionStart = editor.selectionEnd = start + 2;
 updateEditor();
 }
 });

 // 4. Safe Reset Button Handler
 if (resetBtn) {
 DojoEngine.setupResetButton(resetBtn, editor, DRAFT_KEY, DEFAULT_STARTER, () => {
 updateEditor();
 });
 }

 // 5. Check & Verify Code Action with Progate Diagnostics
 if (checkBtn) {
 checkBtn.addEventListener('click', () => {
 DojoEngine.verifySubmission(editor.value, {
 lessonTitle: 'Real-Time Input Binding',
 xp: 150,
 completionKey: 'partC_lesson6_remake_complete',
 nextUrl: '/3. partC/lesson7/lesson7_remake.html',
 mode: 'javascript'
 });
 });
 }

 // Initial Paint
 updateEditor();
 }

 if (document.readyState === 'loading') {
 document.addEventListener('DOMContentLoaded', initLesson);
 } else {
 initLesson();
 }
</script>
