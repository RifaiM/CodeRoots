---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PlatformHeader from '../../components/PlatformHeader.astro';
import PlatformFooter from '../../components/PlatformFooter.astro';

const navLinks = [
    { href: '/', label: 'Dashboard', icon: '🏠', title: 'Dashboard Home' },
    { href: '/3. partC/hub.html', label: 'Level 5 Hub', icon: '⚛️', title: 'React Dojo Hub' }
];
---

<BaseLayout 
    title="Level 5 Certificate: React & Framework Dojo | NoviCodes" 
    description="Claim your Level 5 Certificate in Modern ES6+ JavaScript, React Components, State Management, and Hooks."
    showHeaderFooter={false}
>
    <PlatformHeader 
        slot="header"
        tagText="Level 5 • React Dojo"
        tagId="headerLogoTag"
        navLinks={navLinks}
        showXpBadge={true}
        showLevelBadge={true}
    />

    <main class="cert-page-container">
        <div class="cert-container">
            
            <!-- Certificate Generator Controls -->
            <section class="generator-card">
                <div class="generator-header">
                    <h2>🎓 Level 5 Certificate Generator</h2>
                    <p>Enter your full name to generate your verified proof-of-work certificate in React &amp; Modern Frontend Engineering.</p>
                </div>

                <div class="generator-inputs">
                    <div class="input-group">
                        <label for="learnerNameInput">Full Legal Name / Developer Alias:</label>
                        <input type="text" id="learnerNameInput" placeholder="e.g. Alex Rivera" value="React Developer" />
                    </div>
                    <div class="btn-row">
                        <button class="cert-action-btn primary" id="generateCertBtn">
                            <span>✨ Update Certificate</span>
                        </button>
                        <button class="cert-action-btn success" id="downloadCertBtn">
                            <span>📥 Download High-Res PNG</span>
                        </button>
                        <button class="cert-action-btn secondary" id="printCertBtn" onclick="window.print()">
                            <span>🖨️ Print / PDF</span>
                        </button>
                    </div>
                </div>
            </section>

            <!-- Visual Certificate Preview -->
            <div class="certificate-frame" id="certificateFrame">
                <div class="certificate-inner">
                    <div class="cert-watermark">NOVICODES</div>
                    
                    <div class="cert-top-row">
                        <img src="/assets/logo.jpg" alt="NoviCodes Logo" class="cert-logo-img" />
                        <div class="cert-brand">NOVICODES PLATFORM</div>
                        <div class="cert-id-badge">ID: <span id="certIdDisplay">NC-REACT-2026-0042</span></div>
                    </div>

                    <div class="cert-center-content">
                        <div class="cert-icon-seal">⚛️</div>
                        <h1 class="cert-title">CERTIFICATE OF MASTERY</h1>
                        <p class="cert-subtitle">LEVEL 5: REACT &amp; MODERN FRONTEND ENGINEERING</p>

                        <p class="cert-award-text">This official certificate is proudly awarded to:</p>
                        <h2 class="cert-student-name" id="certNameDisplay">React Developer</h2>

                        <p class="cert-description">
                            For demonstrating verified excellence in <strong>React Components, JSX Architecture, Custom Hooks, State Management, Controlled Inputs, Context API, and Production Single-Page Applications</strong> across 15 interactive practical projects.
                        </p>
                    </div>

                    <div class="cert-bottom-row">
                        <div class="cert-col">
                            <div class="cert-col-title">ISSUE DATE</div>
                            <div class="cert-col-val" id="certDateDisplay">August 15, 2026</div>
                        </div>

                        <div class="cert-seal-badge">
                            <div class="seal-circle">
                                <span>VERIFIED</span>
                                <strong>★ NOVICODES ★</strong>
                                <span>MASTERY</span>
                            </div>
                        </div>

                        <div class="cert-col right">
                            <div class="cert-col-title">VERIFICATION SIGNATURE</div>
                            <div class="cert-sig-box">
                                <span class="sig-script">NoviCodes Academic Board</span>
                                <div class="sig-line"></div>
                                <span class="sig-sub">Chief Curriculum Architect</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <canvas id="certCanvas" style="display: none;"></canvas>
        </div>
    </main>

    <PlatformFooter slot="footer" />
</BaseLayout>

<style is:global>
    .cert-page-container {
        padding: 32px 20px 60px 20px;
        background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
        min-height: calc(100vh - 140px);
        display: flex;
        justify-content: center;
    }

    .cert-container {
        max-width: 900px;
        width: 100%;
        display: flex;
        flex-direction: column;
        gap: 28px;
    }

    .generator-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 20px;
        padding: 28px 32px;
        box-shadow: 0 4px 16px rgba(15, 23, 42, 0.04);
    }

    .generator-header h2 {
        font-size: 1.35rem;
        font-weight: 800;
        color: #0f172a;
        margin: 0 0 6px 0;
    }

    .generator-header p {
        font-size: 0.90rem;
        color: #64748b;
        margin: 0 0 20px 0;
        line-height: 1.5;
    }

    .input-group label {
        display: block;
        font-size: 0.82rem;
        font-weight: 700;
        color: #475569;
        margin-bottom: 8px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .input-group input {
        width: 100%;
        padding: 12px 16px;
        border: 1px solid #cbd5e1;
        border-radius: 12px;
        font-size: 0.95rem;
        font-family: inherit;
        color: #0f172a;
        box-sizing: border-box;
        outline: none;
        transition: border-color 0.2s;
    }

    .input-group input:focus {
        border-color: #0284c7;
        box-shadow: 0 0 0 3px rgba(2, 132, 199, 0.12);
    }

    .btn-row {
        display: flex;
        gap: 12px;
        margin-top: 18px;
        flex-wrap: wrap;
    }

    .cert-action-btn {
        padding: 11px 22px;
        border-radius: 12px;
        font-size: 0.88rem;
        font-weight: 800;
        cursor: pointer;
        transition: all 0.2s;
        border: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .cert-action-btn.primary {
        background: #0284c7;
        color: #ffffff;
    }

    .cert-action-btn.primary:hover {
        background: #0369a1;
        transform: translateY(-2px);
    }

    .cert-action-btn.success {
        background: #059669;
        color: #ffffff;
    }

    .cert-action-btn.success:hover {
        background: #047857;
        transform: translateY(-2px);
    }

    .cert-action-btn.secondary {
        background: #f1f5f9;
        color: #334155;
        border: 1px solid #cbd5e1;
    }

    .cert-action-btn.secondary:hover {
        background: #e2e8f0;
    }

    /* Certificate Layout */
    .certificate-frame {
        background: #ffffff;
        border: 10px solid #0f172a;
        border-radius: 24px;
        padding: 12px;
        box-shadow: 0 12px 36px rgba(15, 23, 42, 0.1);
        position: relative;
    }

    .certificate-inner {
        border: 2px solid #38bdf8;
        border-radius: 14px;
        padding: 36px 40px;
        position: relative;
        background: linear-gradient(135deg, #ffffff 0%, #f0f9ff 100%);
        overflow: hidden;
    }

    .cert-watermark {
        position: absolute;
        font-size: 6.5rem;
        font-weight: 900;
        color: rgba(2, 132, 199, 0.03);
        transform: rotate(-25deg);
        top: 30%;
        left: 15%;
        pointer-events: none;
        letter-spacing: 12px;
    }

    .cert-top-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid #e2e8f0;
        padding-bottom: 16px;
        margin-bottom: 24px;
    }

    .cert-logo-img {
        width: 38px;
        height: 38px;
        border-radius: 10px;
    }

    .cert-brand {
        font-family: 'Fira Code', monospace;
        font-size: 0.82rem;
        font-weight: 800;
        letter-spacing: 2px;
        color: #64748b;
    }

    .cert-id-badge {
        font-family: 'Fira Code', monospace;
        font-size: 0.74rem;
        background: #f1f5f9;
        padding: 4px 10px;
        border-radius: 8px;
        color: #475569;
        font-weight: 700;
    }

    .cert-center-content {
        text-align: center;
        margin: 20px 0 32px 0;
    }

    .cert-icon-seal {
        font-size: 3rem;
        margin-bottom: 8px;
    }

    .cert-title {
        font-size: 1.8rem;
        font-weight: 900;
        letter-spacing: 3px;
        color: #0f172a;
        margin: 0 0 4px 0;
    }

    .cert-subtitle {
        font-size: 0.85rem;
        font-weight: 800;
        letter-spacing: 2px;
        color: #0284c7;
        margin: 0 0 20px 0;
    }

    .cert-award-text {
        font-size: 0.88rem;
        color: #64748b;
        margin: 0 0 10px 0;
    }

    .cert-student-name {
        font-size: 2.2rem;
        font-weight: 900;
        color: #0f172a;
        margin: 0 0 16px 0;
        text-decoration: underline #38bdf8 3px;
        text-underline-offset: 8px;
    }

    .cert-description {
        font-size: 0.88rem;
        color: #475569;
        max-width: 620px;
        margin: 0 auto;
        line-height: 1.6;
    }

    .cert-bottom-row {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        border-top: 1px solid #e2e8f0;
        padding-top: 20px;
        margin-top: 24px;
    }

    .cert-col-title {
        font-size: 0.68rem;
        font-weight: 800;
        color: #94a3b8;
        letter-spacing: 1px;
        margin-bottom: 4px;
    }

    .cert-col-val {
        font-size: 0.84rem;
        font-weight: 700;
        color: #0f172a;
    }

    .seal-circle {
        width: 76px;
        height: 76px;
        border-radius: 50%;
        border: 2px dashed #0284c7;
        background: #f0f9ff;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        font-size: 0.52rem;
        font-weight: 800;
        color: #0284c7;
        text-align: center;
        line-height: 1.2;
    }

    .cert-sig-box {
        text-align: right;
    }

    .sig-script {
        font-family: 'Playfair Display', Georgia, serif;
        font-style: italic;
        font-size: 1.05rem;
        color: #0f172a;
        font-weight: 700;
    }

    .sig-line {
        width: 140px;
        height: 1px;
        background: #cbd5e1;
        margin: 4px 0 4px auto;
    }

    .sig-sub {
        font-size: 0.68rem;
        color: #64748b;
    }

    @media (max-width: 768px) {
        .certificate-inner {
            padding: 24px 18px;
        }
        .cert-student-name {
            font-size: 1.5rem;
        }
        .cert-title {
            font-size: 1.3rem;
        }
        .cert-bottom-row {
            flex-direction: column;
            gap: 16px;
            align-items: center;
            text-align: center;
        }
        .cert-sig-box {
            text-align: center;
        }
        .sig-line {
            margin: 4px auto;
        }
    }

    /* ── Pixel-Perfect Print Stylesheet (Hides Navbar, Footer & Form Controls) ─── */
    @media print {
        @page {
            size: landscape;
            margin: 0;
        }
        html, body {
            background: #ffffff !important;
            margin: 0 !important;
            padding: 0 !important;
            -webkit-print-color-adjust: exact !important;
            print-color-adjust: exact !important;
        }
        header, footer, nav, .platform-header, .platform-footer, .generator-card, .btn-row, #printCertBtn {
            display: none !important;
        }
        .cert-page-container {
            padding: 0 !important;
            margin: 0 !important;
            max-width: 100% !important;
            min-height: auto !important;
            background: transparent !important;
            display: block !important;
        }
        .cert-container {
            max-width: 100% !important;
            gap: 0 !important;
            padding: 0 !important;
            margin: 0 !important;
        }
        .certificate-frame {
            box-shadow: none !important;
            border: 12px solid #0f172a !important;
            page-break-inside: avoid !important;
            break-inside: avoid !important;
            width: 96% !important;
            max-width: 1000px !important;
            margin: 20px auto !important;
        }
    }
</style>

<script is:inline src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    import { isCertificateAccessible, getCompletedLessonsCount } from '../../scripts/dojo/core/protection';

    document.addEventListener('DOMContentLoaded', () => {
        // 1. Enforce Certificate Access Protection
        if (!isCertificateAccessible('partC')) {
            const count = getCompletedLessonsCount('partC');
            const remaining = 15 - count;

            if (typeof (window as any).Swal !== 'undefined') {
                (window as any).Swal.fire({
                    icon: 'warning',
                    title: 'Level 5 Certificate Locked! 📜',
                    html: `
                        <div style="text-align: center; font-family: 'Plus Jakarta Sans', sans-serif;">
                            <p style="font-size: 1.02rem; color: #475569; margin-bottom: 16px;">
                                You must complete all <strong>15 interactive React projects</strong> in Level 5 before claiming your official Certificate of Mastery!
                            </p>
                            <div style="background: #f8fafc; border: 1px solid #e2e8f0; padding: 14px; border-radius: 12px; display: flex; justify-content: space-around; margin-bottom: 12px;">
                                <div>
                                    <div style="font-size: 1.4rem; font-weight: 800; color: #10b981;">${count} / 15</div>
                                    <div style="font-size: 0.8rem; color: #64748b;">Projects Solved</div>
                                </div>
                                <div>
                                    <div style="font-size: 1.4rem; font-weight: 800; color: #ef4444;">${remaining}</div>
                                    <div style="font-size: 0.8rem; color: #64748b;">Remaining</div>
                                </div>
                            </div>
                        </div>
                    `,
                    confirmButtonColor: '#0284c7',
                    confirmButtonText: '🚀 Go to React Dojo Hub',
                    allowOutsideClick: false,
                    allowEscapeKey: false,
                    customClass: { popup: 'responsive-profile-modal' }
                }).then(() => {
                    window.location.href = '/3. partC/hub.html';
                });
            } else {
                window.location.href = '/3. partC/hub.html';
            }
            return;
        }

        const input = document.getElementById('learnerNameInput') as HTMLInputElement | null;
        const nameDisplay = document.getElementById('certNameDisplay');
        const updateBtn = document.getElementById('generateCertBtn');
        const downloadBtn = document.getElementById('downloadCertBtn');
        const dateDisplay = document.getElementById('certDateDisplay');
        const idDisplay = document.getElementById('certIdDisplay');

        // Set dynamic date
        const now = new Date();
        const options = { year: 'numeric', month: 'long', day: 'numeric' };
        if (dateDisplay) dateDisplay.textContent = now.toLocaleDateString('en-US', options);

        // Generate verified hash
        const hash = 'NC-REACT-' + now.getFullYear() + '-' + Math.floor(1000 + Math.random() * 9000);
        if (idDisplay) idDisplay.textContent = hash;

        // Restore saved name
        const savedName = localStorage.getItem('partC_cert_student_name') || 'React Developer';
        if (input) input.value = savedName;
        if (nameDisplay) nameDisplay.textContent = savedName;

        if (updateBtn && input && nameDisplay) {
            updateBtn.addEventListener('click', () => {
                const val = input.value.trim() || 'React Developer';
                nameDisplay.textContent = val;
                localStorage.setItem('partC_cert_student_name', val);
            });
        }

        // Canvas download engine
        if (downloadBtn) {
            downloadBtn.addEventListener('click', () => {
                const canvas = document.getElementById('certCanvas');
                if (!canvas) return;
                const ctx = canvas.getContext('2d');
                canvas.width = 1200;
                canvas.height = 800;

                // Background
                ctx.fillStyle = '#ffffff';
                ctx.fillRect(0, 0, 1200, 800);

                // Border
                ctx.lineWidth = 14;
                ctx.strokeStyle = '#0f172a';
                ctx.strokeRect(20, 20, 1160, 760);

                ctx.lineWidth = 3;
                ctx.strokeStyle = '#0284c7';
                ctx.strokeRect(34, 34, 1132, 732);

                // Title
                ctx.textAlign = 'center';
                ctx.fillStyle = '#0f172a';
                ctx.font = '900 36px sans-serif';
                ctx.fillText('CERTIFICATE OF MASTERY', 600, 160);

                ctx.fillStyle = '#0284c7';
                ctx.font = '700 18px sans-serif';
                ctx.fillText('LEVEL 5: REACT & MODERN FRONTEND ENGINEERING', 600, 200);

                ctx.fillStyle = '#64748b';
                ctx.font = '500 16px sans-serif';
                ctx.fillText('This official certificate is proudly awarded to:', 600, 280);

                // Student Name
                const name = nameDisplay ? nameDisplay.textContent : 'React Developer';
                ctx.fillStyle = '#0f172a';
                ctx.font = '900 44px sans-serif';
                ctx.fillText(name, 600, 360);

                // Description
                ctx.fillStyle = '#475569';
                ctx.font = '500 16px sans-serif';
                ctx.fillText('For demonstrating verified excellence in React Components, JSX Architecture, Custom Hooks,', 600, 430);
                ctx.fillText('State Management, Controlled Inputs, Context API, and Production Single-Page Applications.', 600, 460);

                // Footer
                ctx.textAlign = 'left';
                ctx.font = '700 14px monospace';
                ctx.fillStyle = '#64748b';
                ctx.fillText('ISSUE DATE: ' + (dateDisplay ? dateDisplay.textContent : ''), 80, 680);
                ctx.fillText('VERIFICATION ID: ' + (idDisplay ? idDisplay.textContent : ''), 80, 710);

                ctx.textAlign = 'right';
                ctx.fillText('NOVICODES ACADEMIC BOARD', 1120, 680);
                ctx.font = '500 13px sans-serif';
                ctx.fillText('Chief Curriculum Architect', 1120, 710);

                // Download image
                const link = document.createElement('a');
                link.download = `NoviCodes-Level5-React-Certificate-${name.replace(/\\s+/g, '_')}.png`;
                link.href = canvas.toDataURL('image/png');
                link.click();
            });
        }
    });
</script>
