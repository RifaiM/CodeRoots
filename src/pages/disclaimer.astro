---
import BaseLayout from '../layouts/BaseLayout.astro';
import PlatformHeader from '../components/PlatformHeader.astro';
import PlatformFooter from '../components/PlatformFooter.astro';

const navLinks = [
    { href: '/', label: 'Dashboard', icon: '🏠', title: 'Dashboard Home' },
    { href: '/foundations.html', label: 'Foundations', icon: '🧱', title: 'Web Foundations' },
    { href: '/privacy.html', label: 'Privacy Policy', icon: '🔒', title: 'Privacy Policy' },
    { href: '/terms.html', label: 'Terms of Use', icon: '📜', title: 'Terms of Use' }
];
---

<BaseLayout 
    title="Disclaimer | NoviCodes" 
    description="Review the legal, educational, trademark, and advertising disclosures for the NoviCodes interactive coding platform."
    showHeaderFooter={false}
>
    <PlatformHeader 
        slot="header"
        tagText="Platform Governance • Disclaimer"
        tagId="headerLogoTag"
        navLinks={navLinks}
        showXpBadge={false}
        showLevelBadge={false}
    />

    <!-- Main Content -->
    <main class="legal-container">
        <!-- Hero -->
        <div class="legal-hero">
            <h1>⚠️ Platform Disclaimer</h1>
            <p>Educational Intent • Trademark Notices • Advertising &amp; Liability Disclosures</p>
        </div>

        <!-- Highlight Callout -->
        <div class="highlight-card">
            <h3>💡 Independent Educational Platform</h3>
            <p>NoviCodes (CodeRoots) is an independent, 100% free, open-source educational project developed to help students and developers learn fullstack web development. All tutorials, code playgrounds, sandboxes, and interactive exercises are provided strictly for educational and self-learning purposes.</p>
        </div>

        <!-- Section 1: Educational Purpose -->
        <div class="legal-card">
            <h2><span>🎓</span> 1. Educational Purpose &amp; No Warranty</h2>
            <p>All information, interactive exercises, code snippets, simulated terminals, and documentation on NoviCodes are provided on an <strong>"as-is" and "as-available"</strong> basis without warranty of any kind, whether express or implied.</p>
            <p>While we make every effort to ensure our curriculum follows modern web standards and security best practices, NoviCodes does not guarantee that code examples are suitable for live, mission-critical, or high-security commercial production environments without independent code review and auditing.</p>
        </div>

        <!-- Section 2: Third-Party Trademarks -->
        <div class="legal-card">
            <h2><span>🏷️</span> 2. Third-Party Trademarks &amp; Fair Use</h2>
            <p>All product names, logos, brands, trademarks, and registered trademarks mentioned on this website belong to their respective owners. Their mention is strictly for identification, reference, and educational guidance under Fair Use principles.</p>
            <ul>
                <li><strong>JavaScript, HTML5, CSS3:</strong> Trademarks and specifications defined by W3C and ECMA International.</li>
                <li><strong>React:</strong> Registered trademark of Meta Platforms, Inc.</li>
                <li><strong>Python:</strong> Registered trademark of the Python Software Foundation (PSF).</li>
                <li><strong>Next.js:</strong> Registered trademark of Vercel Inc.</li>
                <li><strong>TypeScript:</strong> Registered trademark of Microsoft Corporation.</li>
                <li><strong>Docker, PostgreSQL, AWS, Stripe:</strong> Trademarks of their respective corporations.</li>
            </ul>
            <p>NoviCodes is an independent educational platform and is not affiliated with, endorsed by, or sponsored by any of the trademark holders listed above.</p>
        </div>

        <!-- Section 3: Advertising & Sponsorship -->
        <div class="legal-card">
            <h2><span>📢</span> 3. Advertising &amp; Creator Support Disclosure</h2>
            <p>To keep NoviCodes 100% free, open, and accessible to learners worldwide without paywalls or mandatory subscriptions, our website may display non-intrusive third-party advertisements (such as Google AdSense) and voluntary creator support links (Ko-fi and Trakteer).</p>
            <p>Third-party advertising vendors, including Google, use cookies to serve ads based on a user's prior visits to this website or other websites on the internet. We ensure that ads do not obstruct educational sandboxes, editor views, or the interactive learning experience.</p>
        </div>

        <!-- Section 4: External Links -->
        <div class="legal-card">
            <h2><span>🌐</span> 4. External Links Disclaimer</h2>
            <p>NoviCodes may contain links to external third-party websites, documentation hubs (such as MDN Web Docs, GitHub, Vite, or Wes Bos tutorials), and tools that are not provided or maintained by NoviCodes.</p>
            <p>We do not guarantee the accuracy, relevance, timeliness, or completeness of any information on external websites, and clicking external links is done at the learner's own discretion.</p>
        </div>

        <!-- Section 5: Limitation of Liability -->
        <div class="legal-card">
            <h2><span>⚖️</span> 5. Limitation of Liability</h2>
            <p>In no event shall NoviCodes, its creators, contributors, or maintainers (Ra Labs) be liable for any direct, indirect, incidental, consequential, or special damages arising out of or in connection with the use of this website, code sandboxes, or the information contained herein.</p>
        </div>

        <!-- Section 6: Contact & Inquiries -->
        <div class="legal-card">
            <h2><span>✉️</span> 6. Contact &amp; Inquiries</h2>
            <p>If you have any questions, feedback, or legal inquiries regarding this Disclaimer, please reach out through our official channels:</p>
            <ul>
                <li><strong>Organization:</strong> Ra Labs</li>
                <li><strong>Developer Portfolio:</strong> <a href="https://rifaim.github.io/Portfolio" target="_blank" rel="noopener noreferrer">rifaim.github.io/Portfolio ↗</a></li>
                <li><strong>Open Source Repository:</strong> <a href="https://github.com/RifaiM/CodeRoots" target="_blank" rel="noopener noreferrer">GitHub / CodeRoots ↗</a></li>
            </ul>
        </div>
    </main>

    <PlatformFooter slot="footer" />
</BaseLayout>

<style>
    .legal-container {
        max-width: 800px;
        margin: 32px auto 60px auto;
        padding: 0 20px;
        box-sizing: border-box;
    }

    .legal-hero {
        background: linear-gradient(135deg, #1e3a8a 0%, #2563eb 100%);
        color: #ffffff;
        padding: 36px 28px;
        border-radius: 20px;
        margin-bottom: 28px;
        box-shadow: 0 10px 25px rgba(37, 99, 235, 0.2);
        text-align: center;
    }

    .legal-hero h1 {
        font-size: clamp(1.6rem, 4vw, 2.4rem);
        margin: 0 0 8px 0;
        font-weight: 800;
    }

    .legal-hero p {
        color: #93c5fd;
        font-size: 1rem;
        margin: 0;
        font-weight: 600;
    }

    .highlight-card {
        background: #fefce8;
        border: 1px solid #fef08a;
        border-left: 5px solid #eab308;
        padding: 20px 22px;
        border-radius: 14px;
        margin-bottom: 28px;
        color: #854d0e;
    }

    .highlight-card h3 {
        margin: 0 0 8px 0;
        font-size: 1.1rem;
        font-weight: 800;
        color: #713f12;
    }

    .highlight-card p {
        margin: 0;
        font-size: 0.92rem;
        line-height: 1.6;
    }

    .legal-card {
        background: #ffffff;
        border: 1.5px solid #e2e8f0;
        padding: 28px;
        border-radius: 16px;
        margin-bottom: 20px;
        box-shadow: 0 4px 16px rgba(15, 23, 42, 0.03);
    }

    .legal-card h2 {
        font-size: 1.25rem;
        font-weight: 800;
        color: #0f172a;
        margin: 0 0 14px 0;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .legal-card p {
        color: #475569;
        font-size: 0.94rem;
        line-height: 1.65;
        margin: 0 0 12px 0;
    }

    .legal-card p:last-child {
        margin-bottom: 0;
    }

    .legal-card ul {
        margin: 10px 0 14px 20px;
        padding: 0;
        color: #475569;
        font-size: 0.92rem;
        line-height: 1.65;
    }

    .legal-card li {
        margin-bottom: 8px;
    }

    .legal-card a {
        color: #2563eb;
        font-weight: 700;
        text-decoration: none;
    }

    .legal-card a:hover {
        text-decoration: underline;
    }

    @media (max-width: 640px) {
        .legal-container {
            padding: 0 14px;
            margin: 20px auto 40px auto;
        }
        .legal-hero {
            padding: 24px 16px;
        }
        .legal-card {
            padding: 20px 16px;
        }
        .legal-card h2 {
            font-size: 1.1rem;
        }
        .legal-card p, .legal-card ul {
            font-size: 0.88rem;
        }
    }
</style>
