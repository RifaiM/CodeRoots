---
import BaseLayout from '../layouts/BaseLayout.astro';
import PlatformHeader from '../components/PlatformHeader.astro';
import PlatformFooter from '../components/PlatformFooter.astro';

const navLinks = [
 { href: '/', label: 'Roadmap', icon: '️', title: 'Curriculum Roadmap' },
 { href: '/1. partA/hub.html', label: 'Foundations', icon: '', title: 'Foundations Academy' },
 { href: 'javascript:void(0)', label: 'Dojo', icon: '️', title: 'Practical Dojo Hub', id: 'dojoNavLink', extraClass: 'dojo-nav-highlight', onClick: 'openDojoHub()' },
 { href: 'javascript:void(0)', label: 'Certs', icon: '', title: 'Proof-of-Work Certificates', id: 'certificateNavLink', onClick: 'openCertificateHub()' }
];
---

<BaseLayout 
 title="Disclaimer | NoviCodes" 
 description="Review the legal, educational, trademark, and advertising disclosures for the NoviCodes interactive coding platform."
 showHeaderFooter={false}
>
 <PlatformHeader 
 slot="header"
 tagText="Field Guide // Governance"
 tagId="headerLogoTag"
 navLinks={navLinks}
 showXpBadge={false}
 showLevelBadge={false}
 />

 <!-- Main Content -->
 <main class="legal-container">
 <!-- Hero -->
 <div class="legal-hero">
 <span class="legal-meta">§ 03.00 // LEGAL DISCLOSURES</span>
 <h1>Platform Disclaimer</h1>
 <p>Educational Intent • Trademark Notices • Advertising &amp; Liability Disclosures</p>
 </div>

 <!-- Highlight Callout -->
 <div class="highlight-card">
 <h3>§ 03.01 • Independent Educational Publication</h3>
 <p>NoviCodes is an independent, 100% free, open-source educational project developed to help learners understand fullstack web development. All tutorials, code playgrounds, sandboxes, and interactive exercises are provided strictly for educational and self-directed study purposes.</p>
 </div>

 <!-- Section 1: Educational Purpose -->
 <div class="legal-card">
 <h2>§ 03.02 • Educational Purpose &amp; No Warranty</h2>
 <p>All information, interactive exercises, code snippets, simulated terminals, and documentation on NoviCodes are provided on an <strong>"as-is" and "as-available"</strong> basis without warranty of any kind, whether express or implied.</p>
 <p>While we make every effort to ensure our curriculum follows modern web standards and security best practices, NoviCodes does not guarantee that code examples are suitable for live, mission-critical, or high-security commercial production environments without independent code review and auditing.</p>
 </div>

 <!-- Section 2: Third-Party Trademarks -->
 <div class="legal-card">
 <h2>§ 03.03 • Third-Party Trademarks &amp; Fair Use</h2>
 <p>All product names, logos, brands, trademarks, and registered trademarks mentioned on this website belong to their respective owners. Their mention is strictly for identification, reference, and educational guidance under Fair Use principles.</p>
 <ul>
 <li><strong>JavaScript, HTML5, CSS3:</strong> Trademarks and specifications defined by W3C and ECMA International.</li>
 <li><strong>React:</strong> Registered trademark of Meta Platforms, Inc.</li>
 <li><strong>Python:</strong> Registered trademark of the Python Software Foundation (PSF).</li>
 <li><strong>Next.js:</strong> Registered trademark of Vercel Inc.</li>
 <li><strong>TypeScript:</strong> Registered trademark of Microsoft Corporation.</li>
 <li><strong>Docker, PostgreSQL, AWS, Stripe:</strong> Trademarks of their respective corporations.</li>
 </ul>
 <p>NoviCodes is an independent educational platform and is not affiliated with, endorsed by, or sponsored by any of the trademark holders listed above.</p>
 </div>

 <!-- Section 3: Advertising & Sponsorship -->
 <div class="legal-card">
 <h2>§ 03.04 • Advertising &amp; Creator Support Disclosure</h2>
 <p>To keep NoviCodes 100% free, open, and accessible to learners worldwide without paywalls or mandatory subscriptions, our website may display non-intrusive third-party advertisements and voluntary creator support links (Ko-fi and Trakteer).</p>
 <p>Third-party advertising vendors, including Google, use cookies to serve ads based on a user's prior visits to this website or other websites on the internet. Advertisements do not obstruct educational sandboxes, editor views, or the interactive learning experience.</p>
 </div>

 <!-- Section 4: External Links -->
 <div class="legal-card">
 <h2>§ 03.05 • External Links Disclaimer</h2>
 <p>NoviCodes may contain links to external third-party websites, documentation hubs (such as MDN Web Docs and GitHub), and developer tools that are not provided or maintained by NoviCodes.</p>
 <p>We do not guarantee the accuracy, relevance, or completeness of information on external websites, and accessing external links is done at the learner's own discretion.</p>
 </div>

 <!-- Section 5: Limitation of Liability -->
 <div class="legal-card">
 <h2>§ 03.06 • Limitation of Liability</h2>
 <p>In no event shall NoviCodes, its creators, contributors, or maintainers (Ra Labs) be liable for any direct, indirect, incidental, consequential, or special damages arising out of or in connection with the use of this website, code sandboxes, or the curriculum contained herein.</p>
 </div>

 <!-- Section 6: Contact & Inquiries -->
 <div class="legal-card">
 <h2>§ 03.07 • Contact &amp; Inquiries</h2>
 <p>If you have questions, feedback, or inquiries regarding this Disclaimer, please reach out through our official channels:</p>
 <ul>
 <li><strong>Developer Portfolio:</strong> <a href="https://rifaim.github.io/Portfolio" target="_blank" rel="noopener noreferrer">rifaim.github.io/Portfolio ↗</a></li>
 <li><strong>Open Source Repository:</strong> <a href="https://github.com/RifaiM/NoviCodes" target="_blank" rel="noopener noreferrer">GitHub / NoviCodes ↗</a></li>
 </ul>
 </div>
 </main>

 <!-- Universal Back to Top Floating Action Button -->
 <button class="back-to-top-btn" id="backToTopBtn" aria-label="Back to Top">
 <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
 <polyline points="18 15 12 9 6 15"></polyline>
 </svg>
 </button>

 <PlatformFooter />

 <script is:inline>
 document.addEventListener('DOMContentLoaded', () => {
 const btn = document.getElementById('backToTopBtn');
 if (!btn) return;
 window.addEventListener('scroll', () => {
 if (window.scrollY > 150) {
 btn.classList.add('visible');
 } else {
 btn.classList.remove('visible');
 }
 }, { passive: true });
 btn.addEventListener('click', () => {
 window.scrollTo({ top: 0, behavior: 'smooth' });
 });
 });
 </script>
</BaseLayout>

<style is:global>
 .legal-container {
 max-width: 820px;
 margin: 36px auto 60px auto;
 padding: 0 20px;
 box-sizing: border-box;
 font-family: var(--font-sans);
 color: var(--text-body);
 }

 .legal-hero {
 background: var(--card-elevated);
 border: 1px solid var(--border-subtle);
 color: var(--text-title);
 padding: 32px 28px;
 border-radius: 2px;
 margin-bottom: 24px;
 text-align: left;
 }

 .legal-meta {
 font-family: var(--font-mono);
 font-size: 0.72rem;
 font-weight: 600;
 text-transform: uppercase;
 letter-spacing: 0.05em;
 color: var(--accent-oxide);
 display: block;
 margin-bottom: 8px;
 }

 .legal-hero h1 {
 font-family: var(--font-serif);
 font-size: clamp(1.8rem, 3.5vw, 2.4rem);
 margin: 0 0 6px 0;
 font-weight: 500;
 line-height: 1.2;
 }

 .legal-hero p {
 color: var(--text-muted);
 font-size: 0.92rem;
 margin: 0;
 }

 .highlight-card {
 background: var(--card-elevated);
 border: 1px solid var(--border-subtle);
 border-left: 3px solid var(--accent-oxide);
 padding: 18px 20px;
 border-radius: 2px;
 margin-bottom: 24px;
 color: var(--text-body);
 }

 .highlight-card h3 {
 margin: 0 0 6px 0;
 font-family: var(--font-mono);
 font-size: 0.82rem;
 font-weight: 600;
 color: var(--accent-oxide);
 text-transform: uppercase;
 letter-spacing: 0.03em;
 }

 .highlight-card p {
 margin: 0;
 font-size: 0.90rem;
 line-height: 1.6;
 }

 .legal-card {
 background: var(--card-elevated);
 border: 1px solid var(--border-subtle);
 border-radius: 2px;
 padding: 24px 22px;
 margin-bottom: 16px;
 }

 .legal-card h2 {
 font-family: var(--font-mono);
 font-size: 0.95rem;
 font-weight: 600;
 color: var(--text-title);
 margin: 0 0 10px 0;
 letter-spacing: 0.02em;
 }

 .legal-card p, .legal-card ul {
 color: var(--text-body);
 font-size: 0.92rem;
 line-height: 1.65;
 margin: 0 0 10px 0;
 }

 .legal-card ul {
 padding-left: 20px;
 margin-bottom: 0;
 }

 .legal-card li {
 margin-bottom: 6px;
 }

 .legal-card a {
 color: var(--accent-oxide);
 text-decoration: underline;
 }

 @media (max-width: 576px) {
 .legal-container {
 margin: 20px auto 40px auto;
 padding: 0 14px;
 }
 .legal-hero {
 padding: 20px 16px;
 margin-bottom: 16px;
 }
 .legal-hero h1 {
 font-size: 1.5rem;
 }
 .legal-hero p {
 font-size: 0.84rem;
 }
 .highlight-card {
 padding: 14px 14px;
 margin-bottom: 16px;
 }
 .highlight-card p {
 font-size: 0.84rem;
 }
 .legal-card {
 padding: 18px 16px;
 margin-bottom: 14px;
 }
 .legal-card h2 {
 font-size: 0.86rem;
 }
 .legal-card p,
 .legal-card ul {
 font-size: 0.84rem;
 }
 }

 @media (max-width: 425px) {
 .legal-container {
 margin: 16px auto 32px auto;
 padding: 0 10px;
 }
 .legal-hero {
 padding: 16px 12px;
 margin-bottom: 12px;
 }
 .legal-hero h1 {
 font-size: 1.30rem;
 }
 .highlight-card {
 padding: 12px 12px;
 margin-bottom: 12px;
 }
 .legal-card {
 padding: 14px 12px;
 margin-bottom: 12px;
 }
 }

 @media (max-width: 360px) {
 .legal-container {
 padding: 0 6px;
 }
 .legal-hero {
 padding: 12px 8px;
 }
 .legal-hero h1 {
 font-size: 1.15rem;
 }
 .highlight-card {
 padding: 10px 8px;
 }
 .legal-card {
 padding: 12px 8px;
 }
 }
</style>
