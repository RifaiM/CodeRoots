            } else if (rawPath.includes('partb') || rawPath.includes('level4') || rawPath.includes('dom')) {
                if (lessonNum && lessonNum >= 1 && lessonNum <= 15) {
                    targetUrl = `/2. partB/lesson${lessonNum}/lesson${lessonNum}_remake.html`;
                    targetName = `Level 4 • JS DOM Dojo Lesson ${lessonNum}`;
                    targetDesc = `Jump directly into interactive DOM milestone ${lessonNum}.`;
                    tagHeader = '🚀 Exact Lesson Match';
                } else {
                    targetUrl = '/2. partB/hub.html';
                    targetName = 'Level 4 • JavaScript DOM Mastery Hub';
                    targetDesc = '15 interactive DOM projects, dynamic state UI, and browser canvas games.';
