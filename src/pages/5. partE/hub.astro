---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PlatformHeader from '../../components/PlatformHeader.astro';
import PlatformFooter from '../../components/PlatformFooter.astro';

const navLinks = [
    { href: '/', label: 'Dashboard', icon: '🏠', title: 'Dashboard Home' },
    { href: '/1. partA/hub.html', label: 'Foundations', icon: '📚', title: 'Foundations Academy' },
    { href: 'javascript:void(0)', label: 'Practical Dojo', icon: '⚔️', title: 'Practical Dojo Hub', active: true, extraClass: 'dojo-nav-highlight', onClick: 'openDojoHub()' }
];
---

<BaseLayout
    title="Python & Backend Architecture Dojo (Level 6) | NoviCodes"
    description="Master Python syntax, Object-Oriented Programming, and REST API architecture with real-time browser execution."
    showHeaderFooter={false}
>
    <!-- Top Global Header -->
    <PlatformHeader 
        slot="header"
        tagText="Python Dojo"
        tagId="headerLogoTag"
        navLinks={navLinks}
        showXpBadge={true}
        showLevelBadge={true}
    />

    <main class="hub-container">
        
        <!-- Hero Section -->
        <section class="hub-hero">
            <span class="hub-badge">🐍 Level 6 • Python Backend Dojo</span>
            <h1>Learn Backend Basics with Python & APIs</h1>
            <p>
                See what happens on the server behind the scenes. Learn Python basics, lists and dictionaries, error handling, saving data with SQLite, and creating simple API endpoints right in your browser.
            </p>

            <!-- Live Progress Bar -->
            <div class="hero-progress-wrap">
                <div class="hero-progress-info">
                    <span>Course Progress</span>
                    <span id="heroProgressText">0 of 15 Lessons Completed (0%)</span>
                </div>
                <div class="hero-progress-bar">
                    <div class="hero-progress-fill" id="heroProgressFill"></div>
                </div>
            </div>

            <!-- Smart Resume CTA -->
            <a href="/5. partE/lesson1/lesson1_remake.html" class="hero-cta-btn" id="heroResumeBtn">
                <span>🚀 Start Lesson 1: Python Essentials ➔</span>
            </a>
            <div style="margin-top: 14px; text-align: center;">
                <a href="/foundations.html?track=python" style="display: inline-flex; align-items: center; gap: 6px; font-size: 0.88rem; color: #059669; text-decoration: none; font-weight: 700; background: #ecfdf5; padding: 6px 16px; border-radius: 20px; transition: all 0.2s ease;">
                    <span>📖 New to Python? Explore Level 6 Foundations & Server Concepts ➔</span>
                </a>
            </div>
        </section>

        <!-- Stats Overview Row -->
        <section class="hub-stats-grid">
            <div class="hub-stat-card">
                <div class="hub-stat-val">3,000 XP</div>
                <div class="hub-stat-lbl">Total XP Bounty</div>
            </div>
            <div class="hub-stat-card">
                <div class="hub-stat-val" id="statCompletedProjects">0 / 15</div>
                <div class="hub-stat-lbl">Lessons Completed</div>
            </div>
            <div class="hub-stat-card">
                <div class="hub-stat-val">FastAPI + SQLite</div>
                <div class="hub-stat-lbl">Backend Stack</div>
            </div>
            <div class="hub-stat-card">
                <div class="hub-stat-val">Level 6 Python</div>
                <div class="hub-stat-lbl">Official Certificate</div>
            </div>
        </section>

        <!-- Curriculum Breakdown by Chapter -->
        <section class="curriculum-section">
            
            <!-- Chapter 1: Python Core Foundations & Control Flow -->
            <div class="chapter-block">
                <div class="chapter-header">
                    <div class="chapter-title-wrap">
                        <span class="chapter-num">Phase 1</span>
                        <h2 class="chapter-title">Python Basics & Logic</h2>
                    </div>
                    <span class="chapter-badge">Lessons 1–4 • 800 XP</span>
                </div>

                <div class="lesson-cards-grid">
                    <!-- Lesson 1 -->
                    <a href="/5. partE/lesson1/lesson1_remake.html" class="lesson-card" id="lessonCard1">
                        <div class="card-top">
                            <span class="lesson-idx">LESSON 01</span>
                            <span class="lesson-status-pill available" id="statusPill1">⚡ Up Next</span>
                        </div>
                        <h3 class="lesson-card-title">Python Essentials & Syntax</h3>
                        <div class="card-bottom">
                            <span class="xp-tag">⚡ +200 XP</span>
                            <span class="card-action-text" id="actionText1">Start ➔</span>
                        </div>
                    </a>

                    <!-- Lesson 2 -->
                    <a href="/5. partE/lesson2/lesson2_remake.html" class="lesson-card locked" id="lessonCard2">
                        <div class="card-top">
                            <span class="lesson-idx">LESSON 02</span>
                            <span class="lesson-status-pill locked" id="statusPill2">🔒 Locked</span>
                        </div>
                        <h3 class="lesson-card-title">Control Flow & Logic Engines</h3>
                        <div class="card-bottom">
                            <span class="xp-tag">⚡ +200 XP</span>
                            <span class="card-action-text" id="actionText2">Locked</span>
                        </div>
                    </a>

                    <!-- Lesson 3 -->
                    <a href="/5. partE/lesson3/lesson3_remake.html" class="lesson-card locked" id="lessonCard3">
                        <div class="card-top">
                            <span class="lesson-idx">LESSON 03</span>
                            <span class="lesson-status-pill locked" id="statusPill3">🔒 Locked</span>
                        </div>
                        <h3 class="lesson-card-title">Functions, Scope & Lambdas</h3>
                        <div class="card-bottom">
                            <span class="xp-tag">⚡ +200 XP</span>
                            <span class="card-action-text" id="actionText3">Locked</span>
                        </div>
                    </a>

                    <!-- Lesson 4 -->
                    <a href="/5. partE/lesson4/lesson4_remake.html" class="lesson-card locked" id="lessonCard4">
                        <div class="card-top">
                            <span class="lesson-idx">LESSON 04</span>
                            <span class="lesson-status-pill locked" id="statusPill4">🔒 Locked</span>
                        </div>
                        <h3 class="lesson-card-title">Data Structures & List Comprehensions</h3>
                        <div class="card-bottom">
                            <span class="xp-tag">⚡ +200 XP</span>
                            <span class="card-action-text" id="actionText4">Locked</span>
                        </div>
                    </a>
                </div>
            </div>

            <!-- Chapter 2: Object-Oriented Design & System Modules -->
            <div class="chapter-block">
                <div class="chapter-header">
                    <div class="chapter-title-wrap">
                        <span class="chapter-num">Phase 2</span>
                        <h2 class="chapter-title">Object-Oriented Design & System Modules</h2>
                    </div>
                    <span class="chapter-badge">Lessons 5–8 • 800 XP</span>
                </div>

                <div class="lesson-cards-grid">
                    <!-- Lesson 5 -->
                    <a href="/5. partE/lesson5/lesson5_remake.html" class="lesson-card locked" id="lessonCard5">
                        <div class="card-top">
                            <span class="lesson-idx">LESSON 05</span>
                            <span class="lesson-status-pill locked" id="statusPill5">🔒 Locked</span>
                        </div>
                        <h3 class="lesson-card-title">Object-Oriented Programming (OOP)</h3>
                        <div class="card-bottom">
                            <span class="xp-tag">⚡ +200 XP</span>
                            <span class="card-action-text" id="actionText5">Locked</span>
                        </div>
                    </a>

                    <!-- Lesson 6 -->
                    <a href="/5. partE/lesson6/lesson6_remake.html" class="lesson-card locked" id="lessonCard6">
                        <div class="card-top">
                            <span class="lesson-idx">LESSON 06</span>
                            <span class="lesson-status-pill locked" id="statusPill6">🔒 Locked</span>
                        </div>
                        <h3 class="lesson-card-title">OOP Inheritance & Polymorphism</h3>
                        <div class="card-bottom">
                            <span class="xp-tag">⚡ +200 XP</span>
                            <span class="card-action-text" id="actionText6">Locked</span>
                        </div>
                    </a>

                    <!-- Lesson 7 -->
                    <a href="/5. partE/lesson7/lesson7_remake.html" class="lesson-card locked" id="lessonCard7">
                        <div class="card-top">
                            <span class="lesson-idx">LESSON 07</span>
                            <span class="lesson-status-pill locked" id="statusPill7">🔒 Locked</span>
                        </div>
                        <h3 class="lesson-card-title">Error & Exception Handling</h3>
                        <div class="card-bottom">
                            <span class="xp-tag">⚡ +200 XP</span>
                            <span class="card-action-text" id="actionText7">Locked</span>
                        </div>
                    </a>

                    <!-- Lesson 8 -->
                    <a href="/5. partE/lesson8/lesson8_remake.html" class="lesson-card locked" id="lessonCard8">
                        <div class="card-top">
                            <span class="lesson-idx">LESSON 08</span>
                            <span class="lesson-status-pill locked" id="statusPill8">🔒 Locked</span>
                        </div>
                        <h3 class="lesson-card-title">Modules, Packages & Standard Library</h3>
                        <div class="card-bottom">
                            <span class="xp-tag">⚡ +200 XP</span>
                            <span class="card-action-text" id="actionText8">Locked</span>
                        </div>
                    </a>
                </div>
            </div>

            <!-- Chapter 3: Persistence, Async & Modern Web APIs with FastAPI -->
            <div class="chapter-block">
                <div class="chapter-header">
                    <div class="chapter-title-wrap">
                        <span class="chapter-num">Phase 3</span>
                        <h2 class="chapter-title">Persistence, Async & Modern Web APIs</h2>
                    </div>
                    <span class="chapter-badge">Lessons 9–12 • 800 XP</span>
                </div>

                <div class="lesson-cards-grid">
                    <!-- Lesson 9 -->
                    <a href="/5. partE/lesson9/lesson9_remake.html" class="lesson-card locked" id="lessonCard9">
                        <div class="card-top">
                            <span class="lesson-idx">LESSON 09</span>
                            <span class="lesson-status-pill locked" id="statusPill9">🔒 Locked</span>
                        </div>
                        <h3 class="lesson-card-title">File I/O & Data Persistence</h3>
                        <div class="card-bottom">
                            <span class="xp-tag">⚡ +200 XP</span>
                            <span class="card-action-text" id="actionText9">Locked</span>
                        </div>
                    </a>

                    <!-- Lesson 10 -->
                    <a href="/5. partE/lesson10/lesson10_remake.html" class="lesson-card locked" id="lessonCard10">
                        <div class="card-top">
                            <span class="lesson-idx">LESSON 10</span>
                            <span class="lesson-status-pill locked" id="statusPill10">🔒 Locked</span>
                        </div>
                        <h3 class="lesson-card-title">Asynchronous Python & Asyncio</h3>
                        <div class="card-bottom">
                            <span class="xp-tag">⚡ +200 XP</span>
                            <span class="card-action-text" id="actionText10">Locked</span>
                        </div>
                    </a>

                    <!-- Lesson 11 -->
                    <a href="/5. partE/lesson11/lesson11_remake.html" class="lesson-card locked" id="lessonCard11">
                        <div class="card-top">
                            <span class="lesson-idx">LESSON 11</span>
                            <span class="lesson-status-pill locked" id="statusPill11">🔒 Locked</span>
                        </div>
                        <h3 class="lesson-card-title">Databases & SQL ORM Integration</h3>
                        <div class="card-bottom">
                            <span class="xp-tag">⚡ +200 XP</span>
                            <span class="card-action-text" id="actionText11">Locked</span>
                        </div>
                    </a>

                    <!-- Lesson 12 -->
                    <a href="/5. partE/lesson12/lesson12_remake.html" class="lesson-card locked" id="lessonCard12">
                        <div class="card-top">
                            <span class="lesson-idx">LESSON 12</span>
                            <span class="lesson-status-pill locked" id="statusPill12">🔒 Locked</span>
                        </div>
                        <h3 class="lesson-card-title">RESTful Web APIs with FastAPI</h3>
                        <div class="card-bottom">
                            <span class="xp-tag">⚡ +200 XP</span>
                            <span class="card-action-text" id="actionText12">Locked</span>
                        </div>
                    </a>
                </div>
            </div>

            <!-- Chapter 4: Backend Security, Auth & Production Capstone -->
            <div class="chapter-block">
                <div class="chapter-header">
                    <div class="chapter-title-wrap">
                        <span class="chapter-num">Phase 4</span>
                        <h2 class="chapter-title">Backend Security, Auth & Production Capstone</h2>
                    </div>
                    <span class="chapter-badge">Lessons 13–15 • 600 XP</span>
                </div>

                <div class="lesson-cards-grid">
                    <!-- Lesson 13 -->
                    <a href="/5. partE/lesson13/lesson13_remake.html" class="lesson-card locked" id="lessonCard13">
                        <div class="card-top">
                            <span class="lesson-idx">LESSON 13</span>
                            <span class="lesson-status-pill locked" id="statusPill13">🔒 Locked</span>
                        </div>
                        <h3 class="lesson-card-title">Authentication & Security Basics</h3>
                        <div class="card-bottom">
                            <span class="xp-tag">⚡ +200 XP</span>
                            <span class="card-action-text" id="actionText13">Locked</span>
                        </div>
                    </a>

                    <!-- Lesson 14 -->
                    <a href="/5. partE/lesson14/lesson14_remake.html" class="lesson-card locked" id="lessonCard14">
                        <div class="card-top">
                            <span class="lesson-idx">LESSON 14</span>
                            <span class="lesson-status-pill locked" id="statusPill14">🔒 Locked</span>
                        </div>
                        <h3 class="lesson-card-title">Guided Mini Project: Task Manager API</h3>
                        <div class="card-bottom">
                            <span class="xp-tag">⚡ +200 XP</span>
                            <span class="card-action-text" id="actionText14">Locked</span>
                        </div>
                    </a>

                    <!-- Lesson 15 -->
                    <a href="/5. partE/lesson15/lesson15_remake.html" class="lesson-card locked" id="lessonCard15">
                        <div class="card-top">
                            <span class="lesson-idx">LESSON 15 • CAPSTONE</span>
                            <span class="lesson-status-pill locked" id="statusPill15">🔒 Locked</span>
                        </div>
                        <h3 class="lesson-card-title">🏆 Capstone Python Backend Service</h3>
                        <div class="card-bottom">
                            <span class="xp-tag">⚡ +200 XP</span>
                            <span class="card-action-text" id="actionText15">Locked</span>
                        </div>
                    </a>
                </div>
            </div>

        </section>

        <!-- Certificate Milestone Box -->
        <section class="certificate-preview-box">
            <div class="cert-info-wrap">
                <div class="cert-trophy-icon">🏆</div>
                <div>
                    <h3 class="cert-title">Python Python Backend Specialist Certificate</h3>
                    <p class="cert-desc" id="certDescText">
                        Complete all 15 Python and FastAPI backend projects to unlock your official Python Backend Specialist Certificate.
                    </p>
                </div>
            </div>
            <a href="javascript:void(0)" class="cert-action-btn locked" id="certActionBtn">
                <span>🔒 Complete All 15 First</span>
            </a>
        </section>

    </main>

    <!-- Platform Footer -->
    <PlatformFooter />

    <!-- Universal Back to Top Floating Action Button -->
    <button class="back-to-top-btn" id="backToTopBtn" aria-label="Back to Top">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="#ffffff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="18 15 12 9 6 15"></polyline>
        </svg>
    </button>

    <!-- Stylesheet -->
    <link rel="stylesheet" href="/5. partE/hub.css" />

    <!-- JavaScript Engines -->
    <script is:inline src="/scripts/dashboard.js"></script>
    <script is:inline src="/5. partE/hub.js"></script>
</BaseLayout>
