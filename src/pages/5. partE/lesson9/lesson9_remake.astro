            <div class="code-snippet-box">
                <button class="snippet-copy-btn" type="button" aria-label="Copy code snippet">📋 Copy</button>
                <pre><code id="refCodeBox_9">log_filename = "server.log"

with open(log_filename, "w") as file:
    file.write("INFO: System Online\n")

with open(log_filename, "r") as file:
    log_data = file.read()

print(f"Log output: &#123;log_data&#125;")</code></pre>
            </div>
