<LessonLayout
    title="Project 13: Authentication & Security Basics | Level 6 Python Dojo"
    description="Secure backend microservices with cryptographic password hashing (SHA-256) and security token validation."
    levelTag="Level 6 • Python Dojo"
    lessonNum={13}
    lessonTitle="Authentication & Security Basics"
    xpAmount={150}
    completionKey="partE_lesson13_remake_complete"
    nextLessonUrl="/5. partE/lesson14/lesson14_remake.html"
    hubUrl="/5. partE/hub.html"
    hubTitle="Level 6 Hub"
    hubIcon="🐍"
    fileTab="main.py"
    starterCode={starterCode}
    mode="python"
    jumpLessons={level6Lessons}
    certificateUrl="/5. partE/certificate.html"
    trackPrefix="partE"
>
    <!-- Intro Slot -->
    <p class="lesson-subtitle" slot="intro">
        Secure backend microservices with cryptographic password hashing (SHA-256) and security token validation.
    </p>

    <!-- Concept Slot (Left Pane) -->
    <div slot="concept" style="display: flex; flex-direction: column; gap: 16px;">
        
        <!-- Core Concept & Analogy -->
        <article class="concept-card">
            <h3><span>💡</span> Core Concept &amp; Mental Model</h3>
            <div class="analogy-callout">
                <strong>Real-World Analogy:</strong> Cryptographic hashing is a one-way blender: you can easily blend fruit into a unique smoothie, but no one can reconstruct the original fruit from the smoothie.
            </div>
        </article>

        
        <article class="concept-card">
            <h3><span>🔒</span> SHA-256 One-Way Hash Flow</h3>
            <div class="tag-demo">
                <div class="tag-example">
                    <div class="tag-code">hashlib.sha256(pw.encode())</div>
                    <div class="tag-result">Transforms string into 256-bit cryptographic digest</div>
                </div>
                <div class="tag-example">
                    <div class="tag-code">.hexdigest()</div>
                    <div class="tag-result">Produces 64-character hexadecimal representation</div>
                </div>
            </div>
        </article>

        <!-- Working Reference Code & Target Result -->
        <article class="concept-card">
            <h3><span>💻</span> Reference Code Pattern</h3>
            <p style="color: #475569; font-size: 0.88rem; margin: 0 0 8px 0;">How this architecture looks in real-world code:</p>
            <div class="code-snippet-box">
                <button class="snippet-copy-btn" type="button" aria-label="Copy code snippet">📋 Copy</button>
                <pre><code id="refCodeBox_13">import hashlib

def hash_password(password):
    return hashlib.sha256(password.encode()).hexdigest()

def verify_password(plain, expected_hash):
    return hash_password(plain) == expected_hash

secret = "SecureDev2026!"
hashed = hash_password(secret)
print(f"Hashed: &#123;hashed&#125;")
print(f"Match: &#123;verify_password(secret, hashed)&#125;")</code></pre>
            </div>
        </article>

        <!-- Task Instructions Card -->
        <article class="concept-card" style="border-left: 4px solid #059669;">
            <h3><span>🎯</span> Your Hands-On Coding Goal</h3>
            <p style="color: #475569; font-size: 0.90rem; line-height: 1.6; margin: 0 0 10px 0;">
                In the code editor on the right pane:
            </p>
            <ol style="color: #334155; font-size: 0.90rem; line-height: 1.7; padding-left: 20px; margin: 0;">
                <li>Import <code>hashlib</code> module.</li>
                <li>Implement <code>hash_password(password)</code> returning <code>hashlib.sha256(...).hexdigest()</code>.</li>
                <li>Implement <code>verify_password(plain, expected_hash)</code> comparing hashed plain against expected hash.</li>
            </ol>
        </article>

    </div>
</LessonLayout>

<!-- Client-Side Scripts & Verification Engine -->
<script>
    import { DojoEngine } from '../../../scripts/dojo';

    function initLesson() {
        const editor = document.getElementById('lessonEditor') as HTMLTextAreaElement | null;
        const lineNumbers = document.getElementById('ideLineNumbers');
        const lineNumbersInner = document.getElementById('ideLineNumbersInner') || lineNumbers;
        const terminalScreen = document.getElementById('terminalScreen');
        const checkBtn = document.getElementById('checkAnswerBtn');
        const resetBtn = document.getElementById('resetEditorBtn');

        if (!editor) return;

        const DRAFT_KEY = 'novicodes_draft_partE_lesson13';
        const DEFAULT_STARTER = `# 🛠️ Level 6 Lesson 13 Practice Task: Backend Security & Hashing

import hashlib

# Step 1: Define function hash_password(password)
# It should return hashlib.sha256(password.encode()).hexdigest()
# Write hash_password function here:


# Step 2: Define function verify_password(plain, expected_hash)
# Return hash_password(plain) == expected_hash
# Write verify_password function here:
`;

        // 1. Initialize Real-Time Conceptual Checklist
        DojoEngine.initChecklist([
            { id: 'hash_fn', label: 'Define <code>hash_password(password)</code> with <code>hashlib.sha256</code>', fn: (code) => { const c = code.replace(/#[^\n]*/g, ''); return /def\s+hash_password\s*\([\s\S]*?hashlib\.sha256/i.test(c); } },
            { id: 'hexdigest', label: 'Return <code>.hexdigest()</code> string', fn: (code) => { const c = code.replace(/#[^\n]*/g, ''); return /\.hexdigest\s*\(\s*\)/i.test(c); } },
            { id: 'verify_fn', label: 'Define <code>verify_password(plain, expected_hash)</code>', fn: (code) => { const c = code.replace(/#[^\n]*/g, ''); return /def\s+verify_password\s*\(/i.test(c) && /==/i.test(c); } }
        ], {
            containerId: 'taskChecklist',
            submitBtnId: 'checkAnswerBtn',
            nextBtnId: 'nextLessonBtn',
            mode: 'python'
        });

        // 2. Line numbers & scroll sync
        function syncScroll() {
            if (lineNumbersInner && editor) {
                lineNumbersInner.style.transform = `translateY(-${editor.scrollTop}px)`;
            }
        }

        function updateEditor() {
            if (!editor || !lineNumbersInner) return;
            const lines = editor.value.split('\n');
            const lineCount = Math.max(lines.length, 1);
            lineNumbersInner.textContent = Array.from({ length: lineCount }, (_, i) => i + 1).join('\n');
            syncScroll();

            // Real-Time Checklist Verification
            DojoEngine.runChecklist(editor.value);
        }

        // 3. Draft Auto-Save & Crash Resilience
        DojoEngine.setupDraftPersistence(editor, DRAFT_KEY, DEFAULT_STARTER, updateEditor);

        editor.addEventListener('scroll', syncScroll);

        editor.addEventListener('keydown', (e) => {
            if (e.key === 'Tab') {
                e.preventDefault();
                const start = editor.selectionStart;
                const end = editor.selectionEnd;
                editor.value = editor.value.substring(0, start) + '    ' + editor.value.substring(end);
                editor.selectionStart = editor.selectionEnd = start + 4;
                updateEditor();
            }
        });

        // 4. Safe Reset Button Handler
        if (resetBtn) {
            DojoEngine.setupResetButton(resetBtn, editor, DRAFT_KEY, DEFAULT_STARTER, () => {
                updateEditor();
                if (terminalScreen) {
                    terminalScreen.innerHTML = '<div class="terminal-prompt" style="color: #94a3b8;">&gt; Python Terminal reset. Ready to execute main.py</div>';
                }
            });
        }

        // 5. Python Terminal Simulation & Verification
        function simulatePythonOutput(code: string) {
            if (!terminalScreen) return;
            const prints: string[] = [];
            const lines = code.split('\n');

            for (const line of lines) {
                const trimmed = line.trim();
                const printMatch = trimmed.match(/^prints*\((.*)\)$/);
                if (printMatch) {
                    let content = printMatch[1].trim();
                    // Strip outer quotes if simple string
                    if ((content.startsWith('"') && content.endsWith('"')) || (content.startsWith("'") && content.endsWith("'"))) {
                        content = content.slice(1, -1);
                    } else if (content.startsWith('f"') || content.startsWith("f'")) {
                        content = content.slice(2, -1);
                    }
                    prints.push(content);
                }
            }

            if (prints.length > 0) {
                terminalScreen.innerHTML = prints.map(p => `<div style="color: #34d399;">&gt; ${p}</div>`).join('') +
                    '<div style="color: #38bdf8; margin-top: 8px; font-size: 0.76rem;">✓ [Process exited with code 0]</div>';
            } else {
                terminalScreen.innerHTML = '<div style="color: #34d399;">&gt; main.py executed successfully!</div>' +
                    '<div style="color: #38bdf8; margin-top: 8px; font-size: 0.76rem;">✓ [Process exited with code 0]</div>';
            }
        }

        // 6. Check & Verify Code Action
        if (checkBtn) {
            checkBtn.addEventListener('click', () => {
                const code = editor.value;

                if (DojoEngine.isEmpty(code)) {
                    DojoEngine.showLint('Your code editor is empty! Write your Python code before verifying.', 'error', 'Follow the step-by-step instructions in the left pane.');
                    return;
                }

                simulatePythonOutput(code);

                const result = DojoEngine.runChecklist(code);

                if (result.allPassed) {
                    DojoEngine.clearLint();
                    DojoEngine.celebrateCompletion({
                        lessonTitle: 'Project 13: Authentication & Security Basics',
                        xp: 150,
                        completionKey: 'partE_lesson13_remake_complete',
                        nextUrl: '/5. partE/lesson14/lesson14_remake.html',
                        customMessage: 'You have mastered this Python backend challenge!'
                    });
                } else {
                    const firstIncomplete = result.incompleteTasks[0];
                    const cleanLabel = firstIncomplete ? (firstIncomplete.label || firstIncomplete.text || 'Requirement').replace(/<[^>]+>/g, '').trim() : 'Requirement incomplete';
                    DojoEngine.showLint(`Mission Incomplete: ${cleanLabel}`, 'warning', 'Review "🎯 Your Mission" in the left pane and verify that your code matches the expected pattern.');
                    if (firstIncomplete) {
                        const targetItem = document.getElementById(`task_item_${firstIncomplete.id}`);
                        if (targetItem) {
                            targetItem.classList.remove('task-highlight-pulse');
                            void targetItem.offsetWidth;
                            targetItem.classList.add('task-highlight-pulse');
                            targetItem.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                        }
                    }
                }
            });
        }

        // Initial render
        updateEditor();
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initLesson);
    } else {
        initLesson();
    }
</script>
