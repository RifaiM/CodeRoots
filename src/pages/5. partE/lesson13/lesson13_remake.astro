<LessonLayout
    title="Project 13: Authentication & Security Basics | Level 6 Python Dojo"
    description="Secure user credentials using cryptographic SHA-256 password hashing and secure hash verification."
    levelTag="Level 6 • Python Dojo"
    lessonNum={13}
    lessonTitle="Password Hashing & Security"
    xpAmount={150}
    completionKey="partE_lesson13_remake_complete"
    nextLessonUrl="/5. partE/lesson14/lesson14_remake.html"
    hubUrl="/5. partE/hub.html"
    hubTitle="Level 6 Hub"
    hubIcon="🐍"
    fileTab="main.py"
    starterCode={starterCode}
    mode="python"
    jumpLessons={level6Lessons}
    certificateUrl="/5. partE/certificate.html"
    trackPrefix="partE"
>
    <!-- Intro Slot -->
    <p class="lesson-subtitle" slot="intro">
        Secure backend microservices with cryptographic password hashing (SHA-256) and security token validation.
    </p>

    <!-- Concept Slot (Left Pane) -->
    <div slot="concept" style="display: flex; flex-direction: column; gap: 16px;">
        
        <!-- 🎯 PROGATE-STYLE TOP MISSION CARD: Immediately informs learner what to do -->
        <!-- Unified Mission Card -->
        <article class="concept-card mission-card">
            <div class="mission-header">
                <h3><span>🎯</span> Your Mission</h3>
                <span class="checklist-counter" id="checklistCounter">0 / 2</span>
            </div>
            <div class="target-output-preview" style="background: #f1f5f9; border-radius: 8px; padding: 10px 12px; margin: 8px 0 12px 0; border: 1px dashed #94a3b8; font-size: 0.82rem;">
