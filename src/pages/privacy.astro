---
import BaseLayout from '../layouts/BaseLayout.astro';
import PlatformHeader from '../components/PlatformHeader.astro';
import PlatformFooter from '../components/PlatformFooter.astro';

const navLinks = [
    { href: '/#roadmap', label: 'Roadmap', iconName: 'map', title: 'Curriculum Roadmap' },
    { href: '/1. partA/hub.html', label: 'Foundations', iconName: 'book-open', title: 'Foundations Academy' },
    { href: 'javascript:void(0)', label: 'Dojo', iconName: 'swords', title: 'Practical Dojo Hub', id: 'dojoNavLink', extraClass: 'dojo-nav-highlight', onClick: 'openDojoHub()' },
    { href: 'javascript:void(0)', label: 'Certs', iconName: 'certificate', title: 'Proof-of-Work Certificates', id: 'certificateNavLink', onClick: 'openCertificateHub()' }
];
---

<BaseLayout 
 title="Privacy Policy | NoviCodes" 
 description="Understand how NoviCodes handles your learner data, local storage progress, and browser cookies responsibly."
 showHeaderFooter={false}
>
 <PlatformHeader 
 slot="header"
 tagText="Field Guide // Governance"
 tagId="headerLogoTag"
 navLinks={navLinks}
 showXpBadge={false}
 showLevelBadge={false}
 />

 <!-- Main Content -->
 <main class="legal-container">
 <!-- Hero -->
 <div class="legal-hero">
 <span class="legal-meta">§ 01.00 // POLICY GOVERNANCE</span>
 <h1>Privacy Policy</h1>
 <p>Client-Side LocalStorage Architecture • Zero Data Harvesting</p>
 </div>

 <!-- Highlight Callout -->
 <div class="highlight-card">
 <h3>§ 01.01 • Client-Side Architecture</h3>
 <p>NoviCodes is constructed as an open, client-side educational publication. Your XP score, completed lesson checks, unlock states, and code drafts remain strictly stored inside your own web browser's LocalStorage. We do not collect, harvest, track, or sell your personal data.</p>
 </div>

 <!-- Section 1 -->
 <div class="legal-card">
 <h2>§ 01.02 • Zero Tracking &amp; No Account Needed</h2>
 <p>NoviCodes does not require user registration, passwords, email addresses, or account creation. You are completely free to learn immediately without providing personal identifiers.</p>
 <p>We do not use tracking pixels, fingerprinting, or invasive analytics cookies.</p>
 </div>

 <!-- Section 2 -->
 <div class="legal-card">
 <h2>§ 01.03 • Local Storage Usage</h2>
 <p>NoviCodes stores course progression locally on your device using HTML5 Web Storage (<code>localStorage</code>). This data includes:</p>
 <ul>
 <li><strong>Completed Lesson Keys:</strong> Remembers which exercises you have completed.</li>
 <li><strong>XP &amp; Rank Stats:</strong> Stores earned experience points and unlocked milestone ranks.</li>
 <li><strong>Code Editor Drafts:</strong> Saves your current code draft so you can safely refresh without losing your work.</li>
 </ul>
 <p>You can clear or reset this data at any time using the <em>"Reset Course Progress"</em> button in your Learner Profile modal or by clearing your browser cache.</p>
 </div>

 <!-- Section 3 -->
 <div class="legal-card">
 <h2>§ 01.04 • Third-Party CDNs</h2>
 <p>To serve fonts and open-source JavaScript libraries reliably (such as GSAP animations and CodeMirror), NoviCodes loads static assets from public, high-speed Content Delivery Networks (CDNs) including cdnjs and Google Fonts. These CDNs receive standard HTTP request headers necessary to deliver static stylesheet and script files.</p>
 </div>

 <!-- Section 4 -->
 <div class="legal-card">
 <h2>§ 01.05 • Contact Information</h2>
 <p>For questions regarding platform privacy or data policies, open an issue on the open-source repository or contact the maintainer through the creator links in the footer.</p>
 </div>
 </main>

 <!-- Universal Back to Top Floating Action Button -->
 <button class="back-to-top-btn" id="backToTopBtn" aria-label="Back to Top">
 <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
 <polyline points="18 15 12 9 6 15"></polyline>
 </svg>
 </button>

 <PlatformFooter />

 <script is:inline>
 document.addEventListener('DOMContentLoaded', () => {
 const btn = document.getElementById('backToTopBtn');
 if (!btn) return;
 window.addEventListener('scroll', () => {
 if (window.scrollY > 150) {
 btn.classList.add('visible');
 } else {
 btn.classList.remove('visible');
 }
 }, { passive: true });
 btn.addEventListener('click', () => {
 window.scrollTo({ top: 0, behavior: 'smooth' });
 });
 });
 </script>
</BaseLayout>

<style is:global>
 .legal-container {
 max-width: 820px;
 margin: 36px auto 60px auto;
 padding: 0 20px;
 box-sizing: border-box;
 font-family: var(--font-sans);
 color: var(--text-body);
 }

 .legal-hero {
 background: var(--card-elevated);
 border: 1px solid var(--border-subtle);
 color: var(--text-title);
 padding: 32px 28px;
 border-radius: 2px;
 margin-bottom: 24px;
 text-align: left;
 }

 .legal-meta {
 font-family: var(--font-mono);
 font-size: 0.72rem;
 font-weight: 600;
 text-transform: uppercase;
 letter-spacing: 0.05em;
 color: var(--accent-oxide);
 display: block;
 margin-bottom: 8px;
 }

 .legal-hero h1 {
 font-family: var(--font-serif);
 font-size: clamp(1.8rem, 3.5vw, 2.4rem);
 margin: 0 0 6px 0;
 font-weight: 500;
 line-height: 1.2;
 }

 .legal-hero p {
 color: var(--text-muted);
 font-size: 0.92rem;
 margin: 0;
 }

 .highlight-card {
 background: var(--card-elevated);
 border: 1px solid var(--border-subtle);
 border-left: 3px solid var(--accent-oxide);
 padding: 18px 20px;
 border-radius: 2px;
 margin-bottom: 24px;
 color: var(--text-body);
 }

 .highlight-card h3 {
 margin: 0 0 6px 0;
 font-family: var(--font-mono);
 font-size: 0.82rem;
 font-weight: 600;
 color: var(--accent-oxide);
 text-transform: uppercase;
 letter-spacing: 0.03em;
 }

 .highlight-card p {
 margin: 0;
 font-size: 0.90rem;
 line-height: 1.6;
 }

 .legal-card {
 background: var(--card-elevated);
 border: 1px solid var(--border-subtle);
 border-radius: 2px;
 padding: 24px 22px;
 margin-bottom: 20px;
 }

 .legal-card h2 {
 font-family: var(--font-mono);
 font-size: 0.92rem;
 font-weight: 600;
 color: var(--text-title);
 margin: 0 0 12px 0;
 text-transform: uppercase;
 letter-spacing: 0.03em;
 }

 .legal-card p {
 font-size: 0.90rem;
 line-height: 1.65;
 color: var(--text-body);
 margin: 0 0 12px 0;
 }

 .legal-card p:last-child {
 margin-bottom: 0;
 }

 .legal-card ul {
 margin: 10px 0 14px 20px;
 padding: 0;
 font-size: 0.90rem;
 line-height: 1.65;
 color: var(--text-body);
 }

 .legal-card li {
 margin-bottom: 6px;
 }

 .legal-card code {
 font-family: var(--font-mono);
 font-size: 0.82rem;
 background: var(--surface-muted);
 padding: 2px 6px;
 border-radius: 2px;
 }

 .legal-card a {
 color: var(--accent-oxide);
 text-decoration: underline;
 font-weight: 500;
 }

 .legal-card a:hover {
 color: var(--accent-oxide-hover);
 }

 @media (max-width: 576px) {
 .legal-container {
 margin: 20px auto 40px auto;
 padding: 0 14px;
 }
 .legal-hero {
 padding: 20px 16px;
 margin-bottom: 16px;
 }
 .legal-hero h1 {
 font-size: 1.5rem;
 }
 .legal-hero p {
 font-size: 0.84rem;
 }
 .highlight-card {
 padding: 14px 14px;
 margin-bottom: 16px;
 }
 .highlight-card p {
 font-size: 0.84rem;
 }
 .legal-card {
 padding: 18px 16px;
 margin-bottom: 14px;
 }
 .legal-card h2 {
 font-size: 0.86rem;
 }
 .legal-card p,
 .legal-card ul {
 font-size: 0.84rem;
 }
 }

 @media (max-width: 425px) {
 .legal-container {
 margin: 16px auto 32px auto;
 padding: 0 10px;
 }
 .legal-hero {
 padding: 16px 12px;
 margin-bottom: 12px;
 }
 .legal-hero h1 {
 font-size: 1.30rem;
 }
 .highlight-card {
 padding: 12px 12px;
 margin-bottom: 12px;
 }
 .legal-card {
 padding: 14px 12px;
 margin-bottom: 12px;
 }
 }

 @media (max-width: 360px) {
 .legal-container {
 padding: 0 6px;
 }
 .legal-hero {
 padding: 12px 8px;
 }
 .legal-hero h1 {
 font-size: 1.15rem;
 }
 .highlight-card {
 padding: 10px 8px;
 }
 .legal-card {
 padding: 12px 8px;
 }
 }
</style>
