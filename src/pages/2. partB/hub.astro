---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PlatformHeader from '../../components/PlatformHeader.astro';
import Icon from '../../components/Icon.astro';
import PlatformFooter from '../../components/PlatformFooter.astro';

const navLinks = [
    { href: '/', label: 'Roadmap', iconName: 'map', title: 'Curriculum Roadmap' },
    { href: '/1. partA/hub.html', label: 'Foundations', iconName: 'book-open', title: 'Foundations Academy' },
    { href: 'javascript:void(0)', label: 'Dojo', iconName: 'swords', title: 'Practical Dojo Hub', id: 'dojoNavLink', extraClass: 'dojo-nav-highlight', onClick: 'openDojoHub()' },
    { href: 'javascript:void(0)', label: 'Certs', iconName: 'certificate', title: 'Proof-of-Work Certificates', id: 'certificateNavLink', onClick: 'openCertificateHub()' }
];
---

<BaseLayout
 title="DOM Dojo (Level 4) • 15 Hands-On Projects | NoviCodes"
 description="Build 15 real-world interactive DOM manipulation projects in vanilla JavaScript to earn your Level 4 Web Certificate."
 showHeaderFooter={false}
>
 <!-- Top Global Header -->
 <PlatformHeader 
 slot="header"
 tagText="DOM Dojo"
 tagId="headerLogoTag"
 navLinks={navLinks}
 showXpBadge={true}
 showLevelBadge={true}
 />

 <main class="hub-container">
 
 <!-- Hero Section -->
 <section class="hub-hero">
 <span class="hub-badge"><Icon name="swords" size={14} /> Level 4 • JavaScript Widget Dojo</span>
 <h1>Build 15 Interactive <span class="typewriter-wrap theme-oxide"><span class="typewriter-text" data-phrases='["JavaScript Widgets", "Modal Popups & Drawers", "Accordion FAQ Panels", "Tab Content Switchers", "Dynamic Form Validators"]' aria-label="JavaScript Widgets">JavaScript Widgets</span><span class="typewriter-cursor" aria-hidden="true">|</span></span></h1>
 <p>
 Put HTML, CSS, and JavaScript together step-by-step. Build navigation menus, styled cards, popups, and interactive forms with live visual feedback, and earn your Level 4 Certificate!
 </p>

 <!-- Live Progress Bar -->
 <div class="hero-progress-wrap">
 <div class="hero-progress-info">
 <span>Course Progress</span>
 <span id="heroProgressText">0 of 15 Lessons Completed (0%)</span>
 </div>
 <div class="hero-progress-bar">
 <div class="hero-progress-fill" id="heroProgressFill"></div>
 </div>
 </div>

 <!-- Smart Resume CTA -->
 <a href="/2. partB/lesson1/lesson1_remake.html" class="hero-cta-btn" id="heroResumeBtn">
 <span>Start Lesson 1: Page Structure →</span>
 </a>
 </section>

 <!-- Stats Overview Row -->
 <section class="hub-stats-grid">
 <div class="hub-stat-card">
 <div class="hub-stat-val">1,500 XP</div>
 <div class="hub-stat-lbl">Total XP Bounty</div>
 </div>
 <div class="hub-stat-card">
 <div class="hub-stat-val" id="statCompletedProjects">0 / 15</div>
 <div class="hub-stat-lbl">Lessons Completed</div>
 </div>
 <div class="hub-stat-card">
 <div class="hub-stat-val">100% Client-Side</div>
 <div class="hub-stat-lbl">Live Sandbox Execution</div>
 </div>
 <div class="hub-stat-card">
 <div class="hub-stat-val">Level 4 Web</div>
 <div class="hub-stat-lbl">Official Certificate</div>
 </div>
 </section>

 <!-- Curriculum Breakdown by Chapter -->
 <section class="curriculum-section">
 
 <!-- Chapter 1: HTML & Structural Architecture -->
