 <div class="card-top">
 <span class="lesson-idx">LESSON 01</span>
 <span class="lesson-status-pill available" id="statusPill1">UP NEXT</span>
 </div>
 <h3 class="lesson-card-title">Interactive HTML Page Structure</h3>
 <div class="card-bottom">
 <span class="xp-tag">+100 XP</span>
 <span class="card-action-text" id="actionText1">Start →</span>
 </div>
 </a>

