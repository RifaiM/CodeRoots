const starterCode = "<!DOCTYPE html>\n<html>\n<head>\n <title>Dynamic Elements</title>\n</head>\n<body style=\"padding: 20px; font-family: sans-serif;\">\n <button id=\"addCardBtn\" style=\"padding: 10px 18px; background: #0284c7; color: #fff; border: none; border-radius: 8px; cursor: pointer;\">Add Element</button>\n <ul id=\"itemList\" style=\"margin-top: 16px; padding-left: 20px;\"></ul>\n\n <script>\n const addBtn = document.getElementById('addCardBtn');\n const list = document.getElementById('itemList');\n\n addBtn.addEventListener('click', () => {\n // STEP 1: Create a new <li> element using document.createElement('li'):\n \n\n // STEP 2: Set newItem.textContent = \"New Dynamic Item\" and append it to list using list.appendChild(newItem):\n \n\n });\n </script>\n</body>\n</html>\n";
---

<LessonLayout
 title="Project 12: DOM Manipulation & Dynamic Elements | Level 4 DOM Dojo"
 description={"Dynamically create, modify, and append new HTML elements into the DOM tree using JavaScript."}
 levelTag="Level 4 • DOM Dojo"
 lessonNum={12}
 lessonTitle="DOM Manipulation & Dynamic Elements"
 xpAmount={100}
 completionKey="partB_lesson12_remake_complete"
 nextLessonUrl="/2. partB/lesson13/lesson13_remake.html"
 hubUrl="/2. partB/hub.html"
 hubTitle="Level 4 Hub"
 hubIcon="️"
 fileTab="index.html"
 starterCode={starterCode}
 mode="html"
 jumpLessons={level4Lessons}
 certificateUrl="/2. partB/certificate.html"
 trackPrefix="partB"
>
 <!-- Intro Slot -->
 <p class="lesson-subtitle" slot="intro">
 Dynamically create, modify, and append new HTML elements into the DOM tree using JavaScript.
 </p>

 <!-- Concept Slot (Left Pane) -->
 <div slot="concept" style="display: flex; flex-direction: column; gap: 16px;">
 
 <!-- PROGATE-STYLE TOP MISSION CARD: Immediately informs learner what to do -->
 <article class="concept-card mission-card">
 <div class="mission-header">
 <div class="mission-title-box">
 <span style="font-size: 1.25rem;"></span>
 <h3 style="margin: 0; font-size: 1.05rem; font-weight: 700; color: #0f172a;">Your Mission</h3>
 </div>
 <span class="checklist-counter" id="checklistCounter">0 / 2</span>
 </div>
 <p style="color: #475569; font-size: 0.88rem; line-height: 1.5; margin: 0 0 12px 0;">
 Complete these step-by-step instructions in the code editor on the right:
 </p>
 <div id="taskChecklist"></div>
 </article>

 <!-- Core Concept & Real-World Analogy -->
 <article class="concept-card">
 <h3><span></span> Core Concept &amp; Mental Model</h3>
 <div class="analogy-callout">
 <strong>Real-World Analogy:</strong> Think of the DOM as a family tree. `createElement` births a new child node, `textContent` gives it an identity, and `appendChild` welcomes it into the family tree on screen.
 </div>
 </article>

 <!-- ️ Core Building Blocks Guide -->
 <article class="concept-card">
 <h3><span>️</span> DOM Mutation Methods</h3>
 <p style="color: #475569; font-size: 0.88rem; margin: 0 0 10px 0;">Methods to generate UI on the fly:</p>
 <div class="tag-demo">
 <div class="tag-example">
 <div class="tag-code">{"document.createElement(\"li\")"}</div>
 <div class="tag-result">Creates a new detached DOM node</div>
 </div>
 <div class="tag-example">
 <div class="tag-code">{"list.appendChild(newItem)"}</div>
 <div class="tag-result">Inserts node as child of target list</div>
 </div>
 </div>
 </article>

 <!-- Architecture Blueprint -->
 <article class="concept-card">
 <h3><span></span> Dynamic Creation Cycle</h3>
 <p style="color: #475569; font-size: 0.88rem; margin: 0 0 10px 0;">The standard 3-step node creation lifecycle:</p>
 <div class="blueprint-icons-grid">
 <div class="blueprint-icon-card">
 <span class="em"></span>
 <div class="name">{"Create"}</div>
 <div class="desc">createElement("li")</div>
 </div>
 <div class="blueprint-icon-card">
 <span class="em">️</span>
 <div class="name">{"Configure"}</div>
 <div class="desc">textContent = "..."</div>
 </div>
 <div class="blueprint-icon-card">
 <span class="em"></span>
 <div class="name">{"Append"}</div>
 <div class="desc">appendChild(node)</div>
 </div>
 </div>
 </article>

 <!-- Working Reference Code Pattern -->
 <article class="concept-card">
 <h3><span></span> Reference Code Pattern</h3>
 <p style="color: #475569; font-size: 0.88rem; margin: 0 0 8px 0;">How this architecture looks in real-world code:</p>
 <div class="code-snippet-box">
 <button class="snippet-copy-btn" onclick="navigator.clipboard.writeText(document.getElementById('refCodeBox_12')?.innerText || '')"> Copy</button>
 <pre><code id="refCodeBox_12">{"const newItem = document.createElement('li');\nnewItem.textContent = 'New Dynamic Item';\nlist.appendChild(newItem);"}</code></pre>
 </div>
 </article>

 </div>
</LessonLayout>

<!-- Client-Side Scripts & Verification Engine -->
<script>
 import { DojoEngine } from '../../../scripts/dojo';

 function initLesson() {
 const editor = document.getElementById('lessonEditor') as HTMLTextAreaElement | null;
 const lineNumbers = document.getElementById('ideLineNumbers');
 const lineNumbersInner = document.getElementById('ideLineNumbersInner') || lineNumbers;
 const previewIframe = document.getElementById('livePreviewIframe') as HTMLIFrameElement | null;
 const checkBtn = document.getElementById('checkAnswerBtn');
 const resetBtn = document.getElementById('resetEditorBtn');

 if (!editor) return;

 const DRAFT_KEY = 'partB_lesson12_remake_draft';
 const DEFAULT_STARTER = "<!DOCTYPE html>\n<html>\n<head>\n <title>Dynamic Elements</title>\n</head>\n<body style=\"padding: 20px; font-family: sans-serif;\">\n <button id=\"addCardBtn\" style=\"padding: 10px 18px; background: #0284c7; color: #fff; border: none; border-radius: 8px; cursor: pointer;\">Add Element</button>\n <ul id=\"itemList\" style=\"margin-top: 16px; padding-left: 20px;\"></ul>\n\n <script>\n const addBtn = document.getElementById('addCardBtn');\n const list = document.getElementById('itemList');\n\n addBtn.addEventListener('click', () => {\n // STEP 1: Create a new <li> element using document.createElement('li'):\n \n\n // STEP 2: Set newItem.textContent = \"New Dynamic Item\" and append it to list using list.appendChild(newItem):\n \n\n });\n <\/script>\n</body>\n</html>\n";

 // 1. Initialize Real-Time Conceptual Checklist
 DojoEngine.initChecklist([
 { id: 'create_elem', label: '<strong>Step 1:</strong> Create a new <code>&lt;li&gt;</code> element with <code>document.createElement(\'li\')</code>', fn: (code) => { const c = code.replace(/\/\*[\s\S]*?\*\//g, '').replace(/(?<!:)\/\/[^\r\n]*/g, '').replace(/<!--[\s\S]*?-->/g, ''); return /document\.createElement\s*\(\s*["']li["']\s*\)/i.test(c); } },
 { id: 'append_child', label: '<strong>Step 2:</strong> Set <code>textContent</code> and append node using <code>list.appendChild(newItem)</code>', fn: (code) => { const c = code.replace(/\/\*[\s\S]*?\*\//g, '').replace(/(?<!:)\/\/[^\r\n]*/g, '').replace(/<!--[\s\S]*?-->/g, ''); return /\.textContent\s*=\s*["'][^"']+["']/i.test(c) && /\.appendChild\s*\([^)]+\)/i.test(c); } }
 ], {
 containerId: 'taskChecklist',
 submitBtnId: 'checkAnswerBtn',
 nextBtnId: 'nextLessonBtn',
 mode: 'html'
 });

 // 2. Line numbers and scroll sync
 function syncScroll() {
 if (lineNumbersInner && editor) {
 lineNumbersInner.style.transform = `translateY(-${editor.scrollTop}px)`;
 }
 }

 function updateEditor() {
 if (!editor || !lineNumbersInner) return;
 const lines = editor.value.split('\n');
 const lineCount = Math.max(lines.length, 1);
 lineNumbersInner.textContent = Array.from({ length: lineCount }, (_, i) => i + 1).join('\n');
 syncScroll();

 // Render live preview instantly via srcdoc
 if (previewIframe) {
 previewIframe.srcdoc = editor.value;
 }

 // Real-Time Intelligent Linter
 DojoEngine.lint(editor.value, 'html');

 // Real-Time Checklist
 DojoEngine.runChecklist(editor.value);
 }

 // 3. Draft Auto-Save & Crash Resilience
 DojoEngine.setupDraftPersistence(editor, DRAFT_KEY, DEFAULT_STARTER, updateEditor);

 editor.addEventListener('scroll', syncScroll);

 // 4. Safe Reset Button Handler
 if (resetBtn) {
 DojoEngine.setupResetButton(resetBtn, editor, DRAFT_KEY, DEFAULT_STARTER, updateEditor);
 }

 // 5. Check & Verify Code Action with Empty & Diagnostics Protection
 if (checkBtn) {
 checkBtn.addEventListener('click', () => {
 DojoEngine.verifySubmission(editor.value, {
 lessonTitle: 'Project 12: DOM Manipulation & Dynamic Elements',
 xp: 100,
 completionKey: 'partB_lesson12_remake_complete',
 nextUrl: '/2. partB/lesson13/lesson13_remake.html',
 mode: 'html'
 });
 });
 }

 // Initial render
 updateEditor();
 }

 if (document.readyState === 'loading') {
 document.addEventListener('DOMContentLoaded', initLesson);
 } else {
 initLesson();
 }
</script>
