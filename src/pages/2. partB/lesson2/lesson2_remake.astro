>
    <!-- Intro Slot -->
    <p class="lesson-subtitle" slot="intro">
        Master the 6 levels of HTML headings and text formatting to build clear, readable typographic hierarchies.
    </p>

    <!-- Concept Slot (Left Pane) -->
    <div slot="concept" style="display: flex; flex-direction: column; gap: 16px;">
        
        <!-- Core Concept & Analogy -->
        <article class="concept-card">
            <h3><span>💡</span> Core Concept &amp; Mental Model</h3>
            <div class="analogy-callout">
                <strong>Real-World Analogy:</strong> Headings are like newspaper hierarchy: <code>&lt;h1&gt;</code> is the bold front-page headline, <code>&lt;h2&gt;</code> is the article section header, and <code>&lt;h3&gt;</code> is a sub-topic header.
            </div>
        </article>

        
        <!-- Heading Hierarchy Interactive Visualizer -->
        <article class="concept-card">
            <h3><span>🗂️</span> Heading Hierarchy Visualizer</h3>
            <p style="color: #475569; font-size: 0.88rem; margin: 0 0 10px 0;">Visualizing relative font sizes and structural importance:</p>
            <div class="heading-hierarchy-list">
                <div class="heading-item">
                    <span class="heading-tag">&lt;h1&gt;Main Title&lt;/h1&gt;</span>
                    <span style="font-size: 1.25rem; font-weight: 800; color: #0f172a;">32px Bold</span>
                </div>
                <div class="heading-item">
                    <span class="heading-tag">&lt;h2&gt;Section Subheading&lt;/h2&gt;</span>
                    <span style="font-size: 1.05rem; font-weight: 700; color: #1e293b;">24px SemiBold</span>
                </div>
                <div class="heading-item">
                    <span class="heading-tag">&lt;h3&gt;Sub-Topic Title&lt;/h3&gt;</span>
                    <span style="font-size: 0.92rem; font-weight: 600; color: #334155;">18px Medium</span>
                </div>
            </div>
        </article>

        <!-- Text Formatting Magic -->
        <article class="concept-card">
            <h3><span>✨</span> Text Formatting Elements</h3>
            <div class="tag-demo">
                <div class="tag-example">
                    <div class="tag-code">&lt;strong&gt;Bold&lt;/strong&gt;</div>
                    <div class="tag-result">Important, high-priority text</div>
                </div>
                <div class="tag-example">
                    <div class="tag-code">&lt;em&gt;Emphasis&lt;/em&gt;</div>
                    <div class="tag-result">Stressed, italic vocal inflection</div>
                </div>
                <div class="tag-example">
                    <div class="tag-code">&lt;mark&gt;Highlight&lt;/mark&gt;</div>
                    <div class="tag-result">Yellow background highlighter</div>
                </div>
            </div>
        </article>


        <!-- Working Reference Code & Target Result -->
        <article class="concept-card">
            <h3><span>💻</span> Reference Code Pattern</h3>
            <p style="color: #475569; font-size: 0.88rem; margin: 0 0 8px 0;">How this architecture looks in real-world code:</p>
