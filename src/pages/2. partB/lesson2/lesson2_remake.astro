<LessonLayout
    title="Project 02: Typography & Heading Hierarchy | Level 4 DOM Dojo"
    description="Master the 6 levels of HTML headings and text formatting to build clear, readable typographic hierarchies."
    levelTag="Level 4 • DOM Dojo"
    lessonNum={2}
    lessonTitle="Typography & Heading Hierarchy"
    xpAmount={100}
