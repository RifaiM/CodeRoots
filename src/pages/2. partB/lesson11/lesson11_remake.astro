 <div class="tag-demo">
 <div class="tag-example">
 <div class="tag-code">{"btn.addEventListener(\"click\", () => { ... })"}</div>
 <div class="tag-result">Listens for click events on target element</div>
 </div>
 <div class="tag-example">
 <div class="tag-code">{"msg.textContent = \"New text\";"}</div>
 <div class="tag-result">Updates text inside element safely</div>
 </div>
 </div>
 </article>

