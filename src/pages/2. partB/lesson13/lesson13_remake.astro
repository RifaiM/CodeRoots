---

<LessonLayout
    title="Project 13: Interactive Forms & Input Validation | Level 4 DOM Dojo"
    description="Capture user form submissions, prevent page reloads with e.preventDefault(), and validate text inputs."
    levelTag="Level 4 • DOM Dojo"
    lessonNum={13}
    lessonTitle="Interactive Forms & Input Validation"
    xpAmount={100}
    completionKey="partB_lesson13_remake_complete"
    nextLessonUrl="/2. partB/lesson14/lesson14_remake.html"
    hubUrl="/2. partB/hub.html"
    hubTitle="Level 4 Hub"
    hubIcon="⚔️"
    fileTab="index.html"
    starterCode={starterCode}
    mode="html"
    jumpLessons={level4Lessons}
    certificateUrl="/2. partB/certificate.html"
    trackPrefix="partB"
>
    <!-- Intro Slot -->
    <p class="lesson-subtitle" slot="intro">
        Capture user form submissions, prevent page reloads with e.preventDefault(), and validate text inputs.
    </p>

    <!-- Concept Slot (Left Pane) -->
    <div slot="concept" style="display: flex; flex-direction: column; gap: 16px;">
        
        <!-- Core Concept & Analogy -->
        <article class="concept-card">
            <h3><span>💡</span> Core Concept &amp; Mental Model</h3>
            <div class="analogy-callout">
                <strong>Real-World Analogy:</strong> Form validation is a nightclub security bouncer: it checks user credentials before letting data enter the VIP server.
            </div>
        </article>

        
        <!-- Form Control Essentials -->
        <article class="concept-card">
            <h3><span>🛡️</span> Form Submission Flow</h3>
            <div class="intro-highlight">
                <code>e.preventDefault();</code>
                <p style="margin: 6px 0 0 0; font-size: 0.82rem; color: #1e3a8a;">Stops the browser from performing a full page reload so JavaScript can handle data smoothly in the background.</p>
            </div>
        </article>


        <!-- Working Reference Code & Target Result -->
        <article class="concept-card">
            <h3><span>💻</span> Reference Code Pattern</h3>
            <p style="color: #475569; font-size: 0.88rem; margin: 0 0 8px 0;">How this architecture looks in real-world code:</p>
            <div class="code-snippet-box">
                <button class="snippet-copy-btn" onclick="navigator.clipboard.writeText(document.getElementById('refCodeBox_13')?.innerText || '')">📋 Copy</button>
                <pre><code id="refCodeBox_13">&lt;form id="signupForm"&gt;
  &lt;input type="text" id="usernameInput"&gt;
  &lt;button type="submit"&gt;Join&lt;/button&gt;
&lt;/form&gt;
&lt;div id="statusMessage"&gt;&lt;/div&gt;
&lt;script&gt;
  form.addEventListener('submit', (e) =&gt; &#123;
    e.preventDefault();
    if (input.value.trim().length &lt; 3) &#123;
      status.textContent = "Error: Username too short!";
    &#125; else &#123;
      status.textContent = "Success: Account created!";
    &#125;
  &#125;);
&lt;/script&gt;</code></pre>
            </div>
        </article>

        <!-- Task Instructions Card -->
        <article class="concept-card" style="border-left: 4px solid #2563eb;">
            <h3><span>🎯</span> Your Hands-On Coding Goal</h3>
            <p style="color: #475569; font-size: 0.90rem; line-height: 1.6; margin: 0 0 10px 0;">
                In the code editor on the right pane:
            </p>
            <ol style="color: #334155; font-size: 0.90rem; line-height: 1.7; padding-left: 20px; margin: 0;">
                <li>Listen for <code>submit</code> events on <code>#signupForm</code>.</li>
                <li>Call <code>e.preventDefault()</code> to stop page reloads.</li>
                <li>Check <code>input.value.trim().length >= 3</code> and display feedback.</li>
            </ol>
        </article>

    </div>
</LessonLayout>

<!-- Client-Side Scripts & Verification Engine -->
<script>
    import { DojoEngine } from '../../../scripts/dojo';

    function initLesson() {
        const editor = document.getElementById('lessonEditor') as HTMLTextAreaElement | null;
        const lineNumbers = document.getElementById('ideLineNumbers');
        const lineNumbersInner = document.getElementById('ideLineNumbersInner') || lineNumbers;
        const previewIframe = document.getElementById('livePreviewIframe') as HTMLIFrameElement | null;
        const checkBtn = document.getElementById('checkAnswerBtn');
        const resetBtn = document.getElementById('resetEditorBtn');

        if (!editor) return;

        const DRAFT_KEY = 'novicodes_draft_partB_lesson13';
        const DEFAULT_STARTER = `<!-- 🛠️ Project 13: Forms & Input Validation -->
<form id="signupForm">
  <input type="text" id="usernameInput" placeholder="Enter username (min 3 chars)">
  <button type="submit">Join</button>
</form>
<div id="statusMessage"></div>

<script>
  const form = document.getElementById('signupForm');
  const input = document.getElementById('usernameInput');
  const status = document.getElementById('statusMessage');

  // Step 1: Add a 'submit' event listener to the form


  // Step 2: Prevent default page reload with e.preventDefault()


  // Step 3: Validate input.value.trim().length >= 3 and display status

<\/script>
`;

        // 1. Initialize Real-Time Conceptual Checklist
        DojoEngine.initChecklist([
            { 
                id: 'submit_event', 
                label: 'Listen for <code>submit</code> event and call <code>e.preventDefault()</code>', 
                fn: (code) => /addEventListener\(['"]submit['"]\)/i.test(c) && /preventDefault\(\)/i.test(code),
            },
            { 
                id: 'validation_check',
                label: 'Validate username length and update <code>#statusMessage</code>',
                fn: (code) => /value\.trim\(\)\.length/i.test(c) || /value\.length/i.test(code)
            }
        ], {
            containerId: 'taskChecklist',
            submitBtnId: 'checkAnswerBtn',
            nextBtnId: 'nextLessonBtn',
            mode: 'html'
        });

        // 2. Line numbers and scroll sync
        function syncScroll() {
            if (lineNumbersInner && editor) {
                lineNumbersInner.style.transform = `translateY(-${editor.scrollTop}px)`;
            }
        }

        function updateEditor() {
            if (!editor || !lineNumbersInner) return;
            const lines = editor.value.split('\n');
            const lineCount = Math.max(lines.length, 1);
            lineNumbersInner.textContent = Array.from({ length: lineCount }, (_, i) => i + 1).join('\n');
            syncScroll();

            // Render live preview instantly via srcdoc
            if (previewIframe) {
                previewIframe.srcdoc = editor.value;
            }

            // Real-Time Intelligent Linter
            DojoEngine.lint(editor.value, 'html');

            // Real-Time Checklist
            DojoEngine.runChecklist(editor.value);
        }

        // 3. Draft Auto-Save & Crash Resilience
        DojoEngine.setupDraftPersistence(editor, DRAFT_KEY, DEFAULT_STARTER, updateEditor);

        editor.addEventListener('scroll', syncScroll);

        // Tab indentation key support
        editor.addEventListener('keydown', (e) => {
            if (e.key === 'Tab') {
                e.preventDefault();
                const start = editor.selectionStart;
                const end = editor.selectionEnd;
                editor.value = editor.value.substring(0, start) + '  ' + editor.value.substring(end);
                editor.selectionStart = editor.selectionEnd = start + 2;
                updateEditor();
            }
        });

        // 4. Safe Reset Button Handler
        if (resetBtn) {
            DojoEngine.setupResetButton(resetBtn, editor, DRAFT_KEY, DEFAULT_STARTER, updateEditor);
        }

        // 5. Check & Verify Code Action with Empty & Diagnostics Protection
        if (checkBtn) {
            checkBtn.addEventListener('click', () => {
                const code = editor.value;

                // Empty or Whitespace-only Submission Protection
                if (DojoEngine.isEmpty(code)) {
                    DojoEngine.showLint('Your code editor is empty! Write your code before verifying.', 'error', 'Follow the step-by-step instructions in the left pane.');
                    return;
                }

                // Check for blocking syntax errors from Linter
                const problems = DojoEngine.lint(code, 'html');
                const hasErrors = problems.some(p => p.severity === 'error');
                if (hasErrors) {
                    return; // Block submission while syntax errors exist
                }

                const result = DojoEngine.runChecklist(code);

                if (result.allPassed) {
                    DojoEngine.clearLint();
                    DojoEngine.celebrateCompletion({
                        lessonTitle: 'Lesson 13: Interactive Forms & Input Validation',
                        xp: 100,
                        completionKey: 'partB_lesson13_remake_complete',
                        nextUrl: '/2. partB/lesson14/lesson14_remake.html',
                        customMessage: 'You have mastered this project challenge!'
                    });
                } else {
                    DojoEngine.showLint('Project requirements incomplete', 'warning', 'Check the task checklist below to see remaining requirements.');
                }
            });
        }

        // Initial render
        updateEditor();
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initLesson);
    } else {
        initLesson();
    }
</script>
