---
import LessonLayout from '../../../layouts/LessonLayout.astro';

const starterCode = `// __tests__/Counter.test.jsx
// 🛠️ Practice Task: Write Component Tests with Jest & RTL

import { render, screen, fireEvent } from '@testing-library/react';
import Counter from '../components/Counter';

// Step 1: Write test('increments count on click', () => { ... })
// Render <Counter />
// Trigger fireEvent.click(button)
// Expect screen.getByText(/Count: 1/) to be in document
// Write test here:
`;

const branchLessons = [
    {
        "id": 1,
        "title": "Next.js App Router",
        "url": "/6. partF/branchC/lesson1_remake.html"
    },
    {
        "id": 2,
        "title": "Server & Client UI",
        "url": "/6. partF/branchC/lesson2_remake.html"
    },
    {
        "id": 3,
        "title": "Zustand Global State",
        "url": "/6. partF/branchC/lesson3_remake.html"
    },
    {
        "id": 4,
        "title": "Tailwind UI Architecture",
        "url": "/6. partF/branchC/lesson4_remake.html"
    },
    {
        "id": 5,
        "title": "Unit & E2E Testing",
        "url": "/6. partF/branchC/lesson5_remake.html"
    },
    {
        "id": 6,
        "title": "Production Capstone Service",
        "url": "/6. partF/branchC/lesson6_remake.html"
    }
];
---

<LessonLayout
    title="Milestone 05: Unit & E2E Testing | Level 7C • Next.js & Frontend"
    description="Write automated tests with Jest and React Testing Library to verify component rendering and state interactions."
    levelTag="Level 7C • Next.js & Frontend"
    lessonNum={5}
    lessonTitle="Unit & E2E Testing"
    xpAmount={250}
    completionKey="partF_branchC_lesson5_complete"
    nextLessonUrl="/6. partF/branchC/lesson6_remake.html"
    hubUrl="/6. partF/hub.html"
    hubTitle="Level 7 Hub"
    hubIcon="🚀"
    fileTab="page.jsx"
    starterCode={starterCode}
    mode="html"
    jumpLessons={branchLessons}
    certificateUrl="/6. partF/certificate.html"
    trackPrefix="partF_branchC"
>
    <!-- Intro Slot -->
    <p class="lesson-subtitle" slot="intro">
        Write automated tests with Jest and React Testing Library to verify component rendering and state interactions.
    </p>

    <!-- Concept Slot (Left Pane) -->
    <div slot="concept" style="display: flex; flex-direction: column; gap: 16px;">
        
        <!-- Core Concept & Analogy -->
        <article class="concept-card">
            <h3><span>💡</span> Core Architecture &amp; Mental Model</h3>
            <div class="analogy-callout">
                <strong>Real-World Analogy:</strong> Automated tests are regression security cameras: constantly watching your codebase to verify that new changes never break existing features.
            </div>
        </article>

        
            <article class="concept-card">
                <h3><span>🧪</span> Testing Triad</h3>
                <div class="tag-demo">
                    <div class="tag-example">
                        <div class="tag-code">render(&lt;Component /&gt;)</div>
                        <div class="tag-result">Mounts virtual DOM instance</div>
                    </div>
                    <div class="tag-example">
                        <div class="tag-code">expect(...).toBeInTheDocument()</div>
                        <div class="tag-result">Asserts visual element existence</div>
                    </div>
                </div>
            </article>

        <!-- Working Reference Code & Target Result -->
        <article class="concept-card">
            <h3><span>💻</span> Reference Pattern</h3>
            <p style="color: #475569; font-size: 0.88rem; margin: 0 0 8px 0;">Production architecture specification:</p>
            <div class="code-snippet-box">
                <button class="snippet-copy-btn" type="button" aria-label="Copy code snippet">📋 Copy</button>
                <pre><code id="refCodeBox_branchC_5">import &#123; render, screen, fireEvent &#125; from '@testing-library/react';
import Counter from '../components/Counter';

test('increments count on click', () =&gt; &#123;
    render(&lt;Counter /&gt;);
    const button = screen.getByRole('button', &#123; name: /increment/i &#125;);
    fireEvent.click(button);
    expect(screen.getByText(/Count: 1/i)).toBeInTheDocument();
&#125;);</code></pre>
            </div>
        </article>

        <!-- Task Instructions Card -->
        <article class="concept-card" style="border-left: 4px solid #6366f1;">
            <h3><span>🎯</span> Milestone Requirements</h3>
            <p style="color: #475569; font-size: 0.90rem; line-height: 1.6; margin: 0 0 10px 0;">
                In the editor on the right pane:
            </p>
            <ol style="color: #334155; font-size: 0.90rem; line-height: 1.7; padding-left: 20px; margin: 0;">
                <li>Call <code>render(&lt;Counter /&gt;)</code>.</li>
                <li>Simulate event with <code>fireEvent.click(...)</code>.</li>
                <li>Assert expectation with <code>expect(...).toBeInTheDocument()</code>.</li>
            </ol>
        </article>

    </div>
</LessonLayout>

<!-- Client-Side Scripts & Verification Engine -->
<script>
    import { DojoEngine } from '../../../scripts/dojo';

    function initLesson() {
        const editor = document.getElementById('lessonEditor') as HTMLTextAreaElement | null;
        const lineNumbers = document.getElementById('ideLineNumbers');
        const lineNumbersInner = document.getElementById('ideLineNumbersInner') || lineNumbers;
        const terminalScreen = document.getElementById('terminalScreen');
        const previewIframe = document.getElementById('livePreviewIframe') as HTMLIFrameElement | null;
        const checkBtn = document.getElementById('checkAnswerBtn');
        const resetBtn = document.getElementById('resetEditorBtn');

        if (!editor) return;

        const DRAFT_KEY = 'novicodes_draft_partF_branchC_lesson5';
        const DEFAULT_STARTER = `// __tests__/Counter.test.jsx
// 🛠️ Practice Task: Write Component Tests with Jest & RTL

import { render, screen, fireEvent } from '@testing-library/react';
import Counter from '../components/Counter';

// Step 1: Write test('increments count on click', () => { ... })
// Render <Counter />
// Trigger fireEvent.click(button)
// Expect screen.getByText(/Count: 1/) to be in document
// Write test here:
`;

        // 1. Initialize Real-Time Conceptual Checklist
        DojoEngine.initChecklist([
                { id: 'render', label: 'Mount component with <code>render(&lt;Counter /&gt;)</code>', fn: (code) => { const c = code.replace(/\/\/[^\n]*/g, ''); return /render\s*\(\s*<Counter\s*\/>\s*\)/i.test(c); } },
                { id: 'click', label: 'Simulate click with <code>fireEvent.click(...)</code>', fn: (code) => { const c = code.replace(/\/\/[^\n]*/g, ''); return /fireEvent\.click\s*\(/i.test(c); } },
                { id: 'expect', label: 'Assert expectation with <code>expect(...)</code>', fn: (code) => { const c = code.replace(/\/\/[^\n]*/g, ''); return /expect\s*\([\s\S]*?\)\.toBeInTheDocument/i.test(c); } }
            ], {
            containerId: 'taskChecklist',
            submitBtnId: 'checkAnswerBtn',
            nextBtnId: 'nextLessonBtn',
            mode: 'html'
        });

        // 2. Line numbers & scroll sync
        function syncScroll() {
            if (lineNumbersInner && editor) {
                lineNumbersInner.style.transform = `translateY(-${editor.scrollTop}px)`;
            }
        }

        function updateEditor() {
            if (!editor || !lineNumbersInner) return;
            const lines = editor.value.split('\n');
            const lineCount = Math.max(lines.length, 1);
            lineNumbersInner.textContent = Array.from({ length: lineCount }, (_, i) => i + 1).join('\n');
            syncScroll();

                        // Jest & React Testing Library Simulated Test Runner
            if (previewIframe) {
                const rawCode = editor.value;
                const hasTest = /test\s*\(/i.test(rawCode);
                const hasRender = /render\s*\(/i.test(rawCode);
                const hasClick = /fireEvent\.click/i.test(rawCode);
                const hasExpect = /expect\s*\(/i.test(rawCode);

                const testsPassed = hasTest && hasRender && hasClick && hasExpect;

                const passHtml = '<div style="color: #4ade80; font-weight: bold;">PASS __tests__/Counter.test.jsx</div><div style="color: #22c55e; padding-left: 12px;">✓ increments count on click (14 ms)</div><div style="border-top: 1px solid #1e293b; margin-top: 12px; padding-top: 8px; color: #94a3b8;">Tests: <span style="color: #4ade80; font-weight: bold;">1 passed</span>, 1 total<br>Snapshots: 0 total<br>Time: 0.812 s</div>';
                const waitHtml = '<div style="color: #facc15;">WAITING: Write your test suite in the editor using test(), render(), fireEvent, and expect().</div><div style="color: #64748b; margin-top: 8px; font-size: 11px;">• test() declared: ' + (hasTest ? '✅ Yes' : '⏳ Pending') + '<br>• render(&lt;Counter /&gt;): ' + (hasRender ? '✅ Yes' : '⏳ Pending') + '<br>• fireEvent.click(): ' + (hasClick ? '✅ Yes' : '⏳ Pending') + '<br>• expect() assertion: ' + (hasExpect ? '✅ Yes' : '⏳ Pending') + '</div>';

                const htmlDoc = '<!DOCTYPE html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><script src="https://cdn.tailwindcss.com"><\/script><style>body { margin: 0; padding: 14px; font-family: monospace; background: #0f172a; color: #f8fafc; font-size: 12px; }</style></head><body><div style="background: #1e293b; border: 1px solid #334155; border-radius: 8px; padding: 8px 12px; margin-bottom: 12px; display: flex; align-items: center; gap: 8px;"><span style="color: #38bdf8; font-weight: 700;">JEST TEST RUNNER</span><span style="color: #94a3b8; font-size: 11px;">__tests__/Counter.test.jsx</span></div><div style="background: #090d16; border: 1px solid #1e293b; border-radius: 8px; padding: 14px; line-height: 1.6;"><div style="color: #94a3b8; margin-bottom: 8px;">$ jest --watchAll=false</div>' + (testsPassed ? passHtml : waitHtml) + '</div></body></html>';
                previewIframe.srcdoc = htmlDoc;
            }

            // Real-Time Checklist Verification
            DojoEngine.runChecklist(editor.value);
        }

        // 3. Draft Auto-Save & Crash Resilience
        DojoEngine.setupDraftPersistence(editor, DRAFT_KEY, DEFAULT_STARTER, updateEditor);

        editor.addEventListener('scroll', syncScroll);

        editor.addEventListener('keydown', (e) => {
            if (e.key === 'Tab') {
                e.preventDefault();
                const start = editor.selectionStart;
                const end = editor.selectionEnd;
                editor.value = editor.value.substring(0, start) + '  ' + editor.value.substring(end);
                editor.selectionStart = editor.selectionEnd = start + 2;
                updateEditor();
            }
        });

        // 4. Safe Reset Button Handler
        if (resetBtn) {
            DojoEngine.setupResetButton(resetBtn, editor, DRAFT_KEY, DEFAULT_STARTER, () => {
                updateEditor();
                if (terminalScreen) {
                    terminalScreen.innerHTML = '<div class="terminal-prompt" style="color: #94a3b8;">&gt; Terminal reset. Ready for input.</div>';
                }
            });
        }

        // 5. Terminal output simulation
        function simulateTerminal(code: string) {
            if (!terminalScreen) return;
            terminalScreen.innerHTML = `<div style="color: #34d399;">&gt; Executing milestone command stream...</div>
<div style="color: #f8fafc; font-family: monospace; font-size: 0.78rem; margin: 6px 0;">${code.replace(/\n/g, '<br/>')}</div>
<div style="color: #38bdf8; font-size: 0.76rem;">✓ [Command batch executed with exit code 0]</div>`;
        }

        // 6. Check & Verify Code Action
        if (checkBtn) {
            checkBtn.addEventListener('click', () => {
                const code = editor.value;

                if (DojoEngine.isEmpty(code)) {
                    DojoEngine.showLint('Your editor is empty! Complete the milestone tasks before verifying.', 'error', 'Follow the step-by-step instructions in the left pane.');
                    return;
                }

                simulateTerminal(code);

                const result = DojoEngine.runChecklist(code);

                if (result.allPassed) {
                    DojoEngine.clearLint();
                    
                    DojoEngine.celebrateCompletion({
                        lessonTitle: 'Milestone 05: Unit & E2E Testing',
                        xp: 250,
                        completionKey: 'partF_branchC_lesson5_complete',
                        nextUrl: '/6. partF/branchC/lesson6_remake.html',
                        customMessage: 'You have conquered this Level 7 Fullstack Milestone!'
                    });
                } else {
                    DojoEngine.showLint('Milestone criteria incomplete', 'warning', 'Check the task checklist below to see remaining requirements.');
                }
            });
        }

        // Initial render
        updateEditor();
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initLesson);
    } else {
        initLesson();
    }
</script>
