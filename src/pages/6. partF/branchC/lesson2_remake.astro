---
import LessonLayout from '../../../layouts/LessonLayout.astro';

const starterCode = `// ⚡ Lesson 2: Next.js Client Components with "use client"!

// 👉 STEP 1: Add "use client" directive at top of file

import React, { useState } from 'react';

export default function InteractiveCounter() {
  // 👉 STEP 2: Declare state [count, setCount] initialized to 0
  

  return (
    <div style={{ padding: '20px', fontFamily: 'sans-serif', textAlign: 'center' }}>
      <h2>⚡ Next.js Interactive Client Component</h2>
      {/* 👉 STEP 3: Render button with onClick={() => setCount(count + 1)} */}
      <button style={{ padding: '10px 20px', background: '#3b82f6', color: 'white', border: 'none', borderRadius: '8px', cursor: 'pointer', fontWeight: 600 }}>
        Count: 0
      </button>
    </div>
  );
}
`;

const branchLessons = [
    {
        "id": 1,
        "title": "Next.js App Router",
        "url": "/6. partF/branchC/lesson1_remake.html"
    },
    {
        "id": 2,
        "title": "Server & Client UI",
        "url": "/6. partF/branchC/lesson2_remake.html"
    },
    {
        "id": 3,
        "title": "Zustand Global State",
        "url": "/6. partF/branchC/lesson3_remake.html"
    },
    {
        "id": 4,
        "title": "Tailwind UI Architecture",
        "url": "/6. partF/branchC/lesson4_remake.html"
    },
    {
        "id": 5,
        "title": "Unit & E2E Testing",
        "url": "/6. partF/branchC/lesson5_remake.html"
    },
    {
        "id": 6,
        "title": "Production Capstone Service",
        "url": "/6. partF/branchC/lesson6_remake.html"
