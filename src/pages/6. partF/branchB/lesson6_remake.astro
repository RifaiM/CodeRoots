<LessonLayout
 title="Milestone 06: FastAPI RBAC Middleware | Level 7B • Backend & DB"
 description="Enforce Role-Based Access Control (RBAC) on API routes using FastAPI dependency injection and JWT verification."
 levelTag="Level 7B • Backend & DB"
 lessonNum={6}
 lessonTitle="FastAPI RBAC Middleware"
 xpAmount={250}
 completionKey="partF_branchB_lesson6_complete"
 nextLessonUrl="/6. partF/certificate.html"
 hubUrl="/6. partF/hub.html"
 hubTitle="Level 7 Hub"
 hubIcon=""
 fileTab="server.py"
 starterCode={starterCode}
 mode="python"
 jumpLessons={branchLessons}
 certificateUrl="/6. partF/certificate.html"
 trackPrefix="partF_branchB"
>
 <!-- Intro Slot -->
 <p class="lesson-subtitle" slot="intro">
 Build secure authentication dependencies with OAuth2PasswordBearer and role-based access control (RBAC) in FastAPI.
 </p>

 <!-- Concept Slot (Left Pane) -->
 <div slot="concept" style="display: flex; flex-direction: column; gap: 16px;">
 
 <!-- PROGATE-STYLE TOP MISSION CARD: Immediately informs learner what to do -->
