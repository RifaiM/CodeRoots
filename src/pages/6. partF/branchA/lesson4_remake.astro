---

<LessonLayout
    title="Milestone 04: Render & Fly.io Deploy | Level 7A • Cloud & DevOps"
    description="Configure Python backend hosting manifests using render.yaml Infrastructure-as-Code files."
    levelTag="Level 7A • Cloud & DevOps"
    lessonNum={4}
    lessonTitle="Render & Fly.io Deploy"
    xpAmount={250}
    completionKey="partF_branchA_lesson4_complete"
    nextLessonUrl="/6. partF/branchA/lesson5_remake.html"
    hubUrl="/6. partF/hub.html"
    hubTitle="Level 7 Hub"
    hubIcon="🚀"
    fileTab="terminal.sh"
    starterCode={starterCode}
    mode="terminal"
    jumpLessons={branchLessons}
    certificateUrl="/6. partF/certificate.html"
    trackPrefix="partF_branchA"
>
    <!-- Intro Slot -->
    <p class="lesson-subtitle" slot="intro">
        Write render.yaml infrastructure-as-code manifests, configure Uvicorn start commands, and define environment variables.
    </p>

    <!-- Concept Slot (Left Pane) -->
    <div slot="concept" style="display: flex; flex-direction: column; gap: 16px;">
        
        <!-- 🎯 PROGATE-STYLE TOP MISSION CARD: Immediately informs learner what to do -->
        <!-- Unified Mission Card -->
        <article class="concept-card mission-card">
            <div class="mission-header">
                <h3><span>🎯</span> Your Mission</h3>
                <span class="checklist-counter" id="checklistCounter">0 / 2</span>
            </div>
            <div class="target-output-preview" style="background: #f1f5f9; border-radius: 8px; padding: 10px 12px; margin: 8px 0 12px 0; border: 1px dashed #94a3b8; font-size: 0.82rem;">
                <strong style="color: #334155;">🖼️ Target Goal:</strong>
                <div style="color: #475569; margin-top: 3px;">Terminal Output: <code>&gt; [Render Spec] Web service 'novicodes-api' ➔ Uvicorn server initialized on port 8000!</code></div>
            </div>
            <p class="mission-subtitle">Follow the step-by-step instructions below in the editor:</p>
            <div id="taskChecklist"></div>
        </article>
        
        <!-- Core Concept & Analogy -->
        <article class="concept-card">
            <h3><span>💡</span> Core Architecture &amp; Mental Model</h3>
            <div class="analogy-callout">
                <strong>Real-World Analogy:</strong> A <code>render.yaml</code> file is like an automated instruction manual for a cloud robot 🤖: it tells the server how to install dependencies and turn on the server.
            </div>
        </article>

        
            <article class="concept-card">
                <h3><span>🚀</span> ASGI Server Launch Spec</h3>
                <div class="tag-demo">
                    <div class="tag-example">
                        <div class="tag-code">pip install -r requirements.txt</div>
                        <div class="tag-result">Build command: installs FastAPI &amp; dependencies</div>
                    </div>
                    <div class="tag-example">
                        <div class="tag-code">uvicorn main:app --port $PORT</div>
                        <div class="tag-result">Start command: binds server to dynamic cloud port</div>
                    </div>
                </div>
            </article>

        <!-- Working Reference Code & Target Result -->
        <article class="concept-card">
            <h3><span>💻</span> Reference Pattern</h3>
            <p style="color: #475569; font-size: 0.88rem; margin: 0 0 8px 0;">Production architecture specification:</p>
            <div class="code-snippet-box">
                <button class="snippet-copy-btn" type="button" aria-label="Copy code snippet">📋 Copy</button>
                <pre><code id="refCodeBox_branchA_4">services:
  - type: web
    name: novicodes-backend-api
    env: python
    buildCommand: pip install -r requirements.txt
    startCommand: uvicorn main:app --host 0.0.0.0 --port $PORT
    region: singapore</code></pre>
            </div>
        </article>

        

    </div>
</LessonLayout>

<!-- Client-Side Scripts & Verification Engine -->
<script>
    import { DojoEngine } from '../../../scripts/dojo';

    function initLesson() {
        const editor = document.getElementById('lessonEditor') as HTMLTextAreaElement | null;
        const lineNumbers = document.getElementById('ideLineNumbers');
        const lineNumbersInner = document.getElementById('ideLineNumbersInner') || lineNumbers;
        const terminalScreen = document.getElementById('terminalScreen');
        const previewIframe = document.getElementById('livePreviewIframe') as HTMLIFrameElement | null;
        const checkBtn = document.getElementById('checkAnswerBtn');
        const resetBtn = document.getElementById('resetEditorBtn');

        if (!editor) return;

        const DRAFT_KEY = 'novicodes_draft_partF_branchA_lesson4';
        const DEFAULT_STARTER = `# ☁️ Lesson 4: Render Backend Service Spec!
services:
  - type: web
    name: novicodes-api
    env: python
    # 👉 STEP 1: Set buildCommand: pip install -r requirements.txt
    buildCommand: 

    # 👉 STEP 2: Set startCommand: uvicorn main:app --host 0.0.0.0 --port 8000
    startCommand: 
`;

        // 1. Initialize Real-Time Conceptual Checklist
        DojoEngine.initChecklist([
            { id: 'buildcmd', label: 'Set <code>buildCommand: pip install -r requirements.txt</code>', fn: (code) => { const c = code.replace(/#[^\n]*/g, ''); return /buildCommand\s*:\s*pip\s+install\s+-r\s+requirements\.txt/i.test(c); } },
            { id: 'startcmd', label: 'Set <code>startCommand: uvicorn main:app ...</code>', fn: (code) => { const c = code.replace(/#[^\n]*/g, ''); return /startCommand\s*:\s*uvicorn\s+main:app/i.test(c); } }
        ], {
            containerId: 'taskChecklist',
            mode: 'terminal'
        });

        // 2. Line numbers & scroll sync
        function syncScroll() {
            if (lineNumbersInner && editor) {
                lineNumbersInner.style.transform = `translateY(-${editor.scrollTop}px)`;
            }
        }

        function updateEditor() {
            if (!editor || !lineNumbersInner) return;
            const lines = editor.value.split('\n');
            const lineCount = Math.max(lines.length, 1);
            lineNumbersInner.textContent = Array.from({ length: lineCount }, (_, i) => i + 1).join('\n');
            syncScroll();

            // Preview update if HTML mode
            if (previewIframe) {
                previewIframe.srcdoc = `<!DOCTYPE html><html><body style="font-family:sans-serif;padding:16px;">${editor.value}</body></html>`;
            }

            // Real-Time Checklist Verification
            // Real-Time Syntax & Diagnostics
            DojoEngine.lint(editor.value, 'terminal');

            // Real-Time Checklist Verification
            DojoEngine.runChecklist(editor.value);
        }

        // 3. Draft Auto-Save & Crash Resilience
        DojoEngine.setupDraftPersistence(editor, DRAFT_KEY, DEFAULT_STARTER, updateEditor);

        editor.addEventListener('scroll', syncScroll);

        editor.addEventListener('keydown', (e) => {
            if (e.key === 'Tab') {
                e.preventDefault();
                const start = editor.selectionStart;
                const end = editor.selectionEnd;
                editor.value = editor.value.substring(0, start) + '  ' + editor.value.substring(end);
                editor.selectionStart = editor.selectionEnd = start + 2;
                updateEditor();
            }
        });

        // 4. Safe Reset Button Handler
        if (resetBtn) {
            DojoEngine.setupResetButton(resetBtn, editor, DRAFT_KEY, DEFAULT_STARTER, () => {
                updateEditor();
                if (terminalScreen) {
                    terminalScreen.innerHTML = '<div class="terminal-prompt" style="color: #94a3b8;">&gt; Terminal reset. Ready for input.</div>';
                }
            });
        }

        // 5. Terminal output simulation
        function simulateTerminal(code: string) {
            if (!terminalScreen) return;
            terminalScreen.innerHTML = `<div style="color: #34d399;">&gt; Executing milestone command stream...</div>
<div style="color: #f8fafc; font-family: monospace; font-size: 0.78rem; margin: 6px 0;">${code.replace(/\n/g, '<br/>')}</div>
<div style="color: #38bdf8; font-size: 0.76rem;">✓ [Command batch executed with exit code 0]</div>`;
        }

        // 6. Check & Verify Code Action with Intelligent Diagnostics
        if (checkBtn) {
            checkBtn.addEventListener('click', () => {
                if (typeof simulateTerminal === 'function') {
                    simulateTerminal(editor.value);
                }
                DojoEngine.verifySubmission(editor.value, {
                    lessonTitle: 'Render & Fly.io Deploy',
                    xp: 250,
                    completionKey: 'partF_branchA_lesson4_complete',
                    nextUrl: '/6. partF/branchA/lesson5_remake.html',
                    mode: 'terminal'
                });
            });
        }

        // Initial render
        updateEditor();
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initLesson);
    } else {
        initLesson();
    }
</script>
