---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PlatformHeader from '../../components/PlatformHeader.astro';
import Icon from '../../components/Icon.astro';
import PlatformFooter from '../../components/PlatformFooter.astro';

const navLinks = [
    { href: '/', label: 'Roadmap', iconName: 'map', title: 'Curriculum Roadmap' },
    { href: '/1. partA/hub.html', label: 'Foundations', iconName: 'book-open', title: 'Foundations Academy' },
    { href: 'javascript:void(0)', label: 'Dojo', iconName: 'swords', title: 'Practical Dojo Hub', id: 'dojoNavLink', extraClass: 'dojo-nav-highlight', onClick: 'openDojoHub()' },
    { href: 'javascript:void(0)', label: 'Certs', iconName: 'certificate', title: 'Proof-of-Work Certificates', id: 'certificateNavLink', onClick: 'openCertificateHub()' }
];
---

<BaseLayout 
	title="Level 7: Specialized Web Tracks (40 Projects) | NoviCodes" 
	description="Specialize in Cloud Hosting configs (Vercel/Render), SQL database schemas (PostgreSQL), Next.js App Router UI, TypeScript Type-Safety, and CSS Motion across 40 focused coding lessons."
	showHeaderFooter={false}
>
	<!-- Top Global Header -->
	<PlatformHeader 
		slot="header"
		tagText="Specialization"
		tagId="headerLogoTag"
		navLinks={navLinks}
		showXpBadge={true}
		showLevelBadge={true}
	/>

	<main class="hub-container">
		<!-- Hero Banner -->
		<section class="hub-hero">
			<span class="level7-badge"><Icon name="rocket" size={14} /> Level 7 • Specialized Developer Tracks</span>
			<h1>Choose Your <span class="typewriter-wrap"><span class="typewriter-text" data-phrases='["Specialized Developer Track", "CSS Animations & Micro-Interactions", "TypeScript & Type-Safe Code", "Next.js App Router Architecture", "Cloud Hosting & CI/CD Pipelines", "SQL Databases & Relational Queries"]' aria-label="Specialized Developer Track">Specialized Developer Track</span><span class="typewriter-cursor" aria-hidden="true">|</span></span></h1>
			<p>
				Pick the track you want to explore next: CSS Animations &amp; Micro-Interactions, TypeScript Mastery, Cloud Hosting &amp; CI/CD Pipelines, SQL Databases, or Modern Next.js Web Apps. Complete any track to earn your Level 7 Certificate!
			</p>
			<div class="hub-stats-row">
				<span class="stat-pill"><Icon name="cloud" size={13} /> Track 7A: Cloud Hosting (1,500 XP)</span>
				<span class="stat-pill"><Icon name="database" size={13} /> Track 7B: SQL Databases (1,500 XP)</span>
				<span class="stat-pill"><Icon name="nextjs" size={13} /> Track 7C: Next.js Apps (1,500 XP)</span>
				<span class="stat-pill"><Icon name="variable" size={13} /> Track 7D: TypeScript (1,800 XP)</span>
				<span class="stat-pill"><Icon name="pulse" size={13} /> Track 7E: CSS Motion (1,500 XP)</span>
			</div>
		</section>

		<!-- Branch Selector Grid -->
		<section class="branch-grid">
			
			<!-- Branch 7A: Cloud Shipping & DevOps -->
			<article class="branch-card card-cloud">
				<div>
					<div class="branch-card-header">
						<div class="branch-icon-box"><Icon name="cloud" size={24} color="#8b5cf6" /></div>
						<span class="branch-tag">Track 7A</span>
					</div>
					<h2 class="branch-title">Cloud Hosting &amp; CI/CD Pipelines</h2>
					<p class="branch-desc">
						Master Git workflows and write cloud hosting configuration manifests for Vercel, Cloudflare Pages, Netlify, and Render.
					</p>
					<div class="branch-meta-list">
						<span class="branch-meta-item"><Icon name="network" size={12} /> Git / GitHub</span>
						<span class="branch-meta-item"><Icon name="cloud" size={12} /> Vercel &amp; Netlify</span>
						<span class="branch-meta-item"><Icon name="globe" size={12} /> Cloudflare Pages</span>
						<span class="branch-meta-item"><Icon name="server" size={12} /> Render API</span>
						<span class="branch-meta-item"><Icon name="zap" size={12} /> CI/CD</span>
					</div>

					<!-- 6-Lesson Syllabus List -->
					<div class="branch-syllabus-wrap">
						<div class="syllabus-heading">
							<span>Syllabus (6 Lessons)</span>
							<span>+1,500 XP</span>
						</div>
						<div class="syllabus-list">
							<a href="/6. partF/branchA/lesson1_remake.html" class="syllabus-item" id="item7A_1">
								<div class="syllabus-item-left">
									<span class="syllabus-idx">01</span>
									<span class="syllabus-name">Git &amp; GitHub Workflow</span>
								</div>
								<span class="syllabus-status" id="stat7A_1">UP NEXT</span>
							</a>
