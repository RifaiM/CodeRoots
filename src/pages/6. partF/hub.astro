								<div class="syllabus-item-left">
									<span class="syllabus-idx">02</span>
									<span class="syllabus-name">Vercel &amp; Netlify Deployments</span>
								</div>
								<span class="syllabus-status" id="stat7A_2">LOCKED</span>
							</a>
							<a href="/6. partF/branchA/lesson3_remake.html" class="syllabus-item locked" id="item7A_3">
