---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PlatformHeader from '../../components/PlatformHeader.astro';
import Icon from '../../components/Icon.astro';
import PlatformFooter from '../../components/PlatformFooter.astro';

const navLinks = [
    { href: '/', label: 'Roadmap', iconName: 'map', title: 'Curriculum Roadmap' },
    { href: '/1. partA/hub.html', label: 'Foundations', iconName: 'book-open', title: 'Foundations Academy' },
    { href: 'javascript:void(0)', label: 'Dojo', iconName: 'swords', title: 'Practical Dojo Hub', id: 'dojoNavLink', extraClass: 'dojo-nav-highlight', onClick: 'openDojoHub()' },
    { href: 'javascript:void(0)', label: 'Certs', iconName: 'certificate', title: 'Proof-of-Work Certificates', id: 'certificateNavLink', onClick: 'openCertificateHub()' }
];
---

<BaseLayout
 title="Level 7: Specialized Web Tracks (18 Projects) | NoviCodes"
 description="Specialize in Cloud Hosting configs (Vercel/Render), SQL database schemas (PostgreSQL), and Next.js App Router UI across 18 focused coding lessons."
 showHeaderFooter={false}
>
 <!-- Top Global Header -->
 <PlatformHeader 
 slot="header"
 tagText="Specialization"
 tagId="headerLogoTag"
 navLinks={navLinks}
 showXpBadge={true}
 showLevelBadge={true}
 />

 <main class="hub-container">
 <!-- Hero Banner -->
 <section class="hub-hero">
 <span class="level7-badge">Level 7 • Specialized Developer Tracks</span>
 <h1>Choose Your <span class="typewriter-wrap theme-purple"><span class="typewriter-text" data-phrases='["Specialized Developer Track", "CSS Animations & Micro-Interactions", "TypeScript & Type-Safe Code", "Next.js App Router Architecture", "Cloud Hosting & CI/CD Pipelines", "SQL Databases & Relational Queries"]' aria-label="Specialized Developer Track">Specialized Developer Track</span><span class="typewriter-cursor" aria-hidden="true">|</span></span></h1>
 <p>
 Pick the track you want to explore next: CSS Animations &amp; Micro-Interactions, TypeScript Mastery, Cloud Hosting &amp; CI/CD Pipelines, SQL Databases, or Modern Next.js Web Apps. Complete any track to earn your Level 7 Certificate!
 </p>
 <div class="hub-stats-row">
 <span class="stat-pill">Track 7A: Cloud Hosting (1,500 XP)</span>
 <span class="stat-pill">Track 7B: SQL Databases (1,500 XP)</span>
 <span class="stat-pill">Track 7C: Next.js Apps (1,500 XP)</span>
 <span class="stat-pill">Track 7D: TypeScript (1,800 XP)</span>
 <span class="stat-pill">Track 7E: CSS Motion (1,500 XP)</span>
 </div>
 </section>

 <!-- Branch Selector Grid -->
 <section class="branch-grid">
 
 <!-- Branch 7A: Cloud Shipping & DevOps -->
 <article class="branch-card card-cloud">
 <div>
 <div class="branch-card-header">
 <div class="branch-icon-box"><Icon name="pulse" size={24} color="#ec4899" /></div>
 <span class="branch-tag">Track 7E</span>
 </div>
 <h2 class="branch-title">CSS Animations &amp; Micro-Interactions</h2>
 <p class="branch-desc">
 Craft fluid, hardware-accelerated web experiences. Master transitions, 2D GPU transforms, keyframes, spring physics, tactile buttons, skeleton shimmers, and SVG path drawing.
 </p>
 <div class="branch-meta-list">
 <span class="branch-meta-item">GPU Transforms</span>
 <span class="branch-meta-item">@keyframes</span>
 <span class="branch-meta-item">Spring Physics</span>
 <span class="branch-meta-item">Micro-Interactions</span>
 <span class="branch-meta-item">prefers-reduced-motion</span>
 </div>

 <!-- 10-Lesson Syllabus List -->
 <div class="branch-syllabus-wrap">
 <div class="syllabus-heading">
 <span>Syllabus (10 Lessons)</span>
 <span>+1,500 XP</span>
 </div>
 <div class="syllabus-list">
 <a href="/6. partF/branchE/lesson1_remake.html" class="syllabus-item" id="item7E_1">
 <div class="syllabus-item-left">
 <span class="syllabus-idx">01</span>
 <span class="syllabus-name">Transitions 101 &amp; Easing</span>
 </div>
 <span class="syllabus-status" id="stat7E_1">UP NEXT</span>
 </a>
 <a href="/6. partF/branchE/lesson2_remake.html" class="syllabus-item locked" id="item7E_2">
 <div class="syllabus-item-left">
 <span class="syllabus-idx">02</span>
 <span class="syllabus-name">GPU 2D Transforms</span>
 </div>
 <span class="syllabus-status" id="stat7E_2">LOCKED</span>
 </a>
 <a href="/6. partF/branchE/lesson3_remake.html" class="syllabus-item locked" id="item7E_3">
 <div class="syllabus-item-left">
 <span class="syllabus-idx">03</span>
 <span class="syllabus-name">CSS Keyframes (@keyframes)</span>
 </div>
 <span class="syllabus-status" id="stat7E_3">LOCKED</span>
 </a>
 <a href="/6. partF/branchE/lesson4_remake.html" class="syllabus-item locked" id="item7E_4">
 <div class="syllabus-item-left">
 <span class="syllabus-idx">04</span>
 <span class="syllabus-name">Cubic-Bézier Spring Physics</span>
 </div>
 <span class="syllabus-status" id="stat7E_4">LOCKED</span>
 </a>
 <a href="/6. partF/branchE/lesson5_remake.html" class="syllabus-item locked" id="item7E_5">
 <div class="syllabus-item-left">
 <span class="syllabus-idx">05</span>
 <span class="syllabus-name">Tactile Hover &amp; Active Clicks</span>
 </div>
 <span class="syllabus-status" id="stat7E_5">LOCKED</span>
 </a>
 <a href="/6. partF/branchE/lesson6_remake.html" class="syllabus-item locked" id="item7E_6">
 <div class="syllabus-item-left">
 <span class="syllabus-idx">06</span>
 <span class="syllabus-name">Animated Skeletons &amp; Shimmer</span>
 </div>
 <span class="syllabus-status" id="stat7E_6">LOCKED</span>
 </a>
 <a href="/6. partF/branchE/lesson7_remake.html" class="syllabus-item locked" id="item7E_7">
 <div class="syllabus-item-left">
 <span class="syllabus-idx">07</span>
 <span class="syllabus-name">Staggered Entrance Cascades</span>
 </div>
 <span class="syllabus-status" id="stat7E_7">LOCKED</span>
 </a>
 <a href="/6. partF/branchE/lesson8_remake.html" class="syllabus-item locked" id="item7E_8">
 <div class="syllabus-item-left">
 <span class="syllabus-idx">08</span>
 <span class="syllabus-name">SVG Path Drawing Animations</span>
 </div>
 <span class="syllabus-status" id="stat7E_8">LOCKED</span>
 </a>
 <a href="/6. partF/branchE/lesson9_remake.html" class="syllabus-item locked" id="item7E_9">
 <div class="syllabus-item-left">
 <span class="syllabus-idx">09</span>
 <span class="syllabus-name">prefers-reduced-motion A11y</span>
 </div>
 <span class="syllabus-status" id="stat7E_9">LOCKED</span>
 </a>
 <a href="/6. partF/branchE/lesson10_remake.html" class="syllabus-item locked" id="item7E_10">
 <div class="syllabus-item-left">
 <span class="syllabus-idx">10</span>
 <span class="syllabus-name">Final Project: Interactive Motion Showcase</span>
 </div>
 <span class="syllabus-status" id="stat7E_10">LOCKED</span>
 </a>
 </div>
 </div>
 </div>

 <div class="branch-footer">
 <div class="branch-progress-bar">
 <div class="branch-progress-fill" id="fillBranch7E"></div>
 </div>
 <a href="/6. partF/branchE/lesson1_remake.html" class="branch-btn" id="btnBranch7E">
 <span>Launch Track 7E (Lesson 1/10) →</span>
 </a>
 </div>
 </article>

 </section>
 </main>

 <!-- Platform Footer -->
 <PlatformFooter />

 <!-- Universal Back to Top Floating Action Button -->
 <button class="back-to-top-btn" id="backToTopBtn" aria-label="Back to Top">
 <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
 <polyline points="18 15 12 9 6 15"></polyline>
 </svg>
 </button>

 <!-- Stylesheet -->
 <link rel="stylesheet" href="/6. partF/hub.css" />

 <!-- JavaScript Engines -->
 <script is:inline src="/scripts/dashboard.js"></script>
 <script is:inline src="/6. partF/hub.js"></script>
</BaseLayout>
