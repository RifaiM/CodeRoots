    },
    {
        "id": 6,
        "title": "DOM Elements & Null Narrowing",
        "url": "/6. partF/branchD/lesson6_remake.html"
    },
    {
        "id": 7,
        "title": "Typed Event Handlers & Casting",
        "url": "/6. partF/branchD/lesson7_remake.html"
    },
    {
        "id": 8,
        "title": "Discriminated Unions & Reducers",
        "url": "/6. partF/branchD/lesson8_remake.html"
