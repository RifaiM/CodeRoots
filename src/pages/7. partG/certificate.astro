---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PlatformHeader from '../../components/PlatformHeader.astro';
import PlatformFooter from '../../components/PlatformFooter.astro';

const navLinks = [
    { href: '/', label: 'Dashboard', icon: '🏠', title: 'Dashboard Home' },
    { href: '/7. partG/hub.html', label: 'Level 8 Hub', icon: '🌉', title: 'Level 8 Hub' }
];
---

<BaseLayout 
    title="Level 8 Certificate: Fullstack API Integration | CodeRoots" 
    description="Claim your verified Certificate of Mastery in Fullstack API Data Fetching, Optimistic UI, and Microservice Integration."
    showHeaderFooter={false}
>
    <PlatformHeader 
        slot="header"
        tagText="Level 8 • Certificate"
        tagId="headerLogoTag"
        navLinks={navLinks}
        showXpBadge={true}
        showLevelBadge={true}
    />

    <main class="cert-page-container">
        <div class="cert-container">
            <section class="generator-card">
                <div class="generator-header">
                    <h2>🎓 Level 8 Certificate Generator</h2>
                    <p>Enter your full legal name or developer alias to generate your verified credential in Fullstack API &amp; State Integration.</p>
                </div>

                <div class="generator-inputs">
                    <div class="input-group">
                        <label for="learnerNameInput">Full Legal Name / Developer Alias:</label>
                        <input type="text" id="learnerNameInput" placeholder="e.g. Alex Rivera" value="Fullstack Engineer" />
                    </div>
                    <div class="btn-row">
                        <button class="cert-action-btn primary" id="generateCertBtn">
                            <span>✨ Update Certificate</span>
                        </button>
                        <button class="cert-action-btn success" id="downloadCertBtn">
                            <span>📥 Download High-Res PNG</span>
                        </button>
                        <button class="cert-action-btn secondary" id="printCertBtn" onclick="window.print()">
                            <span>🖨️ Print / PDF</span>
                        </button>
                    </div>
                </div>
            </section>

            <!-- Live Printable Certificate Canvas -->
            <section class="certificate-frame-wrap">
                <div class="cert-canvas" id="certCanvas">
                    <div class="cert-border">
                        <div class="cert-inner-content">
                            <div class="cert-top-badge">
                                <span class="badge-icon">🏛️</span>
                                <span class="badge-text">CODEROOTS ACCREDITED CERTIFICATION</span>
                            </div>
                            <h1 class="cert-main-title">Certificate of Fullstack Mastery</h1>
                            <p class="cert-award-text">This official credential certifies that</p>
                            <h2 class="cert-recipient-name" id="certRecipientName">Fullstack Engineer</h2>
                            <p class="cert-description-text">
                                has demonstrated verified hands-on competence in <strong>Level 8: Fullstack API &amp; Client Integration</strong>, mastering Asynchronous Data Fetching, Loading Skeletons, HTTP Error Boundaries, Optimistic State Mutations, and Microservice Integration.
                            </p>
                            <div class="cert-footer-meta">
                                <div class="meta-col">
                                    <span class="meta-label">ISSUED BY</span>
                                    <span class="meta-val">CodeRoots Dojo</span>
                                </div>
                                <div class="meta-col">
                                    <span class="meta-label">DATE ISSUED</span>
                                    <span class="meta-val" id="certDateVal">August 2026</span>
                                </div>
                                <div class="meta-col">
                                    <span class="meta-label">VERIFICATION ID</span>
                                    <span class="meta-val font-mono" id="certIdVal">CR-L8-9831</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </div>
    </main>

    <PlatformFooter />
</BaseLayout>

<script>
    function initCert() {
        const nameInput = document.getElementById('learnerNameInput') as HTMLInputElement | null;
        const nameDisplay = document.getElementById('certRecipientName');
        const updateBtn = document.getElementById('generateCertBtn');
        const dateVal = document.getElementById('certDateVal');
        const idVal = document.getElementById('certIdVal');

        if (dateVal) {
            const d = new Date();
            dateVal.textContent = d.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
        }

        if (idVal) {
            const rand = Math.floor(1000 + Math.random() * 9000);
            idVal.textContent = `CR-L8-${rand}`;
        }

        if (updateBtn && nameInput && nameDisplay) {
            updateBtn.addEventListener('click', () => {
                nameDisplay.textContent = nameInput.value.trim() || 'Fullstack Engineer';
            });
        }
    }

    document.addEventListener('DOMContentLoaded', initCert);
    initCert();
</script>

<style>
    .cert-page-container { max-width: 1040px; margin: 0 auto; padding: 32px 20px 80px; }
    .generator-card { background: #ffffff; border: 1.5px solid #e2e8f0; border-radius: 20px; padding: 28px; margin-bottom: 32px; }
    .generator-header h2 { font-size: 1.5rem; font-weight: 800; color: #0f172a; margin: 0 0 6px; }
    .generator-header p { font-size: 0.95rem; color: #64748b; margin: 0 0 20px; }
    .input-group label { display: block; font-size: 0.85rem; font-weight: 700; color: #334155; margin-bottom: 6px; }
    .input-group input { width: 100%; max-width: 420px; padding: 10px 14px; border: 1.5px solid #cbd5e1; border-radius: 10px; font-size: 1rem; font-family: inherit; margin-bottom: 16px; box-sizing: border-box; }
    .btn-row { display: flex; gap: 12px; flex-wrap: wrap; }
    .cert-action-btn { padding: 10px 20px; border-radius: 10px; font-weight: 700; font-size: 0.92rem; border: none; cursor: pointer; transition: all 0.2s; }
    .cert-action-btn.primary { background: #0284c7; color: white; }
    .cert-action-btn.success { background: #10b981; color: white; }
    .cert-action-btn.secondary { background: #f1f5f9; color: #334155; border: 1px solid #cbd5e1; }
    .certificate-frame-wrap { background: #f8fafc; padding: 24px; border-radius: 20px; border: 1px solid #e2e8f0; display: flex; justify-content: center; }
    .cert-canvas { width: 100%; max-width: 860px; background: #ffffff; border-radius: 16px; padding: 24px; box-shadow: 0 16px 40px rgba(0,0,0,0.06); }
    .cert-border { border: 3px solid #0284c7; border-radius: 12px; padding: 36px 28px; background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%); text-align: center; }
    .cert-top-badge { display: inline-flex; align-items: center; gap: 6px; font-size: 0.76rem; font-weight: 800; color: #0284c7; letter-spacing: 1px; margin-bottom: 16px; }
    .cert-main-title { font-size: 1.9rem; font-weight: 900; color: #0f172a; margin: 0 0 10px; text-transform: uppercase; letter-spacing: 0.5px; }
    .cert-award-text { font-size: 0.95rem; color: #64748b; margin: 0 0 12px; font-style: italic; }
    .cert-recipient-name { font-size: 2.2rem; font-weight: 900; color: #0284c7; margin: 0 0 16px; text-decoration: underline; text-underline-offset: 6px; }
    .cert-description-text { font-size: 0.95rem; color: #334155; max-width: 620px; margin: 0 auto 32px; line-height: 1.6; }
    .cert-footer-meta { display: flex; justify-content: space-around; border-top: 1px solid #e2e8f0; padding-top: 20px; }
    .meta-col { display: flex; flex-direction: column; }
    .meta-label { font-size: 0.72rem; font-weight: 800; color: #94a3b8; letter-spacing: 0.5px; }
    .meta-val { font-size: 0.90rem; font-weight: 700; color: #0f172a; margin-top: 2px; }
    .font-mono { font-family: monospace; }
</style>
