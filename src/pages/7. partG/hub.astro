---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PlatformHeader from '../../components/PlatformHeader.astro';
import PlatformFooter from '../../components/PlatformFooter.astro';

const navLinks = [
    { href: '/', label: 'Dashboard', icon: '🏠', title: 'Dashboard Home' },
    { href: '/1. partA/hub.html', label: 'Foundations', icon: '📚', title: 'Foundations Academy' },
    { href: 'javascript:void(0)', label: 'Practical Dojo', icon: '⚔️', title: 'Practical Dojo Hub', active: true, extraClass: 'dojo-nav-highlight', onClick: 'openDojoHub()' }
];
---

<BaseLayout
    title="Fullstack API & Client Integration (Level 8) | CodeRoots"
    description="Bridge frontend UIs with backend microservices across 6 interactive fullstack integration lessons."
    showHeaderFooter={false}
>
    <PlatformHeader 
        slot="header"
        tagText="Level 8 • Fullstack Bridge"
        tagId="headerLogoTag"
        navLinks={navLinks}
        showXpBadge={true}
        showLevelBadge={true}
    />

    <main class="hub-container">
        <!-- Hero Section -->
        <section class="hub-hero">
            <span class="hub-badge" style="background: linear-gradient(135deg, #0284c7, #0369a1); color: white;">🌉 Level 8 • Fullstack API & State Bridge</span>
            <h1>Connect Reactive Frontends with Backend APIs</h1>
            <p>
                Bridge the gap between frontend user interfaces and backend microservices. Master asynchronous data fetching, loading skeletons, error boundaries, optimistic UI updates, and real-time polling across 6 hands-on integration projects!
            </p>

            <!-- Live Progress Bar -->
            <div class="hero-progress-wrap">
                <div class="hero-progress-info">
                    <span>Course Progress</span>
                    <span id="heroProgressText">0 of 6 Projects Completed (0%)</span>
                </div>
                <div class="hero-progress-bar">
                    <div class="hero-progress-fill" id="heroProgressFill"></div>
                </div>
            </div>

            <!-- Smart Resume CTA -->
            <a href="/7. partG/lesson1/lesson1_remake.html" class="hero-cta-btn" id="heroResumeBtn">
                <span>🚀 Start Lesson 1: Async Data Fetching ➔</span>
            </a>
        </section>

        <!-- Stats Overview Row -->
        <section class="hub-stats-grid">
            <div class="hub-stat-card">
                <div class="hub-stat-val">1,500 XP</div>
                <div class="hub-stat-lbl">Total XP Bounty</div>
            </div>
            <div class="hub-stat-card">
                <div class="hub-stat-val" id="statCompletedProjects">0 / 6</div>
                <div class="hub-stat-lbl">Projects Built</div>
            </div>
            <div class="hub-stat-card">
                <div class="hub-stat-val">React + FastAPI</div>
                <div class="hub-stat-lbl">Integration Stack</div>
            </div>
            <div class="hub-stat-card">
                <div class="hub-stat-val">API Specialist</div>
                <div class="hub-stat-lbl">Official Certificate</div>
            </div>
        </section>

        <!-- Curriculum Breakdown -->
        <section class="curriculum-section">
            <div class="chapter-block">
                <div class="chapter-header">
                    <div class="chapter-title-wrap">
                        <span class="chapter-num">Fullstack Track</span>
                        <h2 class="chapter-title">Frontend &amp; API State Integration</h2>
                    </div>
                    <span class="chapter-badge">Lessons 1–6 • 1,500 XP</span>
                </div>

                <div class="lesson-cards-grid">
                    
                    <a href="/7. partG/lesson1/lesson1_remake.html" class="lesson-card locked" id="lessonCard1">
                        <div class="card-top">
                            <span class="lesson-idx">PROJECT 01</span>
                            <span class="lesson-status-pill locked" id="statusPill1">🔒 Locked</span>
                        </div>
                        <h3 class="lesson-card-title">Async Data Fetching & Skeletons</h3>
                        <div class="card-bottom">
                            <span class="xp-tag">⚡ +250 XP</span>
                            <span class="card-action-text" id="actionText1">Locked</span>
                        </div>
                    </a>
                    <a href="/7. partG/lesson2/lesson2_remake.html" class="lesson-card locked" id="lessonCard2">
                        <div class="card-top">
                            <span class="lesson-idx">PROJECT 02</span>
                            <span class="lesson-status-pill locked" id="statusPill2">🔒 Locked</span>
                        </div>
                        <h3 class="lesson-card-title">Error Boundaries & HTTP Fallbacks</h3>
                        <div class="card-bottom">
                            <span class="xp-tag">⚡ +250 XP</span>
                            <span class="card-action-text" id="actionText2">Locked</span>
                        </div>
                    </a>
                    <a href="/7. partG/lesson3/lesson3_remake.html" class="lesson-card locked" id="lessonCard3">
                        <div class="card-top">
                            <span class="lesson-idx">PROJECT 03</span>
                            <span class="lesson-status-pill locked" id="statusPill3">🔒 Locked</span>
                        </div>
                        <h3 class="lesson-card-title">Form Mutations & JSON POST</h3>
                        <div class="card-bottom">
                            <span class="xp-tag">⚡ +250 XP</span>
                            <span class="card-action-text" id="actionText3">Locked</span>
                        </div>
                    </a>
                    <a href="/7. partG/lesson4/lesson4_remake.html" class="lesson-card locked" id="lessonCard4">
                        <div class="card-top">
                            <span class="lesson-idx">PROJECT 04</span>
                            <span class="lesson-status-pill locked" id="statusPill4">🔒 Locked</span>
                        </div>
                        <h3 class="lesson-card-title">Optimistic UI Updates</h3>
                        <div class="card-bottom">
                            <span class="xp-tag">⚡ +250 XP</span>
                            <span class="card-action-text" id="actionText4">Locked</span>
                        </div>
                    </a>
                    <a href="/7. partG/lesson5/lesson5_remake.html" class="lesson-card locked" id="lessonCard5">
                        <div class="card-top">
                            <span class="lesson-idx">PROJECT 05</span>
                            <span class="lesson-status-pill locked" id="statusPill5">🔒 Locked</span>
                        </div>
                        <h3 class="lesson-card-title">Real-Time Polling & Live Badges</h3>
                        <div class="card-bottom">
                            <span class="xp-tag">⚡ +250 XP</span>
                            <span class="card-action-text" id="actionText5">Locked</span>
                        </div>
                    </a>
                    <a href="/7. partG/lesson6/lesson6_remake.html" class="lesson-card locked" id="lessonCard6">
                        <div class="card-top">
                            <span class="lesson-idx">PROJECT 06</span>
                            <span class="lesson-status-pill locked" id="statusPill6">🔒 Locked</span>
                        </div>
                        <h3 class="lesson-card-title">Capstone: Live E-Commerce Dashboard</h3>
                        <div class="card-bottom">
                            <span class="xp-tag">⚡ +250 XP</span>
                            <span class="card-action-text" id="actionText6">Locked</span>
                        </div>
                    </a>
                </div>
            </div>
        </section>

        <!-- Certificate Showcase Card -->
        <section class="hub-cert-card">
            <div class="cert-card-inner">
                <div class="cert-icon-wrap">🎓</div>
                <div class="cert-text-wrap">
                    <h3>Fullstack API Integration Specialist Certificate</h3>
                    <p>Complete all 6 Level 8 integration projects to generate your verified proof-of-work certificate.</p>
                </div>
                <a href="javascript:void(0)" class="cert-btn locked" id="claimCertBtn">
                    <span>🔒 Complete All 6 Projects First</span>
                </a>
            </div>
        </section>
    </main>

    <PlatformFooter />
</BaseLayout>

<script is:inline src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    import { isLessonCompleted, canAccessLesson, isCertificateAccessible, getCompletedLessonsCount } from '../../scripts/dojo/core/protection';

    function updateHubProgress() {
        const totalLessons = 6;
        let completedCount = getCompletedLessonsCount('partG');
        let nextAccessible = 1;
        let foundNext = false;

        for (let i = 1; i <= totalLessons; i++) {
            const isDone = isLessonCompleted('partG', i);
            const isAccessible = canAccessLesson('partG', i);

            const card = document.getElementById(`lessonCard${i}`);
            const pill = document.getElementById(`statusPill${i}`);
            const action = document.getElementById(`actionText${i}`);

            if (isDone) {
                if (card) {
                    card.className = 'lesson-card completed';
                    card.onclick = null;
                }
                if (pill) { pill.className = 'lesson-status-pill completed'; pill.textContent = '✅ Completed'; }
                if (action) { action.textContent = 'Review ➔'; }
            } else if (isAccessible) {
                if (!foundNext) { nextAccessible = i; foundNext = true; }
                if (card) {
                    card.className = 'lesson-card available';
                    card.onclick = null;
                }
                if (pill) { pill.className = 'lesson-status-pill available'; pill.textContent = '⚡ Up Next'; }
                if (action) { action.textContent = 'Start ➔'; }
            } else {
                if (card) {
                    card.className = 'lesson-card locked';
                    card.onclick = (e) => {
                        e.preventDefault();
                        const req = i - 1;
                        if (typeof (window as any).Swal !== 'undefined') {
                            (window as any).Swal.fire({
                                icon: 'warning',
                                title: '🔒 Lesson Locked',
                                html: `You must complete <strong>Project ${req}</strong> first to unlock <strong>Project ${i}</strong>!`,
                                confirmButtonColor: '#0284c7',
                                confirmButtonText: 'Got It ⚡'
                            });
                        } else {
                            alert(`🔒 Lesson Locked: Complete Project ${req} first to unlock Project ${i}!`);
                        }
                    };
                }
                if (pill) { pill.className = 'lesson-status-pill locked'; pill.textContent = '🔒 Locked'; }
                if (action) { action.textContent = 'Locked'; }
            }
        }

        const pct = Math.round((completedCount / totalLessons) * 100);
        const fill = document.getElementById('heroProgressFill');
        const text = document.getElementById('heroProgressText');
        const stat = document.getElementById('statCompletedProjects');
        const resumeBtn = document.getElementById('heroResumeBtn');
        const certBtn = document.getElementById('claimCertBtn');

        if (fill) fill.style.width = `${pct}%`;
        if (text) text.textContent = `${completedCount} of ${totalLessons} Projects Completed (${pct}%)`;
        if (stat) stat.textContent = `${completedCount} / ${totalLessons}`;

        if (resumeBtn) {
            if (completedCount >= totalLessons) {
                resumeBtn.href = '/7. partG/certificate.html';
                resumeBtn.innerHTML = '<span>🏆 All Projects Solved! Claim Certificate ➔</span>';
            } else {
                resumeBtn.href = `/7. partG/lesson${nextAccessible}/lesson${nextAccessible}_remake.html`;
                resumeBtn.innerHTML = `<span>🚀 Resume Project ${nextAccessible} ➔</span>`;
            }
        }

        if (certBtn) {
            if (isCertificateAccessible('partG')) {
                certBtn.className = 'cert-btn unlocked';
                certBtn.href = '/7. partG/certificate.html';
                certBtn.onclick = null;
                certBtn.innerHTML = '<span>🏆 Claim Certificate ➔</span>';
            } else {
                certBtn.className = 'cert-btn locked';
                certBtn.href = 'javascript:void(0)';
                certBtn.onclick = (e) => {
                    e.preventDefault();
                    if (typeof (window as any).Swal !== 'undefined') {
                        (window as any).Swal.fire({
                            icon: 'warning',
                            title: '🔒 Certificate Locked',
                            html: `You must complete all <strong>${totalLessons} projects</strong> in Level 8 to claim your Certificate!<br><br><span style="color:#64748b;">Current Progress: ${completedCount}/${totalLessons} completed</span>`,
                            confirmButtonColor: '#0284c7',
                            confirmButtonText: 'Continue Coding 🚀'
                        });
                    } else {
                        alert(`🔒 Certificate Locked: Complete all ${totalLessons} projects first!`);
                    }
                };
            }
        }
    }

    document.addEventListener('DOMContentLoaded', updateHubProgress);
    updateHubProgress();
</script>

<style>
    .hub-container { max-width: 1080px; margin: 0 auto; padding: 32px 20px 80px; }
    .hub-hero { background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%); border-radius: 24px; padding: 40px 32px; color: white; margin-bottom: 32px; border: 1px solid #334155; }
    .hub-badge { display: inline-block; padding: 6px 14px; border-radius: 20px; font-size: 0.85rem; font-weight: 700; margin-bottom: 16px; }
    .hub-hero h1 { font-size: 2.2rem; font-weight: 800; margin: 0 0 12px; line-height: 1.2; }
    .hub-hero p { font-size: 1.05rem; color: #94a3b8; max-width: 720px; margin: 0 0 24px; line-height: 1.6; }
    .hero-progress-wrap { background: rgba(255,255,255,0.06); padding: 16px 20px; border-radius: 14px; border: 1px solid rgba(255,255,255,0.1); margin-bottom: 24px; }
    .hero-progress-info { display: flex; justify-content: space-between; font-size: 0.90rem; font-weight: 600; color: #cbd5e1; margin-bottom: 8px; }
    .hero-progress-bar { height: 10px; background: rgba(0,0,0,0.3); border-radius: 6px; overflow: hidden; }
    .hero-progress-fill { height: 100%; width: 0%; background: linear-gradient(90deg, #38bdf8, #0ea5e9); transition: width 0.4s ease; }
    .hero-cta-btn { display: inline-flex; align-items: center; gap: 8px; padding: 14px 28px; background: #0284c7; color: white; text-decoration: none; border-radius: 12px; font-weight: 700; font-size: 1.02rem; transition: transform 0.2s, background 0.2s; }
    .hero-cta-btn:hover { background: #0369a1; transform: translateY(-2px); }
    .hub-stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; margin-bottom: 40px; }
    .hub-stat-card { background: #ffffff; padding: 20px; border-radius: 16px; border: 1px solid #e2e8f0; text-align: center; }
    .hub-stat-val { font-size: 1.4rem; font-weight: 800; color: #0f172a; margin-bottom: 4px; }
    .hub-stat-lbl { font-size: 0.85rem; color: #64748b; font-weight: 600; }
    .chapter-block { background: #ffffff; border: 1px solid #e2e8f0; border-radius: 20px; padding: 28px; margin-bottom: 32px; }
    .chapter-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; padding-bottom: 16px; border-bottom: 1px solid #f1f5f9; }
    .chapter-num { font-size: 0.80rem; font-weight: 800; color: #0284c7; text-transform: uppercase; letter-spacing: 0.5px; }
    .chapter-title { font-size: 1.3rem; font-weight: 800; color: #0f172a; margin: 4px 0 0; }
    .chapter-badge { font-size: 0.82rem; font-weight: 700; color: #475569; background: #f1f5f9; padding: 4px 12px; border-radius: 8px; }
    .lesson-cards-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 16px; }
    .lesson-card { display: flex; flex-direction: column; justify-content: space-between; background: #f8fafc; border: 1.5px solid #e2e8f0; border-radius: 14px; padding: 18px; text-decoration: none; color: inherit; transition: all 0.2s ease; min-height: 120px; }
    .lesson-card:hover { transform: translateY(-3px); border-color: #0284c7; box-shadow: 0 8px 20px rgba(2, 132, 199, 0.08); background: #ffffff; }
    .lesson-card.completed { border-color: #10b981; background: #f0fdf4; }
    .lesson-card.locked { opacity: 0.7; cursor: not-allowed; }
    .card-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; }
    .lesson-idx { font-size: 0.72rem; font-weight: 800; color: #64748b; }
    .lesson-status-pill { font-size: 0.72rem; font-weight: 700; padding: 3px 8px; border-radius: 6px; }
    .lesson-status-pill.available { background: #e0f2fe; color: #0369a1; }
    .lesson-status-pill.completed { background: #dcfce7; color: #15803d; }
    .lesson-status-pill.locked { background: #f1f5f9; color: #94a3b8; }
    .lesson-card-title { font-size: 1.02rem; font-weight: 700; color: #0f172a; margin: 0 0 14px; line-height: 1.4; }
    .card-bottom { display: flex; justify-content: space-between; align-items: center; }
    .xp-tag { font-size: 0.78rem; font-weight: 700; color: #0284c7; }
    .card-action-text { font-size: 0.82rem; font-weight: 700; color: #0f172a; }
    .hub-cert-card { background: #ffffff; border: 1.5px dashed #0284c7; border-radius: 20px; padding: 28px; }
    .cert-card-inner { display: flex; align-items: center; gap: 20px; flex-wrap: wrap; }
    .cert-icon-wrap { font-size: 2.8rem; }
    .cert-text-wrap { flex: 1; min-width: 240px; }
    .cert-text-wrap h3 { font-size: 1.25rem; font-weight: 800; color: #0f172a; margin: 0 0 4px; }
    .cert-text-wrap p { font-size: 0.92rem; color: #475569; margin: 0; }
    .cert-btn { padding: 12px 24px; background: #0284c7; color: white; text-decoration: none; border-radius: 10px; font-weight: 700; transition: background 0.2s; }
    .cert-btn.locked { background: #94a3b8; cursor: not-allowed; }

