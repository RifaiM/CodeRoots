---
import LessonLayout from '../../../layouts/LessonLayout.astro';

const starterCode = `// 🤖 Milestone 4: Modern AI / LLM REST API Integration!

function AIAssistantPanel() {
  const [summary, setSummary] = React.useState("");
  const [isGenerating, setIsGenerating] = React.useState(false);

  const handleGenerateAISummary = () => {
    // 👉 STEP 1: Toggle isGenerating state: setIsGenerating(true)
    

    // 👉 STEP 2: Simulate AI completion and setSummary("• Built Next.js App Router\\n• Integrated PostgreSQL\\n• Deployed to Cloud"):
    // (Hint: setTimeout(() => { setSummary("• Built Next.js App Router\\n• Integrated PostgreSQL\\n• Deployed to Cloud"); setIsGenerating(false); }, 600);)
    
  };

  return (
    <div style={{ padding: '24px', fontFamily: 'sans-serif', maxWidth: '440px', margin: '0 auto', background: '#ffffff', borderRadius: '16px', border: '1px solid #e2e8f0' }}>
      <h2>🤖 AI Executive Summarizer</h2>
      <p style={{ color: '#64748b', fontSize: '0.88rem' }}>Click below to generate an automated AI milestone summary:</p>

      <button onClick={handleGenerateAISummary} style={{ padding: '10px 18px', background: '#6366f1', color: 'white', border: 'none', borderRadius: '8px', fontWeight: 700, cursor: 'pointer', marginBottom: '16px' }}>
        {isGenerating ? "🧠 Analyzing with AI..." : "✨ Generate AI Summary"}
      </button>

      {summary && (
        <div style={{ padding: '16px', background: '#f5f3ff', borderRadius: '12px', border: '1px solid #ddd6fe' }}>
          <h4 style={{ margin: '0 0 8px 0', color: '#4338ca' }}>💡 AI Insights:</h4>
          <pre style={{ margin: 0, fontFamily: 'inherit', fontSize: '0.88rem', color: '#334155', whiteSpace: 'pre-wrap' }}>{summary}</pre>
        </div>
      )}
    </div>
  );
}

const root = ReactDOM.createRoot(document.getElementById('root'));
root.render(<AIAssistantPanel />);
`;

const jumpLessons = [
    {
        "id": 1,
        "title": "Modular SaaS Layout Shell & Navigation",
        "url": "/9. partI/lesson1/lesson1_remake.html"
    },
    {
        "id": 2,
        "title": "Debounced Live Search & Multi-Filter Pipelines",
        "url": "/9. partI/lesson2/lesson2_remake.html"
    },
    {
        "id": 3,
        "title": "Subscription Tier Switcher & Billing UI",
        "url": "/9. partI/lesson3/lesson3_remake.html"
    },
    {
        "id": 4,
        "title": "Interactive AI Copilot & Insights Panel",
        "url": "/9. partI/lesson4/lesson4_remake.html"
    },
    {
        "id": 5,
        "title": "Production Readiness Audit & Pre-Flight Dashboard",
        "url": "/9. partI/lesson5/lesson5_remake.html"
    },
    {
        "id": 6,
        "title": "Apex Capstone: Enterprise SaaS Dashboard Suite",
        "url": "/9. partI/lesson6/lesson6_remake.html"
    }
];
---

<LessonLayout
    title="Interactive AI Copilot & Insights Panel | Level 10 • SaaS UI Architecture"
    description="Build an AI copilot panel with loading animations and simulated streaming insights."
    levelTag="Level 10 • SaaS UI Architecture"
    lessonNum={4}
    lessonTitle="Interactive AI Copilot & Insights Panel"
    xpAmount={500}
    completionKey="partI_lesson4_remake_complete"
    nextLessonUrl="/9. partI/lesson5/lesson5_remake.html"
    hubUrl="/9. partI/hub.html"
    hubTitle="Level 10 Hub"
    hubIcon="🏆"
    fileTab="Apex.jsx"
    mode="react"
    jumpLessons={jumpLessons}
    certificateUrl="/9. partI/certificate.html"
    trackPrefix="partI"
    starterCode={starterCode}
>
    <!-- Intro Slot -->
    <p class="lesson-subtitle" slot="intro">
        Build an AI copilot panel with loading animations and simulated streaming insights.
    </p>

    <!-- Concept Slot (Left Pane) -->
    <div slot="concept" style="display: flex; flex-direction: column; gap: 16px;">
        <!-- Unified Mission Card -->
        <article class="concept-card mission-card">
            <div class="mission-header">
                <h3><span>🎯</span> Your Mission</h3>
                <span class="checklist-counter" id="checklistCounter">0 / 2</span>
            </div>
            <div class="target-output-preview" style="background: #f1f5f9; border-radius: 8px; padding: 10px 12px; margin: 8px 0 12px 0; border: 1px dashed #94a3b8; font-size: 0.82rem;">
                <strong style="color: #334155;">🖼️ Target Goal:</strong>
                <div style="color: #475569; margin-top: 3px;">Build an AI insights generator panel that shows a thinking animation and renders structured AI summaries!</div>
            </div>
            <p class="mission-subtitle">Follow the step-by-step instructions below in the editor:</p>
            <div id="taskChecklist"></div>
        </article>

        <!-- Analogy Explainer Card -->
        <article class="concept-card">
            <h3><span>💡</span> Core Concept &amp; Mental Model</h3>
            <p>Connect frontend applications to AI LLM inference endpoints to generate automated summaries and smart content tags.</p>
            <div class="analogy-callout">
                <strong>Real-World Analogy:</strong> An AI API endpoint is like having an expert executive assistant on speed dial 🤖: you hand them raw messy notes, and they hand back clean bullet points in seconds.
            </div>
        </article>
    </div>
</LessonLayout>

<!-- Client-Side Scripts & Verification Engine -->
<script>
    import { DojoEngine } from '../../../scripts/dojo';

    function initLesson() {
        const editor = document.getElementById('lessonEditor') as HTMLTextAreaElement | null;
        const lineNumbers = document.getElementById('ideLineNumbers');
        const lineNumbersInner = document.getElementById('ideLineNumbersInner') || lineNumbers;
        const previewIframe = document.getElementById('livePreviewIframe') as HTMLIFrameElement | null;
        const checkBtn = document.getElementById('checkAnswerBtn');
        const resetBtn = document.getElementById('resetEditorBtn');

        if (!editor) return;

        const DRAFT_KEY = 'novicodes_draft_partI_lesson4';
        const DEFAULT_STARTER = `// 🤖 Milestone 4: Modern AI / LLM REST API Integration!

function AIAssistantPanel() {
  const [summary, setSummary] = React.useState("");
  const [isGenerating, setIsGenerating] = React.useState(false);

  const handleGenerateAISummary = () => {
    // 👉 STEP 1: Toggle isGenerating state: setIsGenerating(true)
    

    // 👉 STEP 2: Simulate AI completion and setSummary("• Built Next.js App Router\\n• Integrated PostgreSQL\\n• Deployed to Cloud"):
    // (Hint: setTimeout(() => { setSummary("• Built Next.js App Router\\n• Integrated PostgreSQL\\n• Deployed to Cloud"); setIsGenerating(false); }, 600);)
    
  };

  return (
    <div style={{ padding: '24px', fontFamily: 'sans-serif', maxWidth: '440px', margin: '0 auto', background: '#ffffff', borderRadius: '16px', border: '1px solid #e2e8f0' }}>
      <h2>🤖 AI Executive Summarizer</h2>
      <p style={{ color: '#64748b', fontSize: '0.88rem' }}>Click below to generate an automated AI milestone summary:</p>

      <button onClick={handleGenerateAISummary} style={{ padding: '10px 18px', background: '#6366f1', color: 'white', border: 'none', borderRadius: '8px', fontWeight: 700, cursor: 'pointer', marginBottom: '16px' }}>
        {isGenerating ? "🧠 Analyzing with AI..." : "✨ Generate AI Summary"}
      </button>

      {summary && (
        <div style={{ padding: '16px', background: '#f5f3ff', borderRadius: '12px', border: '1px solid #ddd6fe' }}>
          <h4 style={{ margin: '0 0 8px 0', color: '#4338ca' }}>💡 AI Insights:</h4>
          <pre style={{ margin: 0, fontFamily: 'inherit', fontSize: '0.88rem', color: '#334155', whiteSpace: 'pre-wrap' }}>{summary}</pre>
        </div>
      )}
    </div>
  );
}

const root = ReactDOM.createRoot(document.getElementById('root'));
root.render(<AIAssistantPanel />);
`;

        // 1. Initialize Real-Time Conceptual Checklist
        DojoEngine.initChecklist([
            { id: 'start_generating', label: 'Call <code>setIsGenerating(true)</code> in handler', fn: (code) => { const c = code.replace(/\/\*[\s\S]*?\*\//g, '').replace(/(?<!:)\/\/[^\r\n]*/g, ''); return /setIsGenerating[\s\n]*\([\s\n]*true[\s\n]*\)/i.test(c); } },
            { id: 'set_summary', label: 'Call <code>setSummary(...)</code> with summary bullet points', fn: (code) => { const c = code.replace(/\/\*[\s\S]*?\*\//g, '').replace(/(?<!:)\/\/[^\r\n]*/g, ''); return /setSummary[\s\n]*\(/i.test(c); } }
        ], {
            containerId: 'taskChecklist',
            mode: 'javascript'
        });

        // 2. Line numbers & scroll sync
        function syncScroll() {
            if (lineNumbersInner && editor) {
                lineNumbersInner.style.transform = `translateY(-${editor.scrollTop}px)`;
            }
        }

        function updateEditor() {
            if (!editor || !lineNumbersInner) return;
            const lines = editor.value.split('\n');
            const lineCount = Math.max(lines.length, 1);
            lineNumbersInner.textContent = Array.from({ length: lineCount }, (_, i) => i + 1).join('\n');
            syncScroll();

            // Render live React JSX preview inside iframe
            if (previewIframe) {
                const code = editor.value;
                const htmlDoc = `<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <script src="https://unpkg.com/react@18/umd/react.development.js"><\/script>
  <script src="https://unpkg.com/react-dom@18/umd/react-dom.development.js"><\/script>
  <script src="https://unpkg.com/@babel/standalone/babel.min.js"><\/script>
  <style>
    body { margin: 0; padding: 12px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; background: #ffffff; color: #0f172a; }
  </style>
</head>
<body>
  <div id="root"></div>
  <script type="text/babel">
    try {
      ${code}
    } catch (err) {
      document.getElementById('root').innerHTML = '<div style="color:#ef4444; background:#fef2f2; border:1px solid #fecaca; padding:12px; border-radius:8px; font-size:13px; font-family:monospace;"><b>⚠️ Render Error:</b> ' + err.message + '</div>';
    }
  <\/script>
</body>
</html>`;
                previewIframe.srcdoc = htmlDoc;
            }

            // Real-Time Syntax & Diagnostics
            DojoEngine.lint(editor.value, 'javascript');

            // Real-Time Checklist Verification
            DojoEngine.runChecklist(editor.value);
        }

        // 3. Draft Auto-Save & Crash Resilience
        DojoEngine.setupDraftPersistence(editor, DRAFT_KEY, DEFAULT_STARTER, updateEditor);

        editor.addEventListener('scroll', syncScroll);

        editor.addEventListener('keydown', (e) => {
            if (e.key === 'Tab') {
                e.preventDefault();
                const start = editor.selectionStart;
                const end = editor.selectionEnd;
                editor.value = editor.value.substring(0, start) + '  ' + editor.value.substring(end);
                editor.selectionStart = editor.selectionEnd = start + 2;
                updateEditor();
            }
        });

        // 4. Safe Reset Button Handler
        if (resetBtn) {
            DojoEngine.setupResetButton(resetBtn, editor, DRAFT_KEY, DEFAULT_STARTER, () => {
                updateEditor();
            });
        }

        // 5. Check & Verify Code Action with Diagnostics
        if (checkBtn) {
            checkBtn.addEventListener('click', () => {
                DojoEngine.verifySubmission(editor.value, {
                    lessonTitle: 'Modern AI / LLM REST API Integration',
                    xp: 500,
                    completionKey: 'partI_lesson4_remake_complete',
                    nextUrl: '/9. partI/lesson5/lesson5_remake.html',
                    mode: 'javascript'
                });
            });
        }

        // Initial Paint
        updateEditor();
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initLesson);
    } else {
        initLesson();
    }
</script>
