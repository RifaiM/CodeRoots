---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PlatformHeader from '../../components/PlatformHeader.astro';
import PlatformFooter from '../../components/PlatformFooter.astro';

const navLinks = [
    { href: '/', label: 'Dashboard', icon: '🏠', title: 'Dashboard Home' },
    { href: '/9. partI/hub.html', label: 'Level 10 Hub', icon: '🏆', title: 'Level 10 Hub' }
];
---

<BaseLayout 
    title="Apex Graduation Diploma: Fullstack Software Engineer | NoviCodes" 
    description="The official NoviCodes Fullstack Software Engineering Graduation Diploma certifying production mastery across Next.js, FastAPI, PostgreSQL, Stripe, and AI Integration."
    showHeaderFooter={false}
>
    <PlatformHeader 
        slot="header"
        tagText="Level 10 • Graduation Diploma"
        tagId="headerLogoTag"
        navLinks={navLinks}
        showXpBadge={true}
        showLevelBadge={true}
    />

    <main class="cert-page-container">
        <div class="cert-container">
            
            <!-- Certificate Generator Controls -->
            <section class="generator-card">
                <div class="generator-header">
                    <h2>🎓 Level 10 Graduation Diploma Generator</h2>
                    <p>Enter your full legal name or developer alias to generate your verified NoviCodes Graduation Credential.</p>
                </div>

                <div class="generator-inputs">
                    <div class="input-group">
                        <label for="learnerNameInput">Full Legal Name / Developer Alias:</label>
                        <input type="text" id="learnerNameInput" placeholder="e.g. Alex Rivera" value="Fullstack Software Engineer" />
                    </div>
                    <div class="btn-row">
                        <button class="cert-action-btn primary" id="generateCertBtn">
                            <span>✨ Update Diploma</span>
                        </button>
                        <button class="cert-action-btn success" id="downloadCertBtn">
                            <span>📥 Download High-Res PNG</span>
                        </button>
                        <button class="cert-action-btn secondary" id="printCertBtn" onclick="window.print()">
                            <span>🖨️ Print / PDF</span>
                        </button>
                    </div>
                </div>
            </section>

            <!-- Visual Certificate Preview -->
            <div class="certificate-frame gold-theme" id="certificateFrame">
                <div class="certificate-inner gold-inner">
                    <div class="cert-watermark">NOVICODES</div>
                    
                    <div class="cert-top-row">
                        <img src="/assets/logo.jpg" alt="NoviCodes Logo" class="cert-logo-img" />
                        <div class="cert-brand gold-brand">NOVICODES APEX ACADEMY</div>
                        <div class="cert-id-badge gold-id">HONORS ID: <span id="certIdDisplay">NC-APEX-2026-0042</span></div>
                    </div>

                    <div class="cert-center-content">
                        <div class="cert-icon-seal">🏆</div>
                        <h1 class="cert-title">GRADUATION DIPLOMA</h1>
                        <p class="cert-subtitle gold-sub">FULLSTACK SOFTWARE ENGINEERING MASTERY</p>

                        <p class="cert-award-text">This highest institutional credential certifies that</p>
                        <h2 class="cert-student-name gold-name" id="certNameDisplay">Fullstack Software Engineer</h2>

                        <p class="cert-description">
                            Has demonstrated comprehensive mastery from <strong>Novice to Career-Ready Fullstack Engineer</strong>, successfully building, architecting, and deploying multi-tenant production applications with <strong>Next.js 14 App Router, FastAPI Microservices, Cloud PostgreSQL, Stripe SaaS Billing, and OpenAI AI Integration</strong>.
                        </p>
                    </div>

                    <div class="cert-bottom-row">
                        <div class="cert-col">
                            <div class="cert-col-title">GRADUATION DATE</div>
                            <div class="cert-col-val" id="certDateDisplay">August 16, 2026</div>
                        </div>

                        <div class="cert-seal-badge">
                            <div class="seal-circle gold-seal">
                                <span>HONORS</span>
                                <strong>★ NOVICODES ★</strong>
                                <span>GRADUATE</span>
                            </div>
                        </div>

                        <div class="cert-col right">
                            <div class="cert-col-title">ACCREDITATION SIGNATURE</div>
                            <div class="cert-sig-box">
                                <span class="sig-script">NoviCodes Academic Board</span>
                                <div class="sig-line gold-line"></div>
                                <span class="sig-sub">Chief Curriculum Architect</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Hidden Canvas for PNG Generation -->
            <canvas id="certCanvas" style="display: none;"></canvas>

            <!-- Return Link -->
            <div class="return-link-wrap" style="text-align: center; margin-top: 24px;">
                <a href="/9. partI/hub.html" style="color: #d97706; font-weight: 700; text-decoration: none; font-size: 0.95rem;">
                    ← Return to Level 10 Apex SaaS Hub
                </a>
            </div>

        </div>
    </main>

    <PlatformFooter slot="footer" />
</BaseLayout>

<style>
    .cert-page-container {
        padding: 32px 20px 60px 20px;
        background: linear-gradient(135deg, #fefce8 0%, #f8fafc 100%);
        min-height: calc(100vh - 140px);
        display: flex;
        justify-content: center;
    }

    .cert-container {
        max-width: 900px;
        width: 100%;
        display: flex;
        flex-direction: column;
        gap: 28px;
    }

    .generator-card {
        background: #ffffff;
        border: 1.5px solid #fde68a;
        border-radius: 16px;
        padding: 24px;
        box-shadow: 0 4px 14px rgba(245, 158, 11, 0.05);
    }

    .generator-header h2 {
        margin: 0 0 8px 0;
        font-size: 1.35rem;
        color: #78350f;
        font-weight: 800;
    }

    .generator-header p {
        margin: 0 0 16px 0;
        color: #64748b;
        font-size: 0.90rem;
    }

    .generator-inputs {
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    .input-group label {
        display: block;
        font-size: 0.85rem;
        font-weight: 700;
        color: #334155;
        margin-bottom: 6px;
    }

    .input-group input {
        width: 100%;
        padding: 12px 14px;
        border: 1.5px solid #cbd5e1;
        border-radius: 10px;
        font-size: 0.95rem;
        font-family: inherit;
        box-sizing: border-box;
        outline: none;
        transition: border-color 0.2s;
    }

    .input-group input:focus {
        border-color: #d97706;
    }

    .btn-row {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
    }

    .cert-action-btn {
        padding: 10px 20px;
        border-radius: 10px;
        font-weight: 700;
        font-size: 0.92rem;
        border: none;
        cursor: pointer;
        transition: all 0.2s;
    }

    .cert-action-btn.primary { background: linear-gradient(135deg, #f59e0b, #d97706); color: #0f172a; font-weight: 800; }
    .cert-action-btn.success { background: #10b981; color: white; }
    .cert-action-btn.secondary { background: #f1f5f9; color: #334155; border: 1px solid #cbd5e1; }

    /* Visual Certificate Frame - Apex Gold Theme */
    .certificate-frame {
        background: #ffffff;
        border: 12px solid #0f172a;
        padding: 12px;
        box-shadow: 0 16px 40px rgba(245, 158, 11, 0.12);
        border-radius: 4px;
    }

    .certificate-inner.gold-inner {
        border: 2px dashed #f59e0b;
        padding: 36px 40px;
        text-align: center;
        position: relative;
        background: linear-gradient(180deg, #ffffff 0%, #fffbeb 100%);
    }

    .cert-watermark {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%) rotate(-25deg);
        font-size: 5.5rem;
        font-weight: 900;
        color: rgba(245, 158, 11, 0.04);
        letter-spacing: 12px;
        user-select: none;
        pointer-events: none;
    }

    .cert-top-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 20px;
    }

    .cert-logo-img {
        width: 44px;
        height: 44px;
        border-radius: 8px;
    }

    .cert-brand.gold-brand {
        font-size: 0.85rem;
        font-weight: 800;
        letter-spacing: 2px;
        color: #b45309;
    }

    .cert-id-badge.gold-id {
        font-size: 0.75rem;
        font-family: 'Fira Code', monospace;
        color: #92400e;
        background: #fef3c7;
        padding: 4px 8px;
        border-radius: 6px;
        border: 1px solid #fde68a;
    }

    .cert-center-content {
        margin-bottom: 24px;
    }

    .cert-icon-seal {
        font-size: 2.8rem;
        margin-bottom: 8px;
    }

    .cert-title {
        font-size: 2.1rem;
        font-weight: 900;
        color: #0f172a;
        letter-spacing: 2px;
        margin: 0 0 4px 0;
        font-family: 'Plus Jakarta Sans', sans-serif;
    }

    .cert-subtitle.gold-sub {
        font-size: 0.92rem;
        font-weight: 800;
        color: #d97706;
        letter-spacing: 1.5px;
        margin: 0 0 24px 0;
    }

    .cert-award-text {
        font-size: 0.80rem;
        font-weight: 700;
        color: #94a3b8;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        margin: 0 0 10px 0;
    }

    .cert-student-name.gold-name {
        font-size: 2.2rem;
        font-weight: 900;
        color: #0f172a;
        margin: 0 0 16px 0;
        border-bottom: 2px solid #f59e0b;
        display: inline-block;
        padding: 0 24px 4px 24px;
    }

    .cert-description {
        font-size: 0.88rem;
        line-height: 1.6;
        color: #475569;
        max-width: 640px;
        margin: 0 auto;
    }

    .cert-bottom-row {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        border-top: 1px solid #fde68a;
        padding-top: 20px;
    }

    .cert-col {
        text-align: left;
    }

    .cert-col.right {
        text-align: right;
    }

    .cert-col-title {
        font-size: 0.68rem;
        font-weight: 800;
        color: #b45309;
        letter-spacing: 1px;
        margin-bottom: 4px;
    }

    .cert-col-val {
        font-size: 0.84rem;
        font-weight: 700;
        color: #0f172a;
    }

    .seal-circle.gold-seal {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        border: 2px dashed #f59e0b;
        background: #fffbeb;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        font-size: 0.52rem;
        font-weight: 800;
        color: #b45309;
        text-align: center;
        line-height: 1.2;
        box-shadow: 0 4px 12px rgba(245, 158, 11, 0.15);
    }

    .cert-sig-box {
        text-align: right;
    }

    .sig-script {
        font-family: 'Playfair Display', Georgia, serif;
        font-style: italic;
        font-size: 1.05rem;
        color: #0f172a;
        font-weight: 700;
    }

    .sig-line.gold-line {
        width: 140px;
        height: 1px;
        background: #f59e0b;
        margin: 4px 0 4px auto;
    }

    .sig-sub {
        font-size: 0.68rem;
        color: #64748b;
    }

    /* ── Responsive Viewports ─── */
    @media (max-width: 768px) {
        .certificate-inner.gold-inner { padding: 24px 18px; }
        .cert-student-name.gold-name { font-size: 1.5rem; }
        .cert-title { font-size: 1.3rem; }
        .cert-bottom-row {
            flex-direction: column;
            gap: 16px;
            align-items: center;
            text-align: center;
        }
        .cert-sig-box { text-align: center; }
        .sig-line.gold-line { margin: 4px auto; }
    }

    @media (max-width: 425px) {
        .cert-page-container { padding: 16px 10px 40px; }
        .generator-card { padding: 16px 12px; }
        .btn-row { flex-direction: column; }
        .cert-action-btn { width: 100%; text-align: center; }
        .certificate-inner.gold-inner { padding: 16px 10px; }
        .cert-title { font-size: 1.15rem; }
        .cert-subtitle.gold-sub { font-size: 0.76rem; }
        .cert-student-name.gold-name { font-size: 1.30rem; padding: 0 10px 4px; }
        .cert-description { font-size: 0.78rem; }
    }

    @media (max-width: 375px) {
        .cert-title { font-size: 1.02rem; }
        .cert-student-name.gold-name { font-size: 1.15rem; }
        .cert-description { font-size: 0.72rem; }
    }

    @media (max-width: 320px) {
        .cert-title { font-size: 0.92rem; }
        .cert-student-name.gold-name { font-size: 1.02rem; }
        .cert-description { font-size: 0.66rem; }
    }

    /* ── Pixel-Perfect Print Stylesheet (Hides Navbar, Footer & Form Controls) ─── */
    @media print {
        @page {
            size: landscape;
            margin: 0;
        }
        html, body {
            background: #ffffff !important;
            margin: 0 !important;
            padding: 0 !important;
            -webkit-print-color-adjust: exact !important;
            print-color-adjust: exact !important;
        }
        header, footer, nav, .platform-header, .platform-footer, .generator-card, .btn-row, #printCertBtn, .return-link-wrap {
            display: none !important;
        }
        .cert-page-container {
            padding: 0 !important;
            margin: 0 !important;
            max-width: 100% !important;
            min-height: auto !important;
            background: transparent !important;
            display: block !important;
        }
        .cert-container {
            max-width: 100% !important;
            gap: 0 !important;
            padding: 0 !important;
            margin: 0 !important;
        }
        .certificate-frame {
            box-shadow: none !important;
            border: 12px solid #0f172a !important;
            page-break-inside: avoid !important;
            break-inside: avoid !important;
            width: 96% !important;
            max-width: 1000px !important;
            margin: 20px auto !important;
        }
    }
</style>

<script is:inline src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    import { isCertificateAccessible, getCompletedLessonsCount } from '../../scripts/dojo/core/protection';

    document.addEventListener('DOMContentLoaded', () => {
        // 1. Strict Page Access Protection
        if (!isCertificateAccessible('partI')) {
            const count = getCompletedLessonsCount('partI');
            const remaining = 6 - count;

            if (typeof (window as any).Swal !== 'undefined') {
                (window as any).Swal.fire({
                    icon: 'warning',
                    title: 'Graduation Diploma Locked! 📜',
                    html: `
                        <div style="text-align: center;">
                            <p style="color: #475569; margin-bottom: 16px;">
                                You must complete all <strong>6 milestones</strong> in Level 10 before claiming your official Graduation Diploma!
                            </p>
                            <div style="background: #f8fafc; border: 1px solid #e2e8f0; padding: 14px; border-radius: 12px; display: flex; justify-content: space-around; margin-bottom: 12px;">
                                <div>
                                    <div style="font-size: 1.4rem; font-weight: 800; color: #10b981;">${count} / 6</div>
                                    <div style="font-size: 0.8rem; color: #64748b;">Milestones Shipped</div>
                                </div>
                                <div>
                                    <div style="font-size: 1.4rem; font-weight: 800; color: #ef4444;">${remaining}</div>
                                    <div style="font-size: 0.8rem; color: #64748b;">Remaining</div>
                                </div>
                            </div>
                        </div>
                    `,
                    confirmButtonColor: '#f59e0b',
                    confirmButtonText: '🚀 Go to Level 10 Hub',
                    allowOutsideClick: false,
                    allowEscapeKey: false
                }).then(() => {
                    window.location.href = '/9. partI/hub.html';
                });
            } else {
                window.location.href = '/9. partI/hub.html';
            }
            return;
        }

        const input = document.getElementById('learnerNameInput') as HTMLInputElement | null;
        const nameDisplay = document.getElementById('certNameDisplay');
        const updateBtn = document.getElementById('generateCertBtn');
        const downloadBtn = document.getElementById('downloadCertBtn');
        const dateDisplay = document.getElementById('certDateDisplay');
        const idDisplay = document.getElementById('certIdDisplay');

        const now = new Date();
        if (dateDisplay) {
            dateDisplay.textContent = now.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
        }

        if (idDisplay) {
            const hash = 'NC-APEX-' + now.getFullYear() + '-' + Math.floor(1000 + Math.random() * 9000);
            idDisplay.textContent = hash;
        }

        const savedName = localStorage.getItem('partI_cert_student_name') || 'Fullstack Software Engineer';
        if (input) input.value = savedName;
        if (nameDisplay) nameDisplay.textContent = savedName;

        if (updateBtn && input && nameDisplay) {
            updateBtn.addEventListener('click', () => {
                const val = input.value.trim() || 'Fullstack Software Engineer';
                nameDisplay.textContent = val;
                localStorage.setItem('partI_cert_student_name', val);
            });
        }

        // High-Res Canvas PNG Engine
        if (downloadBtn) {
            downloadBtn.addEventListener('click', () => {
                const canvas = document.getElementById('certCanvas') as HTMLCanvasElement | null;
                if (!canvas) return;
                const ctx = canvas.getContext('2d');
                if (!ctx) return;

                canvas.width = 1200;
                canvas.height = 800;

                ctx.fillStyle = '#ffffff';
                ctx.fillRect(0, 0, 1200, 800);

                ctx.lineWidth = 14;
                ctx.strokeStyle = '#0f172a';
                ctx.strokeRect(20, 20, 1160, 760);

                ctx.lineWidth = 3;
                ctx.strokeStyle = '#f59e0b';
                ctx.strokeRect(34, 34, 1132, 732);

                ctx.textAlign = 'center';
                ctx.fillStyle = '#0f172a';
                ctx.font = '900 36px sans-serif';
                ctx.fillText('GRADUATION DIPLOMA', 600, 160);

                ctx.fillStyle = '#b45309';
                ctx.font = '800 18px sans-serif';
                ctx.fillText('FULLSTACK SOFTWARE ENGINEERING MASTERY', 600, 200);

                ctx.fillStyle = '#64748b';
                ctx.font = '500 16px sans-serif';
                ctx.fillText('This highest institutional credential certifies that:', 600, 280);

                const name = nameDisplay ? nameDisplay.textContent : 'Fullstack Software Engineer';
                ctx.fillStyle = '#0f172a';
                ctx.font = '900 44px sans-serif';
                ctx.fillText(name || 'Fullstack Software Engineer', 600, 360);

                ctx.fillStyle = '#475569';
                ctx.font = '500 16px sans-serif';
                ctx.fillText('Has demonstrated comprehensive mastery from Novice to Career-Ready Fullstack Engineer,', 600, 430);
                ctx.fillText('successfully building and deploying Next.js 14, FastAPI, Cloud PostgreSQL, Stripe, and AI Systems.', 600, 460);

                ctx.textAlign = 'left';
                ctx.font = '700 14px monospace';
                ctx.fillStyle = '#64748b';
                ctx.fillText('GRADUATION DATE: ' + (dateDisplay ? dateDisplay.textContent : ''), 80, 680);
                ctx.fillText('HONORS ID: ' + (idDisplay ? idDisplay.textContent : ''), 80, 710);

                ctx.textAlign = 'right';
                ctx.fillText('NOVICODES ACADEMIC BOARD', 1120, 680);
                ctx.font = '500 13px sans-serif';
                ctx.fillText('Chief Curriculum Architect', 1120, 710);

                const link = document.createElement('a');
                link.download = `NoviCodes-Level10-Graduation-Diploma-${(name || 'Engineer').replace(/\s+/g, '_')}.png`;
                link.href = canvas.toDataURL('image/png');
                link.click();
            });
        }
    });
</script>
