---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PlatformHeader from '../../components/PlatformHeader.astro';
import PlatformFooter from '../../components/PlatformFooter.astro';

const navLinks = [
    { href: '/', label: 'Dashboard', icon: '🏠', title: 'Dashboard Home' },
    { href: '/9. partI/hub.html', label: 'Level 10 Hub', icon: '🏆', title: 'Level 10 Hub' }
];
---

<BaseLayout 
    title="Apex Graduation Diploma: Fullstack Software Engineer | NoviCodes" 
    description="The official NoviCodes Fullstack Software Engineering Graduation Diploma certifying production mastery across Next.js, FastAPI, PostgreSQL, and AI Integration."
    showHeaderFooter={false}
>
    <PlatformHeader 
        slot="header"
        tagText="Level 10 • Graduation Diploma"
        tagId="headerLogoTag"
        navLinks={navLinks}
        showXpBadge={true}
        showLevelBadge={true}
    />

    <main class="cert-page-container">
        <div class="cert-container">
            <section class="generator-card">
                <div class="generator-header">
                    <h2>🎓 Fullstack Software Engineer Graduation Diploma</h2>
                    <p>Enter your full legal name or developer alias to generate your verified NoviCodes Graduation Credential.</p>
                </div>

                <div class="generator-inputs">
                    <div class="input-group">
                        <label for="learnerNameInput">Full Legal Name / Developer Alias:</label>
                        <input type="text" id="learnerNameInput" placeholder="e.g. Alex Rivera" value="Fullstack Software Engineer" />
                    </div>
                    <div class="btn-row">
                        <button class="cert-action-btn primary" id="generateCertBtn">
                            <span>✨ Update Diploma</span>
                        </button>
                        <button class="cert-action-btn success" id="downloadCertBtn">
                            <span>📥 Download High-Res PNG</span>
                        </button>
                        <button class="cert-action-btn secondary" id="printCertBtn" onclick="window.print()">
                            <span>🖨️ Print / PDF</span>
                        </button>
                    </div>
                </div>
            </section>

            <!-- Hidden Canvas for PNG Generation -->
            <canvas id="certCanvas" style="display: none;"></canvas>

            <!-- Live Printable Certificate Card -->
            <section class="certificate-frame-wrap">
                <div class="cert-canvas-card">
                    <div class="cert-border">
                        <div class="cert-inner-content">
                            <div class="cert-top-badge">
                                <span class="badge-icon">🏛️</span>
                                <span class="badge-text">NOVICODES APEX FULLSTACK GRADUATION DIPLOMA</span>
                            </div>
                            <h1 class="cert-main-title">Fullstack Software Engineer</h1>
                            <p class="cert-award-text">This highest institutional credential certifies that</p>
                            <h2 class="cert-recipient-name" id="certNameDisplay">Fullstack Software Engineer</h2>
                            <p class="cert-description-text">
                                has completed the comprehensive curriculum from <strong>Novice to Fullstack Web Developer</strong>, achieving verified mastery across HTML5, CSS3, Modern JavaScript, React Component Architecture, Python Backend Engineering, Cloud Databases, Next.js SSR, Stripe Monetization, and AI Integration.
                            </p>
                            <div class="cert-footer-meta">
                                <div class="meta-col">
                                    <span class="meta-label">ACCREDITED BY</span>
                                    <span class="meta-val">NoviCodes Academy</span>
                                </div>
                                <div class="meta-col">
                                    <span class="meta-label">GRADUATION DATE</span>
                                    <span class="meta-val" id="certDateDisplay">August 2026</span>
                                </div>
                                <div class="meta-col">
                                    <span class="meta-label">HONORS ID</span>
                                    <span class="meta-val font-mono" id="certIdDisplay">CR-APEX-1000</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </div>
    </main>

    <PlatformFooter />
</BaseLayout>

<script is:inline src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    import { isCertificateAccessible, getCompletedLessonsCount } from '../../scripts/dojo/core/protection';

    document.addEventListener('DOMContentLoaded', () => {
        // 1. Strict Page Access Protection
        if (!isCertificateAccessible('partI')) {
            const count = getCompletedLessonsCount('partI');
            const remaining = 6 - count;

            if (typeof (window as any).Swal !== 'undefined') {
                (window as any).Swal.fire({
                    icon: 'warning',
                    title: 'Graduation Diploma Locked! 📜',
                    html: `
                        <div style="text-align: center;">
                            <p style="color: #475569; margin-bottom: 16px;">
                                You must complete all <strong>6 milestones</strong> in Level 10 before claiming your official Graduation Diploma!
                            </p>
                            <div style="background: #f8fafc; border: 1px solid #e2e8f0; padding: 14px; border-radius: 12px; display: flex; justify-content: space-around; margin-bottom: 12px;">
                                <div>
                                    <div style="font-size: 1.4rem; font-weight: 800; color: #10b981;">${count} / 6</div>
                                    <div style="font-size: 0.8rem; color: #64748b;">Milestones Shipped</div>
                                </div>
                                <div>
                                    <div style="font-size: 1.4rem; font-weight: 800; color: #ef4444;">${remaining}</div>
                                    <div style="font-size: 0.8rem; color: #64748b;">Remaining</div>
                                </div>
                            </div>
                        </div>
                    `,
                    confirmButtonColor: '#f59e0b',
                    confirmButtonText: '🚀 Go to Level 10 Hub',
                    allowOutsideClick: false,
                    allowEscapeKey: false
                }).then(() => {
                    window.location.href = '/9. partI/hub.html';
                });
            } else {
                window.location.href = '/9. partI/hub.html';
            }
            return;
        }

        const input = document.getElementById('learnerNameInput') as HTMLInputElement | null;
        const nameDisplay = document.getElementById('certNameDisplay');
        const updateBtn = document.getElementById('generateCertBtn');
        const downloadBtn = document.getElementById('downloadCertBtn');
        const dateDisplay = document.getElementById('certDateDisplay');
        const idDisplay = document.getElementById('certIdDisplay');

        const now = new Date();
        if (dateDisplay) {
            dateDisplay.textContent = now.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
        }

        if (idDisplay) {
            const hash = 'CR-APEX-' + Math.floor(1000 + Math.random() * 9000);
            idDisplay.textContent = hash;
        }

        const savedName = localStorage.getItem('partI_cert_student_name') || 'Fullstack Software Engineer';
        if (input) input.value = savedName;
        if (nameDisplay) nameDisplay.textContent = savedName;

        if (updateBtn && input && nameDisplay) {
            updateBtn.addEventListener('click', () => {
                const val = input.value.trim() || 'Fullstack Software Engineer';
                nameDisplay.textContent = val;
                localStorage.setItem('partI_cert_student_name', val);
            });
        }

        // High-Res Canvas PNG Engine
        if (downloadBtn) {
            downloadBtn.addEventListener('click', () => {
                const canvas = document.getElementById('certCanvas') as HTMLCanvasElement | null;
                if (!canvas) return;
                const ctx = canvas.getContext('2d');
                if (!ctx) return;

                canvas.width = 1200;
                canvas.height = 800;

                ctx.fillStyle = '#ffffff';
                ctx.fillRect(0, 0, 1200, 800);

                ctx.lineWidth = 14;
                ctx.strokeStyle = '#0f172a';
                ctx.strokeRect(20, 20, 1160, 760);

                ctx.lineWidth = 3.5;
                ctx.strokeStyle = '#f59e0b';
                ctx.strokeRect(34, 34, 1132, 732);

                ctx.textAlign = 'center';
                ctx.fillStyle = '#0f172a';
                ctx.font = '900 36px sans-serif';
                ctx.fillText('FULLSTACK SOFTWARE ENGINEER', 600, 160);

                ctx.fillStyle = '#d97706';
                ctx.font = '700 18px sans-serif';
                ctx.fillText('CODEROOTS APEX FULLSTACK GRADUATION DIPLOMA', 600, 200);

                ctx.fillStyle = '#64748b';
                ctx.font = '500 16px sans-serif';
                ctx.fillText('This highest institutional credential certifies that', 600, 280);

                const name = nameDisplay ? nameDisplay.textContent : 'Fullstack Software Engineer';
                ctx.fillStyle = '#0f172a';
                ctx.font = '900 44px sans-serif';
                ctx.fillText(name || 'Fullstack Software Engineer', 600, 360);

                ctx.fillStyle = '#475569';
                ctx.font = '500 16px sans-serif';
                ctx.fillText('For completing the comprehensive curriculum from Novice to Fullstack Web Developer,', 600, 430);
                ctx.fillText('mastering Next.js SSR, PostgreSQL Databases, Stripe Monetization, and AI Microservices.', 600, 460);

                ctx.textAlign = 'left';
                ctx.font = '700 14px monospace';
                ctx.fillStyle = '#64748b';
                ctx.fillText('GRADUATION DATE: ' + (dateDisplay ? dateDisplay.textContent : ''), 80, 680);
                ctx.fillText('HONORS ID: ' + (idDisplay ? idDisplay.textContent : ''), 80, 710);

                ctx.textAlign = 'right';
                ctx.fillText('NOVICODES ACADEMIC BOARD', 1120, 680);
                ctx.font = '500 13px sans-serif';
                ctx.fillText('Chief Curriculum Architect', 1120, 710);

                const link = document.createElement('a');
                link.download = `NoviCodes-Level10-Graduation-Diploma-${(name || 'Engineer').replace(/\s+/g, '_')}.png`;
                link.href = canvas.toDataURL('image/png');
                link.click();
            });
        }
    });
</script>

<style>
    .cert-page-container { max-width: 1040px; margin: 0 auto; padding: 32px 20px 80px; }
    .generator-card { background: #ffffff; border: 1.5px solid #e2e8f0; border-radius: 20px; padding: 28px; margin-bottom: 32px; }
    .generator-header h2 { font-size: 1.5rem; font-weight: 800; color: #0f172a; margin: 0 0 6px; }
    .generator-header p { font-size: 0.95rem; color: #64748b; margin: 0 0 20px; }
    .input-group label { display: block; font-size: 0.85rem; font-weight: 700; color: #334155; margin-bottom: 6px; }
    .input-group input { width: 100%; max-width: 420px; padding: 10px 14px; border: 1.5px solid #cbd5e1; border-radius: 10px; font-size: 1rem; font-family: inherit; margin-bottom: 16px; box-sizing: border-box; }
    .btn-row { display: flex; gap: 12px; flex-wrap: wrap; }
    .cert-action-btn { padding: 10px 20px; border-radius: 10px; font-weight: 700; font-size: 0.92rem; border: none; cursor: pointer; transition: all 0.2s; }
    .cert-action-btn.primary { background: #f59e0b; color: #0f172a; font-weight: 800; }
    .cert-action-btn.success { background: #10b981; color: white; }
    .cert-action-btn.secondary { background: #f1f5f9; color: #334155; border: 1px solid #cbd5e1; }
    .certificate-frame-wrap { background: #f8fafc; padding: 24px; border-radius: 20px; border: 1px solid #e2e8f0; display: flex; justify-content: center; }
    .cert-canvas-card { width: 100%; max-width: 860px; background: #ffffff; border-radius: 16px; padding: 24px; box-shadow: 0 16px 40px rgba(0,0,0,0.08); }
    .cert-border { border: 3.5px solid #f59e0b; border-radius: 12px; padding: 36px 28px; background: linear-gradient(180deg, #ffffff 0%, #fffbeb 100%); text-align: center; }
    .cert-top-badge { display: inline-flex; align-items: center; gap: 6px; font-size: 0.76rem; font-weight: 800; color: #b45309; letter-spacing: 1px; margin-bottom: 16px; }
    .cert-main-title { font-size: 1.9rem; font-weight: 900; color: #0f172a; margin: 0 0 10px; text-transform: uppercase; letter-spacing: 0.5px; }
    .cert-award-text { font-size: 0.95rem; color: #64748b; margin: 0 0 12px; font-style: italic; }
    .cert-recipient-name { font-size: 2.2rem; font-weight: 900; color: #d97706; margin: 0 0 16px; text-decoration: underline; text-underline-offset: 6px; }
    .cert-description-text { font-size: 0.95rem; color: #334155; max-width: 620px; margin: 0 auto 32px; line-height: 1.6; }
    .cert-footer-meta { display: flex; justify-content: space-around; border-top: 1px solid #e2e8f0; padding-top: 20px; }
    .meta-col { display: flex; flex-direction: column; }
    .meta-label { font-size: 0.72rem; font-weight: 800; color: #94a3b8; letter-spacing: 0.5px; }
    .meta-val { font-size: 0.90rem; font-weight: 700; color: #0f172a; margin-top: 2px; }
    .font-mono { font-family: monospace; }

    /* ── ≤768px: Tablet ─── */
    @media (max-width: 768px) {
        .cert-page-container { padding: 20px 14px 60px; }
        .generator-card { padding: 20px 16px; border-radius: 16px; margin-bottom: 20px; }
        .certificate-frame-wrap { padding: 16px 12px; border-radius: 16px; }
        .cert-canvas-card { padding: 16px; border-radius: 12px; }
        .cert-border { padding: 24px 16px; }
        .cert-main-title { font-size: 1.4rem; }
        .cert-recipient-name { font-size: 1.6rem; }
        .cert-description-text { font-size: 0.85rem; margin-bottom: 20px; }
        .cert-footer-meta { flex-direction: column; gap: 12px; text-align: center; }
    }

    /* ── ≤425px: Mobile Large ─── */
    @media (max-width: 425px) {
        .cert-page-container { padding: 12px 8px 40px; }
        .generator-card { padding: 16px 12px; }
        .generator-header h2 { font-size: 1.25rem; }
        .generator-header p { font-size: 0.82rem; margin-bottom: 14px; }
        .input-group label { font-size: 0.78rem; }
        .input-group input { font-size: 0.90rem; padding: 8px 12px; }
        .btn-row { flex-direction: column; gap: 8px; }
        .cert-action-btn { width: 100%; text-align: center; padding: 10px; font-size: 0.85rem; }
        .certificate-frame-wrap { padding: 10px 6px; border-radius: 12px; }
        .cert-canvas-card { padding: 10px; }
        .cert-border { padding: 18px 10px; }
        .cert-top-badge { font-size: 0.68rem; margin-bottom: 10px; }
        .cert-main-title { font-size: 1.15rem; }
        .cert-recipient-name { font-size: 1.30rem; }
        .cert-award-text { font-size: 0.82rem; }
        .cert-description-text { font-size: 0.78rem; line-height: 1.5; margin-bottom: 16px; }
        .meta-label { font-size: 0.65rem; }
        .meta-val { font-size: 0.80rem; }
    }

    /* ── ≤375px: Mobile Medium (iPhone SE) ─── */
    @media (max-width: 375px) {
        .cert-page-container { padding: 8px 6px 30px; }
        .generator-card { padding: 12px 10px; }
        .generator-header h2 { font-size: 1.10rem; }
        .generator-header p { font-size: 0.76rem; }
        .cert-main-title { font-size: 1.02rem; }
        .cert-recipient-name { font-size: 1.15rem; }
        .cert-description-text { font-size: 0.72rem; }
        .meta-label { font-size: 0.60rem; }
        .meta-val { font-size: 0.74rem; }
    }

    /* ── ≤320px: Mobile Small ─── */
    @media (max-width: 320px) {
        .cert-page-container { padding: 6px 4px 24px; }
        .generator-card { padding: 10px 8px; }
        .generator-header h2 { font-size: 0.98rem; }
        .generator-header p { font-size: 0.70rem; }
        .cert-main-title { font-size: 0.92rem; }
        .cert-recipient-name { font-size: 1.02rem; }
        .cert-description-text { font-size: 0.66rem; }
        .cert-border { padding: 14px 6px; }
        .meta-label { font-size: 0.55rem; }
        .meta-val { font-size: 0.68rem; }
    }
</style>
