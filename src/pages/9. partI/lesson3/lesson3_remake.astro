  };

  return (
    <div style={{ padding: '24px', fontFamily: 'sans-serif', maxWidth: '420px', margin: '0 auto', background: '#ffffff', borderRadius: '16px', border: '1px solid #e2e8f0', textAlign: 'center' }}>
      <h2>💳 SaaS Subscription Tier</h2>
      <div style={{ padding: '16px', background: tier === 'pro' ? '#fef3c7' : '#f1f5f9', borderRadius: '12px', marginBottom: '16px', border: tier === 'pro' ? '1.5px solid #f59e0b' : '1px solid #cbd5e1' }}>
        <h3 style={{ margin: '0 0 6px 0', color: tier === 'pro' ? '#b45309' : '#0f172a' }}>
