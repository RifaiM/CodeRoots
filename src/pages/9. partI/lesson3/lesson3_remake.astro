---

<LessonLayout
    title="Stripe Checkout & Webhook Subscription Tiers | Level 10 • Apex SaaS"
    description="Handle recurring SaaS monetization by creating Stripe checkout session triggers and webhook subscription tier handlers."
    levelTag="Level 10 • Apex SaaS"
    lessonNum={3}
    lessonTitle="Stripe Checkout & Webhook Subscription Tiers"
    xpAmount={500}
    completionKey="partI_lesson3_remake_complete"
    nextLessonUrl="/9. partI/lesson4/lesson4_remake.html"
    hubUrl="/9. partI/hub.html"
    hubTitle="Level 10 Hub"
    hubIcon="🏆"
    fileTab="Apex.jsx"
    mode="react"
    jumpLessons={jumpLessons}
    certificateUrl="/9. partI/certificate.html"
    trackPrefix="partI"
    starterCode={starterCode}
>
    <!-- Intro Slot -->
    <div slot="intro">
        <p class="lesson-subtitle">
            Handle recurring SaaS monetization by creating Stripe checkout session triggers and webhook subscription tier handlers.
        </p>
        <div class="stackblitz-banner">
            <div class="sb-badge-row">
                <span class="sb-badge">🏆 Production SaaS Stack</span>
                <span class="sb-runtime-tag">WebContainer Engine</span>
            </div>
            <p>Master modern enterprise architectures here. To run with <strong>live Stripe webhook listeners, AI streaming inference endpoints, and Cloud SQL</strong>, launch the fullstack SaaS sandbox:</p>
            <a href="https://stackblitz.com/fork/github/vercel/next.js/tree/canary/examples/with-stripe-typescript" target="_blank" rel="noopener noreferrer" class="sb-open-btn">
                <span>⚡ Open in StackBlitz (Next.js + Stripe SaaS) →</span>
            </a>
        </div>
    </div>

    <!-- Concept Slot (Left Pane) -->
    <div slot="concept" style="display: flex; flex-direction: column; gap: 16px;">
        <!-- Unified Mission Card -->
        <article class="concept-card mission-card">
            <div class="mission-header">
                <h3><span>🎯</span> Your Mission</h3>
                <span class="checklist-counter" id="checklistCounter">0 / 2</span>
            </div>
            <div class="target-output-preview" style="background: #f1f5f9; border-radius: 8px; padding: 10px 12px; margin: 8px 0 12px 0; border: 1px dashed #94a3b8; font-size: 0.82rem;">
                <strong style="color: #334155;">🖼️ Target Goal:</strong>
                <div style="color: #475569; margin-top: 3px;">Pricing Tier Card switching between Free and Pro with simulated Stripe Checkout upgrade!</div>
            </div>
            <p class="mission-subtitle">Follow the step-by-step instructions below in the editor:</p>
            <div id="taskChecklist"></div>
        </article>

        <!-- Analogy Explainer Card -->
        <article class="concept-card">
            <h3><span>💡</span> Core Concept &amp; Mental Model</h3>
            <p>Handle recurring SaaS monetization by creating Stripe checkout session triggers and webhook subscription tier handlers.</p>
            <div class="analogy-callout">
                <strong>Real-World Analogy:</strong> Stripe Webhooks are like digital automated courier receipts 🧾: the instant a user pays at checkout, Stripe notifies your server to upgrade their account permissions.
            </div>
        </article>
    </div>
</LessonLayout>

<!-- Client-Side Scripts & Verification Engine -->
<script>
    import { DojoEngine } from '../../../scripts/dojo';

    function initLesson() {
        const editor = document.getElementById('lessonEditor') as HTMLTextAreaElement | null;
        const lineNumbers = document.getElementById('ideLineNumbers');
        const lineNumbersInner = document.getElementById('ideLineNumbersInner') || lineNumbers;
        const previewIframe = document.getElementById('livePreviewIframe') as HTMLIFrameElement | null;
        const checkBtn = document.getElementById('checkAnswerBtn');
        const resetBtn = document.getElementById('resetEditorBtn');

        if (!editor) return;

        const DRAFT_KEY = 'novicodes_draft_partI_lesson3';
        const DEFAULT_STARTER = `// 💳 Milestone 3: Stripe Checkout & Subscription Tiers!

function PricingBillingCard() {
  const [tier, setTier] = React.useState("free");

  const handleUpgradeToPro = () => {
    // 👉 STEP 1: Update tier state to "pro":
    // (Hint: setTier("pro");)
    

  };

  return (
    <div style={{ padding: '24px', fontFamily: 'sans-serif', maxWidth: '420px', margin: '0 auto', background: '#ffffff', borderRadius: '16px', border: '1px solid #e2e8f0', textAlign: 'center' }}>
      <h2>💳 SaaS Subscription Tier</h2>
      <div style={{ padding: '16px', background: tier === 'pro' ? '#fef3c7' : '#f1f5f9', borderRadius: '12px', marginBottom: '16px', border: tier === 'pro' ? '1.5px solid #f59e0b' : '1px solid #cbd5e1' }}>
        <h3 style={{ margin: '0 0 6px 0', color: tier === 'pro' ? '#b45309' : '#0f172a' }}>
          {tier === 'pro' ? "⭐ NoviCodes PRO Plan" : "🌱 Free Starter Plan"}
        </h3>
        <p style={{ margin: 0, fontSize: '0.88rem', color: '#64748b' }}>
          {tier === 'pro' ? "Unlimited AI Queries & Cloud DB" : "Basic Sandbox Access"}
        </p>
      </div>

      {/* 👉 STEP 2: Attach onClick={handleUpgradeToPro} to Upgrade Button: */}
      <button style={{ padding: '12px 24px', background: tier === 'pro' ? '#10b981' : '#f59e0b', color: tier === 'pro' ? 'white' : '#0f172a', border: 'none', borderRadius: '10px', fontWeight: 800, cursor: 'pointer', fontSize: '0.95rem' }}>
        {tier === 'pro' ? "✅ Current Plan: PRO" : "⚡ Upgrade to PRO ($29/mo)"}
      </button>
    </div>
  );
}

const root = ReactDOM.createRoot(document.getElementById('root'));
root.render(<PricingBillingCard />);
`;

        // 1. Initialize Real-Time Conceptual Checklist
        DojoEngine.initChecklist([
            { id: 'upgrade_tier', label: 'Call <code>setTier("pro")</code> inside handler', fn: (code) => { const c = code.replace(/\/\*[\s\S]*?\*\//g, '').replace(/(?<!:)\/\/[^\r\n]*/g, ''); return /setTier[\s\n]*\([\s\n]*["']pro["'][\s\n]*\)/i.test(c); } },
            { id: 'attach_click', label: 'Attach <code>onClick={handleUpgradeToPro}</code> to button', fn: (code) => { const c = code.replace(/\/\*[\s\S]*?\*\//g, '').replace(/(?<!:)\/\/[^\r\n]*/g, ''); return /onClick[\s\n]*=[\s\n]*\{[\s\n]*handleUpgradeToPro[\s\n]*\}/i.test(c); } }
        ], {
            containerId: 'taskChecklist',
            mode: 'javascript'
        });

        // 2. Line numbers & scroll sync
        function syncScroll() {
            if (lineNumbersInner && editor) {
                lineNumbersInner.style.transform = `translateY(-${editor.scrollTop}px)`;
            }
        }

        function updateEditor() {
            if (!editor || !lineNumbersInner) return;
            const lines = editor.value.split('\n');
            const lineCount = Math.max(lines.length, 1);
            lineNumbersInner.textContent = Array.from({ length: lineCount }, (_, i) => i + 1).join('\n');
            syncScroll();

            // Render live React JSX preview inside iframe
            if (previewIframe) {
                const code = editor.value;
                const htmlDoc = `<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <script src="https://unpkg.com/react@18/umd/react.development.js"><\/script>
  <script src="https://unpkg.com/react-dom@18/umd/react-dom.development.js"><\/script>
  <script src="https://unpkg.com/@babel/standalone/babel.min.js"><\/script>
  <style>
    body { margin: 0; padding: 12px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; background: #ffffff; color: #0f172a; }
  </style>
</head>
<body>
  <div id="root"></div>
  <script type="text/babel">
    try {
      ${code}
    } catch (err) {
      document.getElementById('root').innerHTML = '<div style="color:#ef4444; background:#fef2f2; border:1px solid #fecaca; padding:12px; border-radius:8px; font-size:13px; font-family:monospace;"><b>⚠️ Render Error:</b> ' + err.message + '</div>';
    }
  <\/script>
</body>
</html>`;
                previewIframe.srcdoc = htmlDoc;
            }

            // Real-Time Syntax & Diagnostics
            DojoEngine.lint(editor.value, 'javascript');

            // Real-Time Checklist Verification
            DojoEngine.runChecklist(editor.value);
        }

        // 3. Draft Auto-Save & Crash Resilience
        DojoEngine.setupDraftPersistence(editor, DRAFT_KEY, DEFAULT_STARTER, updateEditor);

        editor.addEventListener('scroll', syncScroll);

        editor.addEventListener('keydown', (e) => {
            if (e.key === 'Tab') {
                e.preventDefault();
                const start = editor.selectionStart;
                const end = editor.selectionEnd;
                editor.value = editor.value.substring(0, start) + '  ' + editor.value.substring(end);
                editor.selectionStart = editor.selectionEnd = start + 2;
                updateEditor();
            }
        });

        // 4. Safe Reset Button Handler
        if (resetBtn) {
            DojoEngine.setupResetButton(resetBtn, editor, DRAFT_KEY, DEFAULT_STARTER, () => {
                updateEditor();
            });
        }

        // 5. Check & Verify Code Action with Diagnostics
        if (checkBtn) {
            checkBtn.addEventListener('click', () => {
                DojoEngine.verifySubmission(editor.value, {
                    lessonTitle: 'Stripe Checkout & Webhook Subscription Tiers',
                    xp: 500,
                    completionKey: 'partI_lesson3_remake_complete',
                    nextUrl: '/9. partI/lesson4/lesson4_remake.html',
                    mode: 'javascript'
                });
            });
        }

        // Initial Paint
        updateEditor();
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initLesson);
    } else {
        initLesson();
    }
</script>
