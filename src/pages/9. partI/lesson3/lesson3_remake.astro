    {
        "id": 1,
        "title": "Enterprise Next.js App Router Blueprint",
        "url": "/9. partI/lesson1/lesson1_remake.html"
    },
    {
        "id": 2,
        "title": "Server-Side Search & Debounced Pagination",
        "url": "/9. partI/lesson2/lesson2_remake.html"
    },
    {
        "id": 3,
        "title": "Stripe Checkout & Webhook Subscription Tiers",
        "url": "/9. partI/lesson3/lesson3_remake.html"
    },
    {
        "id": 4,
        "title": "Modern AI / LLM REST API Integration",
        "url": "/9. partI/lesson4/lesson4_remake.html"
    },
    {
        "id": 5,
        "title": "Cloud Production Deployment & Security",
        "url": "/9. partI/lesson5/lesson5_remake.html"
    },
    {
        "id": 6,
