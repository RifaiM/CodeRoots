---
import LessonLayout from '../../../layouts/LessonLayout.astro';

const starterCode = `// 🚧 Lesson 3: Protected Route Guards & Redirects!

function ProtectedGuard({ isAuthenticated, children }) {
  // 👉 STEP 1: If isAuthenticated is false, return Lockscreen fallback redirect:
  // (Hint: if (!isAuthenticated) { return <div style={{ padding: '20px', background: '#fee2e2', color: '#991b1b', borderRadius: '10px' }}>🔒 Access Denied: Please log in to view this page.</div>; })
  

  return children;
}

function SecretAdminDashboard() {
  const [isLoggedIn, setIsLoggedIn] = React.useState(false);

  return (
    <div style={{ padding: '24px', fontFamily: 'sans-serif', maxWidth: '440px', margin: '0 auto' }}>
      <h2>🔐 Private Workspace</h2>
      <button onClick={() => setIsLoggedIn(!isLoggedIn)} style={{ marginBottom: '16px', padding: '8px 16px', borderRadius: '8px', cursor: 'pointer' }}>
        Toggle Login Status: {isLoggedIn ? "🟢 Logged In" : "🔴 Guest"}
      </button>

      <ProtectedGuard isAuthenticated={isLoggedIn}>
        <div style={{ padding: '16px', background: '#dcfce7', border: '1px solid #86efac', borderRadius: '10px' }}>
          <h3>🏆 Top Secret Financial Metrics</h3>
          <p style={{ margin: 0 }}>Monthly Recurring Revenue: $48,500</p>
        </div>
      </ProtectedGuard>
    </div>
  );
}

const root = ReactDOM.createRoot(document.getElementById('root'));
root.render(<SecretAdminDashboard />);
`;

const jumpLessons = [
    {
        "id": 1,
        "title": "Stateless JWT Login & Token Storage",
        "url": "/8. partH/lesson1/lesson1_remake.html"
    },
    {
        "id": 2,
        "title": "Global useAuth() Context & Session Hook",
        "url": "/8. partH/lesson2/lesson2_remake.html"
    },
    {
        "id": 3,
        "title": "Protected Route Guards & Redirects",
        "url": "/8. partH/lesson3/lesson3_remake.html"
    },
    {
        "id": 4,
        "title": "Cloud Database Relational CRUD",
        "url": "/8. partH/lesson4/lesson4_remake.html"
    },
    {
        "id": 5,
        "title": "Role-Based Access Control (RBAC)",
        "url": "/8. partH/lesson5/lesson5_remake.html"
    },
    {
        "id": 6,
        "title": "Capstone: Multi-User Task SaaS with RBAC",
        "url": "/8. partH/lesson6/lesson6_remake.html"
    }
];
---

<LessonLayout
    title="Protected Route Guards & Redirects | Level 9 • Auth & Database"
    description="Safeguard private application views by creating a Route Guard component that redirects unauthenticated users."
    levelTag="Level 9 • Auth & Database"
    lessonNum={3}
    lessonTitle="Protected Route Guards & Redirects"
    xpAmount={250}
    completionKey="partH_lesson3_remake_complete"
    nextLessonUrl="/8. partH/lesson4/lesson4_remake.html"
    hubUrl="/8. partH/hub.html"
    hubTitle="Level 9 Hub"
    hubIcon="🛡️"
    fileTab="Auth.jsx"
    mode="react"
    jumpLessons={jumpLessons}
    certificateUrl="/8. partH/certificate.html"
    trackPrefix="partH"
    starterCode={starterCode}
>
    <!-- Intro Slot -->
    <div slot="intro">
        <p class="lesson-subtitle">
            Safeguard private application views by creating a Route Guard component that redirects unauthenticated users.
        </p>
        <div class="stackblitz-banner">
            <div class="sb-badge-row">
                <span class="sb-badge">🔒 Cloud Auth & Database</span>
                <span class="sb-runtime-tag">Instant WebContainer</span>
            </div>
            <p>Master authentication and schema concepts here. To run with <strong>live server routes, JWT session cookies, and database models</strong>, launch the instant Next.js sandbox:</p>
            <a href="https://stackblitz.com/fork/nextjs" target="_blank" rel="noopener noreferrer" class="sb-open-btn">
                <span>⚡ Open in StackBlitz (Instant Next.js) →</span>
            </a>
        </div>
    </div>

    <!-- Concept Slot (Left Pane) -->
    <div slot="concept" style="display: flex; flex-direction: column; gap: 16px;">
        <!-- Unified Mission Card -->
        <article class="concept-card mission-card">
            <div class="mission-header">
                <h3><span>🎯</span> Your Mission</h3>
                <span class="checklist-counter" id="checklistCounter">0 / 2</span>
            </div>
            <div class="target-output-preview" style="background: #f1f5f9; border-radius: 8px; padding: 10px 12px; margin: 8px 0 12px 0; border: 1px dashed #94a3b8; font-size: 0.82rem;">
                <strong style="color: #334155;">🖼️ Target Goal:</strong>
                <div style="color: #475569; margin-top: 3px;">Protected Route Guard blocking unauthorized access with a Lockscreen message and redirect link!</div>
            </div>
            <p class="mission-subtitle">Follow the step-by-step instructions below in the editor:</p>
            <div id="taskChecklist"></div>
        </article>

        <!-- Analogy Explainer Card -->
        <article class="concept-card">
            <h3><span>💡</span> Core Concept &amp; Mental Model</h3>
            <p>Safeguard private application views by creating a Route Guard component that redirects unauthenticated users.</p>
            <div class="analogy-callout">
                <strong>Real-World Analogy:</strong> A protected route is like a VIP badge scanner 🛡️: standard visitors get redirected back to the front desk, while badge holders enter the lounge.
            </div>
        </article>
    </div>
</LessonLayout>

<!-- Client-Side Scripts & Verification Engine -->
<script>
    import { DojoEngine } from '../../../scripts/dojo';

    function initLesson() {
        const editor = document.getElementById('lessonEditor') as HTMLTextAreaElement | null;
        const lineNumbers = document.getElementById('ideLineNumbers');
        const lineNumbersInner = document.getElementById('ideLineNumbersInner') || lineNumbers;
        const previewIframe = document.getElementById('livePreviewIframe') as HTMLIFrameElement | null;
        const checkBtn = document.getElementById('checkAnswerBtn');
        const resetBtn = document.getElementById('resetEditorBtn');

        if (!editor) return;

        const DRAFT_KEY = 'novicodes_draft_partH_lesson3';
        const DEFAULT_STARTER = `// 🚧 Lesson 3: Protected Route Guards & Redirects!

function ProtectedGuard({ isAuthenticated, children }) {
  // 👉 STEP 1: If isAuthenticated is false, return Lockscreen fallback redirect:
  // (Hint: if (!isAuthenticated) { return <div style={{ padding: '20px', background: '#fee2e2', color: '#991b1b', borderRadius: '10px' }}>🔒 Access Denied: Please log in to view this page.</div>; })
  

  return children;
}

function SecretAdminDashboard() {
  const [isLoggedIn, setIsLoggedIn] = React.useState(false);

  return (
    <div style={{ padding: '24px', fontFamily: 'sans-serif', maxWidth: '440px', margin: '0 auto' }}>
      <h2>🔐 Private Workspace</h2>
      <button onClick={() => setIsLoggedIn(!isLoggedIn)} style={{ marginBottom: '16px', padding: '8px 16px', borderRadius: '8px', cursor: 'pointer' }}>
        Toggle Login Status: {isLoggedIn ? "🟢 Logged In" : "🔴 Guest"}
      </button>

      <ProtectedGuard isAuthenticated={isLoggedIn}>
        <div style={{ padding: '16px', background: '#dcfce7', border: '1px solid #86efac', borderRadius: '10px' }}>
          <h3>🏆 Top Secret Financial Metrics</h3>
          <p style={{ margin: 0 }}>Monthly Recurring Revenue: $48,500</p>
        </div>
      </ProtectedGuard>
    </div>
  );
}

const root = ReactDOM.createRoot(document.getElementById('root'));
root.render(<SecretAdminDashboard />);
`;

        // 1. Initialize Real-Time Conceptual Checklist
        DojoEngine.initChecklist([
            { id: 'guard_check', label: 'Check <code>if (!isAuthenticated)</code> in guard', fn: (code) => { const c = code.replace(/\/\*[\s\S]*?\*\//g, '').replace(/(?<!:)\/\/[^\r\n]*/g, ''); return /if[\s\n]*\([\s\n]*!isAuthenticated[\s\n]*\)/i.test(c); } },
            { id: 'return_fallback', label: 'Return Access Denied lockscreen when unauthenticated', fn: (code) => { const c = code.replace(/\/\*[\s\S]*?\*\//g, '').replace(/(?<!:)\/\/[^\r\n]*/g, ''); return /if[\s\n]*\([\s\n]*!isAuthenticated[\s\n]*\)[\s\S]*?return/i.test(c); } }
        ], {
            containerId: 'taskChecklist',
            mode: 'javascript'
        });

        // 2. Line numbers & scroll sync
        function syncScroll() {
            if (lineNumbersInner && editor) {
                lineNumbersInner.style.transform = `translateY(-${editor.scrollTop}px)`;
            }
        }

        function updateEditor() {
            if (!editor || !lineNumbersInner) return;
            const lines = editor.value.split('\n');
            const lineCount = Math.max(lines.length, 1);
            lineNumbersInner.textContent = Array.from({ length: lineCount }, (_, i) => i + 1).join('\n');
            syncScroll();

            // Render live React JSX preview inside iframe
            if (previewIframe) {
                const code = editor.value;
                const htmlDoc = `<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <script src="https://unpkg.com/react@18/umd/react.development.js"><\/script>
  <script src="https://unpkg.com/react-dom@18/umd/react-dom.development.js"><\/script>
  <script src="https://unpkg.com/@babel/standalone/babel.min.js"><\/script>
  <style>
    body { margin: 0; padding: 12px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; background: #ffffff; color: #0f172a; }
  </style>
</head>
<body>
  <div id="root"></div>
  <script type="text/babel">
    try {
      ${code}
    } catch (err) {
      document.getElementById('root').innerHTML = '<div style="color:#ef4444; background:#fef2f2; border:1px solid #fecaca; padding:12px; border-radius:8px; font-size:13px; font-family:monospace;"><b>⚠️ Render Error:</b> ' + err.message + '</div>';
    }
  <\/script>
</body>
</html>`;
                previewIframe.srcdoc = htmlDoc;
            }

            // Real-Time Syntax & Diagnostics
            DojoEngine.lint(editor.value, 'javascript');

            // Real-Time Checklist Verification
            DojoEngine.runChecklist(editor.value);
        }

        // 3. Draft Auto-Save & Crash Resilience
        DojoEngine.setupDraftPersistence(editor, DRAFT_KEY, DEFAULT_STARTER, updateEditor);

        editor.addEventListener('scroll', syncScroll);

        editor.addEventListener('keydown', (e) => {
            if (e.key === 'Tab') {
                e.preventDefault();
                const start = editor.selectionStart;
                const end = editor.selectionEnd;
                editor.value = editor.value.substring(0, start) + '  ' + editor.value.substring(end);
                editor.selectionStart = editor.selectionEnd = start + 2;
                updateEditor();
            }
        });

        // 4. Safe Reset Button Handler
        if (resetBtn) {
            DojoEngine.setupResetButton(resetBtn, editor, DRAFT_KEY, DEFAULT_STARTER, () => {
                updateEditor();
            });
        }

        // 5. Check & Verify Code Action with Diagnostics
        if (checkBtn) {
            checkBtn.addEventListener('click', () => {
                DojoEngine.verifySubmission(editor.value, {
                    lessonTitle: 'Protected Route Guards & Redirects',
                    xp: 250,
                    completionKey: 'partH_lesson3_remake_complete',
                    nextUrl: '/8. partH/lesson4/lesson4_remake.html',
                    mode: 'javascript'
                });
            });
        }

        // Initial Paint
        updateEditor();
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initLesson);
    } else {
        initLesson();
    }
</script>
