---
import BaseLayout from '../layouts/BaseLayout.astro';
import PlatformHeader from '../components/PlatformHeader.astro';
import PlatformFooter from '../components/PlatformFooter.astro';

const navLinks = [
    { href: '/', label: 'Dashboard', icon: '🏠', title: 'Dashboard Home' },
    { href: '/foundations.html', label: 'Foundations', icon: '🧱', title: 'Web Foundations' },
    { href: '/privacy.html', label: 'Privacy Policy', icon: '🔒', title: 'Privacy Policy' }
];
---

<BaseLayout 
    title="Terms of Use | NoviCodes" 
    description="Review the terms and conditions for using the NoviCodes interactive coding platform, resources, and sandbox tools."
    showHeaderFooter={false}
>
    <PlatformHeader 
        slot="header"
        tagText="Platform Governance • Terms"
        tagId="headerLogoTag"
        navLinks={navLinks}
        showXpBadge={false}
        showLevelBadge={false}
    />

    <!-- Main Content -->
    <main class="legal-container">
        <!-- Hero -->
        <div class="legal-hero">
            <h1>📜 Terms of Use</h1>
            <p>100% Open Source under MIT License • Educational Freedom</p>
        </div>

        <!-- Highlight Callout -->
        <div class="highlight-card">
            <h3>⚖️ MIT Open Source License</h3>
            <p>NoviCodes is free, open-source software released under the MIT License. You have complete freedom to learn, build, adapt, modify, and utilize all code exercises, projects, and educational content for personal or commercial projects!</p>
        </div>

        <!-- Section 1 -->
        <div class="legal-card">
            <h2><span>🎓</span> 1. Educational Content &amp; Free Access</h2>
            <p>NoviCodes is designed as a zero-barrier learning engine for aspiring web developers worldwide. All 45 lessons, interactive sandboxes, and Dojo challenges across Level 0 through Level 7 are 100% free to access without hidden fees or paywalls.</p>
        </div>

        <!-- Section 2 -->
        <div class="legal-card">
            <h2><span>💼</span> 2. Code Ownership &amp; Student Projects</h2>
            <p>Any code you write inside the NoviCodes interactive sandboxes or Dojo projects belongs entirely to you. You are encouraged to feature your completed Dojo projects in your personal developer portfolio, GitHub repositories, or client projects.</p>
        </div>

        <!-- Section 3 -->
        <div class="legal-card">
            <h2><span>📄</span> 3. Official MIT License Text</h2>
            <p>The formal legal terms governing the platform are set forth below under the standard MIT Open Source License:</p>

            <div class="code-box">
Permission is hereby granted, free of charge, to any person obtaining a copy of this software and associated documentation files (the "Software"), to deal in the Software without restriction, including without limitation the rights to use, copy, modify, merge, publish, distribute, sublicense, and/or sell copies of the Software.

THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.
            </div>
        </div>

        <!-- Section 4 -->
        <div class="legal-card">
            <h2><span>📜</span> 4. Verifiable Proof of Work Certificates</h2>
            <p>Official course completion certificates issued by NoviCodes are proof of your completed hands-on coding work. Certificates are generated locally based on your verified lesson progress.</p>
        </div>
    </main>

    <PlatformFooter slot="footer" />
</BaseLayout>

<style>
    .legal-container {
        max-width: 800px;
        margin: 32px auto 60px auto;
        padding: 0 20px;
        box-sizing: border-box;
    }

    .legal-hero {
        background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%);
        color: #ffffff;
        padding: 36px 28px;
        border-radius: 20px;
        margin-bottom: 28px;
        box-shadow: 0 10px 25px rgba(2, 132, 199, 0.2);
        text-align: center;
    }

    .legal-hero h1 {
        font-size: clamp(1.6rem, 4vw, 2.4rem);
        margin: 0 0 8px 0;
        font-weight: 800;
    }

    .legal-hero p {
        color: #bae6fd;
        font-size: 1rem;
        margin: 0;
        font-weight: 600;
    }

    .highlight-card {
        background: #f0f9ff;
        border: 1px solid #7dd3fc;
        border-left: 5px solid #0284c7;
        padding: 20px 22px;
        border-radius: 14px;
        margin-bottom: 28px;
        color: #0369a1;
    }

    .highlight-card h3 {
        margin: 0 0 6px 0;
        font-size: 1.05rem;
        font-weight: 800;
        color: #0284c7;
    }

    .highlight-card p {
        margin: 0;
        font-size: 0.92rem;
        line-height: 1.5;
    }

    .legal-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        padding: 28px 24px;
        margin-bottom: 20px;
        box-shadow: 0 4px 12px rgba(15, 23, 42, 0.04);
    }

    .legal-card h2 {
        font-size: 1.25rem;
        font-weight: 800;
        color: #1e293b;
        margin: 0 0 12px 0;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .legal-card p, .legal-card ul {
        color: #475569;
        font-size: 0.95rem;
        line-height: 1.65;
        margin: 0 0 12px 0;
    }

    .legal-card ul {
        padding-left: 20px;
        margin-bottom: 0;
    }

    .legal-card li {
        margin-bottom: 8px;
    }

    .code-box {
        background: #0f172a;
        color: #f8fafc;
        padding: 16px 20px;
        border-radius: 10px;
        font-family: 'Fira Code', monospace;
        font-size: 0.82rem;
        line-height: 1.5;
        overflow-x: auto;
        margin-top: 12px;
    }

    @media (max-width: 480px) {
        .legal-container {
            padding: 0 14px;
        }
        .legal-hero {
            padding: 24px 16px;
        }
        .legal-card {
            padding: 20px 16px;
        }
    }
</style>
