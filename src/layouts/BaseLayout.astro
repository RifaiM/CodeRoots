---
import '../styles/root.css';
import '../styles/dashboard.css';
import '../styles/lesson.css';
import PlatformFooter from '../components/PlatformFooter.astro';
import UserProfileModal from '../components/UserProfileModal.astro';

interface Props {
 title?: string;
 description?: string;
 canonical?: string;
 ogImage?: string;
 showHeaderFooter?: boolean;
 bodyClass?: string;
 noPageContentWrapper?: boolean;
}

const {
 title = 'NoviCodes • Learn Web Development by Doing',
 description = 'Master web development through interactive in-browser coding practice. 10 structured levels, 103 hands-on challenges in HTML, CSS, JavaScript, React, Next.js, TypeScript, Cloud, SQL, and Python with an instant test runner and verified proof-of-work certificates.',
 canonical = 'https://novicodes.dev',
 ogImage = '/assets/og-image.jpg',
 showHeaderFooter = true,
 bodyClass = '',
 noPageContentWrapper = false
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
 <meta charset="UTF-8" />
 <meta name="viewport" content="width=device-width, initial-scale=1.0" />
 <link rel="icon" type="image/png" href="/assets/favicon.png" />
 
 <title>{title}</title>
 <meta name="description" content={description} />
 <meta name="keywords" content="learn web development, learn javascript by doing, interactive react tutorials, python coding practice, typescript mastery, css animations, nextjs app router, in-browser code editor, web development roadmap, frontend coding challenges, proof of work certificates" />
 <meta name="author" content="NoviCodes" />
 <meta name="robots" content="index, follow" />
 <link rel="canonical" href={canonical} />
 
 <!-- Open Graph / Facebook / LinkedIn -->
 <meta property="og:site_name" content="NoviCodes" />
 <meta property="og:type" content="website" />
 <meta property="og:url" content={canonical} />
 <meta property="og:title" content={title} />
 <meta property="og:description" content={description} />
 <meta property="og:image" content={ogImage} />
 <meta property="og:locale" content="en_US" />
 
 <!-- Twitter -->
 <meta name="twitter:card" content="summary_large_image" />
 <meta name="twitter:url" content={canonical} />
 <meta name="twitter:title" content={title} />
 <meta name="twitter:description" content={description} />
 <meta name="twitter:image" content={ogImage} />
 
	<!-- JSON-LD Structured Data Schema (SEO, AEO & GEO Optimized) -->
	<script type="application/ld+json" is:inline>
	{
		"@context": "https://schema.org",
		"@graph": [
			{
				"@type": "EducationalWebSite",
				"@id": "https://novicodes.dev/#website",
				"url": "https://novicodes.dev",
				"name": "NoviCodes",
				"alternateName": ["CodeRoots", "NoviCodes Academy"],
				"description": "Interactive web development learning platform with an in-browser coding sandbox, 103 hands-on challenges across HTML, CSS, JS, React, Python, and Next.js, and 7 verified proof-of-work certificates.",
				"inLanguage": "en-US",
				"educationalLevel": "Beginner to Advanced",
				"isAccessibleForFree": true,
				"offers": {
					"@type": "Offer",
					"price": "0",
					"priceCurrency": "USD",
					"availability": "https://schema.org/InStock"
				}
			},
			{
				"@type": "Organization",
				"@id": "https://novicodes.dev/#organization",
				"name": "NoviCodes",
				"url": "https://novicodes.dev",
				"logo": "https://novicodes.dev/assets/favicon.png",
				"description": "Open-access, browser-native web development academy dedicated to zero-barrier technical education."
			},
			{
				"@type": "FAQPage",
				"@id": "https://novicodes.dev/#faq",
				"mainEntity": [
					{
						"@type": "Question",
						"name": "What is NoviCodes?",
						"acceptedAnswer": {
							"@type": "Answer",
							"text": "NoviCodes is a 100% free, browser-native web development platform where learners master HTML, CSS, JavaScript, React, Python, and Next.js by completing 103 hands-on coding challenges with zero local setup."
						}
					},
					{
						"@type": "Question",
						"name": "Do I need to install any software to use NoviCodes?",
						"acceptedAnswer": {
							"@type": "Answer",
							"text": "No. NoviCodes runs entirely in your web browser with a built-in sandbox, real-time AST diagnostic linters, and instant preview. No terminal, Node.js, or Docker installation is required."
						}
					},
					{
						"@type": "Question",
						"name": "Are NoviCodes proof-of-work certificates free?",
						"acceptedAnswer": {
							"@type": "Answer",
							"text": "Yes. Learners can earn 7 cryptographic-style Proof-of-Work certificates by completing full project suites across JavaScript, React, Python, Specialization tracks, Async UI, Auth, and Apex SaaS. All certificates are 100% free to earn and download."
						}
					},
					{
						"@type": "Question",
						"name": "Does NoviCodes require an account or track personal data?",
						"acceptedAnswer": {
							"@type": "Answer",
							"text": "No. NoviCodes operates on a client-side architecture where all progress, XP points, and code drafts are safely preserved in browser LocalStorage. No account registration, email, or tracking cookies are used."
						}
					}
				]
			}
		]
	}
	</script>
 
 <!-- Google Fonts: Technical Field Journal Typography -->
 <link rel="preconnect" href="https://fonts.googleapis.com" />
 <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
 <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:ital,wght@0,400;0,500;0,600;1,400&family=IBM+Plex+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400;1,6..72,600&display=swap" rel="stylesheet" />
 
 <!-- SweetAlert2 CDN -->
 <script is:inline src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
 
 <slot name="head" />
</head>
<body class={bodyClass}>
 <slot name="header" />
 
 {noPageContentWrapper ? (
 <slot />
 ) : (
 <main class="page-content">
 <slot />
 </main>
 )}

 {showHeaderFooter && <PlatformFooter />}
 <slot name="footer" />
 
 <UserProfileModal />
<script is:inline>
(function() {
    window.startNoviTypewriter = function() {
        var elements = document.querySelectorAll('.typewriter-text, #typewriterText');
        if (!elements || elements.length === 0) return;

        var defaultPhrases = [
            'Doing, Not Just Watching',
            'Solving 103 Hands-On Challenges',
            'Mastering React & JavaScript',
            'Writing Real Code in Browser',
            'Building Modern Web Interfaces'
        ];

        elements.forEach(function(el) {
            if (el._noviTypewriterRunning) return;
            el._noviTypewriterRunning = true;

            var phrases = defaultPhrases;
            if (el.dataset && el.dataset.phrases) {
                try {
                    var parsed = JSON.parse(el.dataset.phrases);
                    if (Array.isArray(parsed) && parsed.length > 0) {
                        phrases = parsed;
                    }
                } catch (e) {}
            }

            var phraseIdx = 0;
            var currentPhrase = phrases[phraseIdx];
            var charIdx = currentPhrase.length;
            var isDeleting = true;
            var isVisible = true;
            var isLoopActive = false;
            var loopTimer = null;

            el.textContent = currentPhrase;

            function runLoop() {
                // Instantly pause and prevent any CLS layout shifts if scrolled past viewport or tab backgrounded
                if (!isVisible || document.hidden) {
                    isLoopActive = false;
                    return;
                }

                isLoopActive = true;
                currentPhrase = phrases[phraseIdx];

                if (isDeleting) {
                    charIdx--;
                    // Non-breaking space prevents line collapse and zero-layout-shift
                    el.textContent = charIdx <= 0 ? '\u00A0' : currentPhrase.substring(0, charIdx);

                    if (charIdx <= 0) {
                        isDeleting = false;
                        phraseIdx = (phraseIdx + 1) % phrases.length;
                        loopTimer = setTimeout(runLoop, 400);
                        return;
                    }
                    loopTimer = setTimeout(runLoop, 28);
                } else {
                    charIdx++;
                    el.textContent = currentPhrase.substring(0, Math.min(currentPhrase.length, charIdx));

                    if (charIdx >= currentPhrase.length) {
                        isDeleting = true;
                        loopTimer = setTimeout(runLoop, 2200);
                        return;
                    }
                    loopTimer = setTimeout(runLoop, 50);
                }
            }

            function wakeLoop() {
                if (isVisible && !document.hidden && !isLoopActive) {
                    if (loopTimer) clearTimeout(loopTimer);
                    runLoop();
                }
            }

            // IntersectionObserver: automatically stops/pauses when user scrolls past this section
            var targetToObserve = el.closest('.typewriter-wrap') || el.closest('h1') || el.closest('header') || el;
            if ('IntersectionObserver' in window) {
                var observer = new IntersectionObserver(function(entries) {
                    entries.forEach(function(entry) {
                        if (entry.isIntersecting) {
                            isVisible = true;
                            wakeLoop();
                        } else {
                            isVisible = false;
                            isLoopActive = false;
                            if (loopTimer) clearTimeout(loopTimer);
                        }
                    });
                }, {
                    root: null,
                    threshold: 0.05
                });
                observer.observe(targetToObserve);
            } else {
                // Scroll listener fallback for older browsers without IntersectionObserver
                var checkScrollVisibility = function() {
                    var rect = targetToObserve.getBoundingClientRect();
                    var inView = rect.top < window.innerHeight && rect.bottom > 0;
                    if (inView !== isVisible) {
                        isVisible = inView;
                        if (inView) {
                            wakeLoop();
                        } else {
                            isLoopActive = false;
                            if (loopTimer) clearTimeout(loopTimer);
                        }
                    }
                };
                window.addEventListener('scroll', checkScrollVisibility, { passive: true });
                checkScrollVisibility();
            }

            document.addEventListener('visibilitychange', function() {
                if (document.hidden) {
                    isLoopActive = false;
                    if (loopTimer) clearTimeout(loopTimer);
                } else {
                    wakeLoop();
                }
            });

            loopTimer = setTimeout(wakeLoop, 1000);
        });
    };

    if (document.readyState !== 'loading') {
        window.startNoviTypewriter();
    } else {
        document.addEventListener('DOMContentLoaded', window.startNoviTypewriter);
    }
})();
</script>
</body>
</html>
