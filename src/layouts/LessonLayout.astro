---
import BaseLayout from './BaseLayout.astro';
import Icon from '../components/Icon.astro';
import PlatformHeader, { type JumpLessonItem } from '../components/PlatformHeader.astro';
import PlatformFooter from '../components/PlatformFooter.astro';

interface Props {
    title: string;
    description: string;
    levelTag: string;
    lessonNum: number;
    lessonTitle: string;
    xpAmount?: number;
    completionKey: string;
    nextLessonUrl?: string;
    hubUrl: string;
    hubTitle?: string;
    hubIcon?: string;
    fileTab?: string;
    starterCode?: string;
    mode?: 'html' | 'react' | 'python' | 'terminal';
    jumpLessons?: JumpLessonItem[];
    certificateUrl?: string;
    trackPrefix?: string;
}

const {
    title,
    description,
    levelTag,
    lessonNum,
    lessonTitle,
    xpAmount = 100,
    completionKey,
    nextLessonUrl,
    hubUrl,
    hubTitle = 'Level 4 Hub',
    hubIcon = '⚔️',
    fileTab = 'index.html',
    starterCode = '',
    mode = 'html',
    jumpLessons = [],
    certificateUrl,
    trackPrefix = 'partB'
} = Astro.props;

const navLinks = [
    { href: '/', label: 'Roadmap', icon: '🗺️', title: 'Curriculum Roadmap' },
    { href: '/1. partA/hub.html', label: 'Foundations', icon: '📚', title: 'Foundations Academy' },
    { href: 'javascript:void(0)', label: 'Dojo', icon: '⚔️', title: 'Practical Dojo Hub', id: 'dojoNavLink', extraClass: 'dojo-nav-highlight', onClick: 'openDojoHub()' },
    { href: 'javascript:void(0)', label: 'Certs', icon: '📜', title: 'Proof-of-Work Certificates', id: 'certificateNavLink', onClick: 'openCertificateHub()' }
];

const foundationsTrackMap: Record<string, { query: string; name: string; icon: string }> = {
    'partB': { query: 'js', name: 'JavaScript Foundations', },
    'partC': { query: 'react', name: 'React Foundations', },
    'partE': { query: 'python', name: 'Python Foundations', },
    'partF_branchA': { query: 'cloud', name: 'Cloud & CI/CD Foundations', },
    'branchA': { query: 'cloud', name: 'Cloud & CI/CD Foundations', },
    'partF_branchB': { query: 'sql', name: 'SQL & Database Foundations', },
    'branchB': { query: 'sql', name: 'SQL & Database Foundations', },
    'partF_branchC': { query: 'nextjs', name: 'Next.js Foundations', },
    'branchC': { query: 'nextjs', name: 'Next.js Foundations', },
    'partF_branchD': { query: 'typescript', name: 'TypeScript Foundations', },
    'branchD': { query: 'typescript', name: 'TypeScript Foundations', },
    'partF_branchE': { query: 'cssmotion', name: 'CSS Motion Foundations', },
    'branchE': { query: 'cssmotion', name: 'CSS Motion Foundations', },
    'partG': { query: 'async', name: 'Async UI Foundations', },
    'partH': { query: 'auth', name: 'Security & Auth Foundations', },
    'partI': { query: 'saas', name: 'SaaS UI Foundations', },
};

const foundationsRef = foundationsTrackMap[trackPrefix] || foundationsTrackMap['partB'];
const foundationsUrl = `/foundations.html?track=${foundationsRef.query}`;
---

<BaseLayout title={title} description={description} showHeaderFooter={false} noPageContentWrapper={true}>
    <PlatformHeader 
        slot="header"
        tagText={levelTag}
        tagId="headerLogoTag"
        navLinks={navLinks}
        showXpBadge={true}
        showJumpDropdown={jumpLessons.length > 0}
        currentLessonId={lessonNum}
        jumpLessons={jumpLessons}
        certificateUrl={certificateUrl}
        trackPrefix={trackPrefix}
    />

    <!-- Dual 50/50 Lesson Workspace: Natural scroll on both lanes -->
    <main class="lesson-workspace-outer" data-track={trackPrefix} data-lesson-num={lessonNum} data-level-tag={levelTag} data-completion-key={completionKey}>
        <div class="lesson-grid">
            
            <!-- LEFT LANE: Concept, Widgets, Reference Code, Goal // scrolls freely -->
            <section class="lesson-instructions-pane">
                <div class="lesson-header-card">
                    <div class="lesson-badge-row">
                        <span class="lesson-level-pill">{levelTag} // EXERCISE {lessonNum.toString().padStart(2, '0')}</span>
                        <span class="lesson-xp-pill">+{xpAmount} XP BOUNTY</span>
                    </div>
                    <h1 class="lesson-main-title">{lessonTitle}</h1>
                    
                    <!-- Foundations Concept Refresher Dropdown -->
                    <div class="foundations-ref-box">
                        <div class="foundations-ref-header">
                            <span class="ref-label">Reference Guide:</span>
                        </div>
                        <div class="foundations-ref-control">
                            <select class="foundations-ref-select" id="lessonFoundationsSelect" aria-label="Review Foundations Guide in New Tab">
                                <optgroup label="Recommended for this Level">
                                    <option value={foundationsRef.query} selected>
                                        {foundationsRef.name}
                                    </option>
                                </optgroup>
                                <optgroup label="Core Web Foundations">
                                    <option value="history">Level 00: Web Architecture</option>
                                    <option value="html">Level 01: HTML Page Structure</option>
                                    <option value="css">Level 02: CSS Box Model &amp; Flexbox</option>
                                    <option value="js">Level 03: JavaScript Interactivity</option>
                                </optgroup>
                                <optgroup label="Framework &amp; Backend Foundations">
                                    <option value="react">Level 05: React Components &amp; State</option>
                                    <option value="python">Level 06: Python Backend &amp; APIs</option>
                                </optgroup>
                                <optgroup label="Level 07 Specialization Tracks">
                                    <option value="cloud">Level 07A: Cloud Hosting &amp; CI/CD</option>
                                    <option value="sql">Level 07B: SQL Databases &amp; Queries</option>
                                    <option value="nextjs">Level 07C: Next.js App Router</option>
                                    <option value="typescript">Level 07D: TypeScript Mastery</option>
                                    <option value="cssmotion">Level 07E: CSS Motion &amp; Animation</option>
                                </optgroup>
                                <optgroup label="Advanced Architecture">
                                    <option value="async">Level 08: Async UI &amp; Skeletons</option>
                                    <option value="auth">Level 09: User Logins &amp; Security</option>
                                    <option value="saas">Level 10: SaaS Dashboard UI</option>
                                </optgroup>
                            </select>
                            <a href={foundationsUrl} target="_blank" rel="noopener noreferrer" class="ref-open-link-btn" id="openCurrentFoundationsBtn" title={`Open ${foundationsRef.name} in a new tab`}>
                                <span>VIEW GUIDE ↗</span>
                            </a>
                        </div>
                    </div>

                    <slot name="intro" />
                </div>
                <slot name="concept" />
            </section>

            <!-- RIGHT LANE: Sticky IDE Workspace // large editor + large preview -->
            <section class="lesson-ide-pane">
                
                <!-- Code Editor (Large, wrap-based, no h-scroll) -->
                <div class="ide-window">
                    <div class="ide-top-bar">
                        <div class="ide-tab">
                            <span>{fileTab}</span>
                        </div>
                        <div class="ide-controls">
                            <button class="ide-reset-btn" id="resetEditorBtn" title="Reset to starter code">
                                RESET
                            </button>
                        </div>
                    </div>
                    <div class="ide-editor-workspace">
                        <div class="ide-line-numbers" id="ideLineNumbers" aria-hidden="true">
                            <div class="ide-line-numbers-inner" id="ideLineNumbersInner">1</div>
                        </div>
                        <textarea 
                            id="lessonEditor" 
                            class="ide-textarea" 
                            spellcheck="false"
                            placeholder="Write your code here..."
                        >{starterCode}</textarea>
                    </div>
                </div>

                <!-- Live Preview (Large iframe for HTML / Web / React) -->
                {(mode === 'html' || mode === 'react') && (
                    <div class="ide-output-window">
                        <div class="ide-output-header">
                            <span>Live Preview</span>
                            <span class="live-badge"><span class="realtime-dot" style="display:inline-block;width:7px;height:7px;border-radius:50%;background:#16a34a;margin-right:5px;box-shadow:0 0 6px #16a34a;"></span>Real-Time</span>
                        </div>
                        <iframe id="livePreviewIframe" class="ide-preview-iframe" title="Live Preview Result" sandbox="allow-scripts allow-modals allow-same-origin"></iframe>
                    </div>
                )}

                {/* Python Terminal Screen */}
                {mode === 'python' && (
                    <div class="ide-output-window" style="background: #141514; border-color: #2C2D2B;">
                        <div class="ide-output-header" style="background: #1B1C1A; border-color: #2C2D2B; color: #BAB4A6;">
                            <span>Python Terminal &amp; Output</span>
                            <span class="live-badge" style="color: #A33B24;">Python 3.12</span>
                        </div>
                        <div id="terminalScreen" class="ide-terminal-screen" style="padding: 14px; background: #141514; color: #F1EEE7; font-family: var(--font-mono, 'IBM Plex Mono', monospace); font-size: 0.82rem; line-height: 1.5; min-height: 140px; max-height: 280px; overflow-y: auto; white-space: pre-wrap;">
                            <div class="terminal-prompt" style="color: #BAB4A6;">&gt; Python Terminal ready. Click Check &amp; Verify Code to execute main.py</div>
                        </div>
                    </div>
                )}

                {/* Terminal / CLI / Bash / DevOps Output Screen */}
                {(mode === 'terminal' || mode === 'bash' || mode === 'sql') && (
                    <div class="ide-output-window" style="background: #141514; border-color: #2C2D2B;">
                        <div class="ide-output-header" style="background: #1B1C1A; border-color: #2C2D2B; color: #BAB4A6;">
                            <span>CLI / Terminal Output</span>
                            <span class="live-badge" style="color: #A33B24;">Terminal</span>
                        </div>
                        <div id="terminalScreen" class="ide-terminal-screen" style="padding: 14px; background: #141514; color: #F1EEE7; font-family: var(--font-mono, 'IBM Plex Mono', monospace); font-size: 0.82rem; line-height: 1.5; min-height: 140px; max-height: 280px; overflow-y: auto; white-space: pre-wrap;">
                            <div class="terminal-prompt" style="color: #BAB4A6;">&gt; Terminal ready. Click Check &amp; Verify Code to execute commands.</div>
                        </div>
                    </div>
                )}

                <!-- Lint Panel -->
                <div id="lintPanel"></div>

                <!-- Action Bar -->
                <div class="ide-action-bar">
                    <button class="verify-code-btn" id="checkAnswerBtn">
                        <span>Check &amp; Verify Code</span>
                    </button>
                    {nextLessonUrl ? (
                        <a href={nextLessonUrl} class="next-action-btn" id="nextLessonBtn">
                            <span>Continue ➔</span>
                        </a>
                    ) : (
                        <a href={hubUrl} class="next-action-btn active" id="nextLessonBtn">
                            <span>Complete Dojo 🏆</span>
                        </a>
                    )}
                </div>

            </section>
        </div>
    </main>

    <PlatformFooter />

    <script is:inline src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
    <script>
        import { checkLessonAccessAndRenderOverlay } from '../scripts/dojo/core/protection';

        // ── Direct URL Access Protection & Tampering Prevention ──
        const mainEl = document.querySelector('.lesson-workspace-outer') as HTMLElement | null;
        if (mainEl) {
            const track = mainEl.dataset.track || 'partB';
            const lessonNum = parseInt(mainEl.dataset.lessonNum || '1', 10);
            const levelTag = mainEl.dataset.levelTag || 'Lesson';

            checkLessonAccessAndRenderOverlay({
                track,
                lessonNum,
                levelTag
            });
        }

        // ── Next Lesson / Continue Button Guard & Persistence Sync ──
        const nextBtn = document.getElementById('nextLessonBtn') as HTMLAnchorElement | null;
        if (nextBtn) {
            const compKey = mainEl?.dataset.completionKey;
            if (compKey && localStorage.getItem(compKey) === 'true') {
                nextBtn.classList.remove('locked', 'disabled');
                nextBtn.classList.add('active');
            }

            nextBtn.addEventListener('click', (e) => {
                if (!nextBtn.classList.contains('active')) {
                    e.preventDefault();
                    e.stopPropagation();
                    return false;
                }
            });
        }

        // Global Foundations Concept Dropdown Sync Handler
        const foundationsSelect = document.getElementById('lessonFoundationsSelect') as HTMLSelectElement | null;
        const openFoundationsBtn = document.getElementById('openCurrentFoundationsBtn') as HTMLAnchorElement | null;

        if (foundationsSelect) {
            foundationsSelect.addEventListener('change', () => {
                const val = foundationsSelect.value;
                if (!val) return;
                let targetUrl = `/foundations.html?track=${encodeURIComponent(val)}`;
                if (val === 'history') {
                    targetUrl = '/1. partA/web_history.html';
                }
                if (openFoundationsBtn) {
                    openFoundationsBtn.href = targetUrl;
                }
            });
        }

        // Global Copy Reference Code Snippet Handler (Handles both .copy-code-btn and .snippet-copy-btn)
        document.addEventListener('click', (e) => {
            const btn = (e.target as HTMLElement).closest('.copy-code-btn, .snippet-copy-btn');
            if (btn) {
                const targetId = btn.getAttribute('data-target');
                let textToCopy = '';
                if (targetId) {
                    const targetEl = document.getElementById(targetId);
                    textToCopy = targetEl ? targetEl.textContent || '' : '';
                } else {
                    const box = btn.closest('.code-snippet-box') || btn.closest('.concept-card');
                    const codeEl = box ? box.querySelector('code') : null;
                    textToCopy = codeEl ? codeEl.textContent || '' : '';
                }

                if (!textToCopy) return;

                const markSuccess = () => {
                    const originalHtml = btn.innerHTML;
                    btn.innerHTML = '<span>✅ Copied!</span>';
                    btn.classList.add('copied');
                    setTimeout(() => {
                        btn.innerHTML = originalHtml;
                        btn.classList.remove('copied');
                    }, 2000);
                };

                if (navigator.clipboard && navigator.clipboard.writeText) {
                    navigator.clipboard.writeText(textToCopy).then(markSuccess).catch(() => {
                        fallbackCopy(textToCopy, markSuccess);
                    });
                } else {
                    fallbackCopy(textToCopy, markSuccess);
                }
            }
        });

        function fallbackCopy(text: string, cb: () => void) {
            const ta = document.createElement('textarea');
            ta.value = text;
            ta.style.position = 'fixed';
            ta.style.opacity = '0';
            document.body.appendChild(ta);
            ta.select();
            try {
                document.execCommand('copy');
                cb();
            } catch (err) {
                console.error('Fallback copy failed', err);
            }
            document.body.removeChild(ta);
        }
    </script>
    <slot name="scripts" />
</BaseLayout>
