---
interface Props {
 brandName?: string;
 tagline?: string;
}

const { 
 brandName = 'NoviCodes',
 tagline = 'An open, practical curriculum for web development. Practice directly in your browser with zero setup.'
} = Astro.props;
---

<footer class="platform-footer" id="footer" aria-label="Platform Footer">
 <div class="footer-inner">
 <!-- Column 1: Brand & Mission -->
 <div class="footer-col footer-col-brand">
 <a href="/" class="platform-logo" aria-label="NoviCodes Field Journal Home">
 <img src="/assets/logo.jpg" alt="NoviCodes Logo" class="brand-logo-img" width="28" height="28" loading="lazy" />
 <div class="logo-text">
 <span class="logo-title"><span class="title-novi">Novi</span><span class="title-codes">Codes</span></span>
 <span class="logo-tag">Field Guide // Vol. 2.5</span>
 </div>
 </a>
 <p class="footer-mission-text">{tagline}</p>
 <div class="footer-badges-wrap">
 <span class="footer-badge-pill">MIT License</span>
 <span class="footer-badge-pill">100% Free</span>
 </div>

 <!-- Support Ra Labs Creator Section -->
 <div class="footer-support-wrap">
 <span class="footer-support-title">Support the Creator:</span>
 <div class="footer-support-btns">
 <a href="https://ko-fi.com/ralabs" target="_blank" rel="noopener noreferrer" class="support-pill-btn kofi" title="Buy Ra Labs a Coffee (Global / USD)">
 <span class="support-pill-text">Ko-fi (Global) →</span>
 </a>
 <a href="https://trakteer.id/ra-labs" target="_blank" rel="noopener noreferrer" class="support-pill-btn trakteer" title="Support Ra Labs on Trakteer (IDR / QRIS)">
 <span class="support-pill-text">Trakteer (IDR) →</span>
 </a>
 </div>
 </div>
 </div>

 <!-- Column 2: Foundations -->
 <div class="footer-col">
 <h3 class="footer-heading">01 / Foundations</h3>
 <ul class="footer-nav-list">
 <li><a href="/1. partA/web_history.html">Level 00 • How the Web Works</a></li>
 <li><a href="/foundations.html?track=html">Level 01 • HTML Page Structure</a></li>
 <li><a href="/foundations.html?track=css">Level 02 • CSS Box Model &amp; Flexbox</a></li>
 <li><a href="/foundations.html?track=js">Level 03 • JavaScript Interactivity</a></li>
 <li><a href="/foundations.html?track=typescript">Level 07D • TypeScript Mastery</a></li>
 <li><a href="/foundations.html?track=cssmotion">Level 07E • CSS Motion &amp; Animation</a></li>
 <li><a href="/1. partA/hub.html">Browse All 13 Foundations →</a></li>
 </ul>
 </div>

 <!-- Column 3: Practice Workbench -->
 <div class="footer-col">
 <h3 class="footer-heading">02 / Practice Workbench</h3>
 <ul class="footer-nav-list">
 <li><a href="/2. partB/hub.html">Level 04 • JavaScript Widget Dojo</a></li>
 <li><a href="/3. partC/hub.html">Level 05 • React Component Dojo</a></li>
 <li><a href="/5. partE/hub.html">Level 06 • Python &amp; Backend Basics</a></li>
 <li><a href="/6. partF/hub.html">Level 07 • Specialized Tracks</a></li>
 <li><a href="/7. partG/hub.html">Level 08 • UI States: Skeletons &amp; Errors</a></li>
 <li><a href="/8. partH/hub.html">Level 09 • Auth &amp; Protected Routes</a></li>
 <li><a href="/9. partI/hub.html">Level 10 • SaaS Dashboard Project</a></li>
 <li><a href="/4. partD/devtype/devtype.html">DevType Typing Speedrun</a></li>
 </ul>
 </div>

 <!-- Column 4: Platform & Legal -->
 <div class="footer-col">
 <h3 class="footer-heading">03 / Platform &amp; Legal</h3>
 <ul class="footer-nav-list">
 <li><a href="/#dailyQuestSection">Daily 2-Minute Quests</a></li>
 <li><a href="javascript:void(0)" onclick="if(typeof openCertificateHub==='function'){openCertificateHub();}else if(typeof window.openCertificateHub==='function'){window.openCertificateHub();}else{window.location.href='/9. partI/certificate.html';}">Proof-of-Work Certificates</a></li>
 <li><a href="https://ko-fi.com/ralabs" target="_blank" rel="noopener noreferrer">Support via Ko-fi (Global) ↗</a></li>
 <li><a href="https://trakteer.id/ra-labs" target="_blank" rel="noopener noreferrer">Support via Trakteer (IDR) ↗</a></li>
 <li><a href="/privacy.html" target="_blank" rel="noopener noreferrer">Privacy Policy</a></li>
 <li><a href="/terms.html" target="_blank" rel="noopener noreferrer">Terms of Use</a></li>
 <li><a href="/disclaimer.html" target="_blank" rel="noopener noreferrer">Disclaimer</a></li>
 <li><a href="https://rifaim.github.io/Portfolio" target="_blank" rel="noopener noreferrer">Creator Portfolio ↗</a></li>
 </ul>
 </div>
 </div>

 <!-- Bottom Copyright Row -->
 <div class="footer-bottom">
 <div class="footer-bottom-inner">
 <p class="copyright-text">© 2026 {brandName} • Open Curriculum for Learners Worldwide</p>
 </div>
 </div>
</footer>

<style is:global>
 /* ==========================================================================
 Master Platform Footer System (Archival Colophon)
 ========================================================================== */
 .platform-footer {
 background: var(--card-elevated);
 border-top: 1px solid var(--border-subtle);
 padding: 48px 24px 32px 24px;
 margin-top: 60px;
 font-family: var(--font-sans);
 color: var(--text-body);
 width: 100%;
 box-sizing: border-box;
 }

 .footer-inner {
 max-width: 1140px;
 margin: 0 auto;
 display: grid;
 grid-template-columns: 1.8fr 1.2fr 1.2fr 1.2fr;
 gap: 36px;
 padding-bottom: 32px;
 border-bottom: 1px solid var(--border-subtle);
 box-sizing: border-box;
 align-items: start;
 }

 /* Column 1: Brand */
 .footer-col-brand {
 display: flex;
 flex-direction: column;
 align-items: flex-start;
 }

 .footer-col-brand .platform-logo {
 display: inline-flex;
 align-items: center;
 gap: 10px;
 text-decoration: none;
 margin-bottom: 12px;
 }

 .footer-col-brand .brand-logo-img {
 width: 28px;
 height: 28px;
 border-radius: 2px;
 border: 1px solid var(--border-subtle);
 object-fit: cover;
 }

 .footer-mission-text {
 font-size: 0.86rem;
 line-height: 1.6;
 color: var(--text-muted);
 margin: 0 0 16px 0;
 max-width: 320px;
 }

 .footer-badges-wrap {
 display: flex;
 align-items: center;
 gap: 6px;
 flex-wrap: wrap;
 }

 .footer-badge-pill {
 display: inline-flex;
 align-items: center;
 gap: 4px;
 background: var(--canvas-base);
 border: 1px solid var(--border-subtle);
 padding: 2px 7px;
 border-radius: 2px;
 font-family: var(--font-mono);
 font-size: 0.70rem;
 font-weight: 500;
 color: var(--text-muted);
 text-transform: uppercase;
 letter-spacing: 0.04em;
 }

 /* Creator Support Section in Footer */
 .footer-support-wrap {
 margin-top: 16px;
 display: flex;
 flex-direction: column;
 gap: 6px;
 width: 100%;
 max-width: 320px;
 }

 .footer-support-title {
 font-family: var(--font-mono);
 font-size: 0.72rem;
 font-weight: 600;
 text-transform: uppercase;
 letter-spacing: 0.05em;
 color: var(--accent-oxide);
 }

 .footer-support-btns {
 display: flex;
 gap: 8px;
 flex-wrap: wrap;
 }

 .support-pill-btn {
 display: inline-flex;
 align-items: center;
 padding: 6px 12px;
 border-radius: 2px;
 font-family: var(--font-mono);
 font-size: 0.74rem;
 font-weight: 600;
 text-transform: uppercase;
 letter-spacing: 0.03em;
 text-decoration: none;
 transition: all 0.15s ease;
 }

 .support-pill-btn.kofi {
 background: var(--canvas-base);
 border: 1px solid var(--border-subtle);
 color: var(--text-title);
 }

 .support-pill-btn.kofi:hover {
 background: var(--surface-muted);
 border-color: var(--border-dark);
 color: var(--accent-oxide);
 }

 .support-pill-btn.trakteer {
 background: var(--accent-oxide);
 border: 1px solid var(--accent-oxide);
 color: #F8F6F1;
 }

 .support-pill-btn.trakteer:hover {
 background: var(--accent-oxide-hover);
 border-color: var(--accent-oxide-hover);
 }

 .support-direct-link:hover {
 color: #be185d !important;
 }

 /* Navigation Link Columns */
 .footer-heading {
 font-size: 0.84rem;
 font-weight: 800;
 text-transform: uppercase;
 letter-spacing: 0.6px;
 color: #0f172a;
 margin: 0 0 16px 0;
 display: flex;
 align-items: center;
 gap: 6px;
 height: 24px;
 }

 .footer-nav-list {
 list-style: none;
 padding: 0;
 margin: 0;
 display: flex;
 flex-direction: column;
 gap: 11px;
 }

 .footer-nav-list li {
 margin: 0;
 padding: 0;
 }

 .footer-nav-list li a {
 color: #64748b;
 text-decoration: none;
 font-size: 0.88rem;
 font-weight: 600;
 transition: all 0.2s ease;
 display: inline-block;
 line-height: 1.4;
 }

 .footer-nav-list li a:hover {
 color: #2563eb;
 transform: translateX(3px);
 }

 /* Bottom Copyright & Status Bar */
 .footer-bottom {
 max-width: 1240px;
 margin: 24px auto 0 auto;
 box-sizing: border-box;
 }

 .footer-bottom-inner {
 display: flex;
 align-items: center;
 justify-content: center;
 text-align: center;
 }

 .copyright-text {
 font-size: 0.82rem;
 color: #94a3b8;
 margin: 0;
 font-weight: 500;
 text-align: center;
 }

 /* ==========================================================================
 Responsive Breakpoints (Desktop, Tablet & Mobile 320px-768px)
 ========================================================================== */

 @media (max-width: 1024px) {
 .footer-inner {
 grid-template-columns: 1.5fr 1fr 1fr 1fr;
 gap: 24px;
 }
 }

 @media (max-width: 860px) {
 .footer-inner {
 grid-template-columns: 1fr 1fr;
 gap: 32px 24px;
 }
 .footer-col-brand {
 grid-column: 1 / -1;
 max-width: 100%;
 }
 .footer-mission-text {
 max-width: 100%;
 }
 }

 @media (max-width: 576px) {
 .platform-footer {
 padding: 36px 16px 20px 16px;
 margin-top: 40px;
 }
 .footer-inner {
 grid-template-columns: 1fr;
 gap: 26px;
 padding-bottom: 24px;
 }
 .footer-heading {
 margin-bottom: 12px;
 font-size: 0.82rem;
 }
 .footer-nav-list {
 gap: 9px;
 }
 .footer-nav-list li a {
 font-size: 0.85rem;
 padding: 2px 0;
 }
 .footer-bottom-inner {
 flex-direction: column;
 align-items: flex-start;
 gap: 10px;
 }
 }
</style>
