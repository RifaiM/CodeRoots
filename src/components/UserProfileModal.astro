        function initDevKitShortcuts() {
            if ((window as any)._novicodes_devkit_installed) return;
            (window as any)._novicodes_devkit_installed = true;

            let isToggling = false;

            // 1. Five rapid clicks on navbar logo (or logo icon/title)
            const logos = document.querySelectorAll('.platform-logo, .brand-logo, .logo-title, .header-brand, .logo-icon, .logo-text');
            let logoClicks = 0;
            let logoClickTimer: any = null;

            logos.forEach(logo => {
                logo.addEventListener('click', (e) => {
                    logoClicks++;

                    if (logoClicks > 1 && logoClicks < 5) {
                        // Prevent link navigation during rapid tapping sequence
                        e.preventDefault();
                        if (logoClickTimer) clearTimeout(logoClickTimer);
                        logoClickTimer = setTimeout(() => {
                            logoClicks = 0;
                        }, 1200);
                    } else if (logoClicks >= 5) {
                        // 5 Rapid Clicks Reached! Prevent navigation and trigger Dev Mode toggle
                        e.preventDefault();
                        e.stopPropagation();
                        if (logoClickTimer) clearTimeout(logoClickTimer);
                        logoClicks = 0;

                        if (isToggling) return;
                        isToggling = true;
                        setTimeout(() => { isToggling = false; }, 800);

                        const isCurrentlyUnlocked = localStorage.getItem('practice_mode_unlocked') === 'true';
                        if (isCurrentlyUnlocked) {
                            (window as any).NoviCodes.lockAll();
                        } else {
                            (window as any).NoviCodes.unlockAll();
                        }
                    } else {
                        // First click: wait 350ms before clearing counter if no second click follows
                        if (logoClickTimer) clearTimeout(logoClickTimer);
                        logoClickTimer = setTimeout(() => {
                            logoClicks = 0;
                        }, 1200);
                    }
                });
            });

            // 2. Keyboard shortcut Ctrl + Alt + D
            window.addEventListener('keydown', (e) => {
                if (e.ctrlKey && e.altKey && (e.key === 'd' || e.key === 'D' || e.code === 'KeyD')) {
                    e.preventDefault();
                    e.stopPropagation();
                    if (isToggling) return;
                    isToggling = true;
                    setTimeout(() => { isToggling = false; }, 800);

                    const isCurrentlyUnlocked = localStorage.getItem('practice_mode_unlocked') === 'true';
                    if (isCurrentlyUnlocked) {
                        (window as any).NoviCodes.lockAll();
                    } else {
                        (window as any).NoviCodes.unlockAll();
                    }
                }
            }, { capture: true });
        }

        // Initialize keyboard shortcuts & triggers
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', () => initDevKitShortcuts());
        } else {
            initDevKitShortcuts();
        }
    }

    // Hydrate all user stats badges on page load & listen for real-time events
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', () => updateAllHeaderStats());
    } else {
        updateAllHeaderStats();
    }

    // Real-time event listeners for instant reactive sync
    window.addEventListener('novicodes:xp_updated', () => updateAllHeaderStats());
    window.addEventListener('storage', () => updateAllHeaderStats());
    window.addEventListener('pageshow', () => updateAllHeaderStats());
</script>

