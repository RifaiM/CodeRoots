 console.log('%c [NoviCodes DevKit] Strict sequential progression & 0 XP RESTORED.', 'color: #ef4444; font-weight: 800; font-size: 14px;');
 updateAllHeaderStats();
 window.dispatchEvent(new CustomEvent('novicodes:xp_updated'));

 if (typeof (window as any).Swal !== 'undefined') {
 (window as any).Swal.fire({
 icon: 'info',
 title: 'Standard Mode Restored',
 html: `
 <div style="text-align: center; font-family: var(--font-sans, sans-serif);">
 <p style="color: var(--text-body, #20211F); margin-bottom: 14px; font-size: 0.90rem; line-height: 1.5;">
 Strict sequential progression and <strong>0 XP</strong> have been restored across all levels (0–10).
 </p>
 </div>
 `,
 confirmButtonColor: '#A33B24',
 confirmButtonText: 'Reload to Apply →',
 showCancelButton: true,
 cancelButtonText: 'Stay on Current Page',
 allowOutsideClick: true,
 allowEscapeKey: true
 }).then((res: any) => {
 if (res.isConfirmed) {
 window.location.reload();
 }
 });
 } else {
 window.location.reload();
 }
 },

 maxXP: function() {
 (this as any).unlockAll();
 localStorage.setItem('novicodes_daily_quest_xp', '2500');
 localStorage.setItem('novicodes_streak_bonus_xp', '1000');
 console.log('%c [NoviCodes DevKit] Max XP and Grand Master rank applied!', 'color: #f59e0b; font-weight: 800; font-size: 14px;');
 },

 status: function() {
 const stats = getUserXPAndRank();
 const isDev = localStorage.getItem('practice_mode_unlocked') === 'true';
 console.log('%c [NoviCodes Status Report]', 'color: #3b82f6; font-weight: 800; font-size: 14px;');
 console.table({
 'Dev Mode Unlocked': isDev ? 'YES' : 'NO',
 'Total XP': stats.totalXP.toLocaleString() + ' / ' + stats.maxXP.toLocaleString() + ' XP',
 'Rank': stats.rankTitle + ' ' + stats.rankIcon,
 'Level 0 (History)': stats.isL0 ? 'Completed' : 'Pending',
 'Level 1 (HTML)': stats.isL1 ? 'Completed' : 'Pending',
 'Level 2 (CSS)': stats.isL2 ? 'Completed' : 'Pending',
 'Level 3 (JS)': stats.isL3 ? 'Completed' : 'Pending',
 'Level 4 (DOM Dojo)': `${stats.l4Completed}/15 Lessons`,
 'Level 5 (React Dojo)': `${stats.l5Completed}/15 Lessons`,
 'Level 6 (Python Dojo)': `${stats.l6Completed}/15 Lessons`,
 'Level 7 (Mastery Dojo)': `${stats.l7Completed}/40 Lessons (A:${stats.l7BranchA}/6, B:${stats.l7BranchB}/6, C:${stats.l7BranchC}/6, D:${stats.l7BranchD}/12, E:${stats.l7BranchE}/10)`,
 'Level 8 (API Bridge)': `${stats.l8Completed || 0}/6 Lessons`,
 'Level 9 (Auth & DB)': `${stats.l9Completed || 0}/6 Lessons`,
 'Level 10 (SaaS Dashboard UI)': `${stats.l10Completed || 0}/6 Lessons`
 });
 }
 };

 function initDevKitShortcuts() {
 if ((window as any)._novicodes_devkit_installed) return;
 (window as any)._novicodes_devkit_installed = true;

 let isToggling = false;

 // 1. Five rapid clicks on navbar logo (or logo icon/title)
 const logos = document.querySelectorAll('.platform-logo, .brand-logo, .logo-title, .header-brand, .logo-icon, .logo-text');
 let logoClicks = 0;
 let logoClickTimer: any = null;

 logos.forEach(logo => {
 logo.addEventListener('click', (e) => {
 logoClicks++;

 if (logoClicks > 1 && logoClicks < 5) {
 // Prevent link navigation during rapid tapping sequence
 e.preventDefault();
 if (logoClickTimer) clearTimeout(logoClickTimer);
 logoClickTimer = setTimeout(() => {
 logoClicks = 0;
 }, 1200);
 } else if (logoClicks >= 5) {
 // 5 Rapid Clicks Reached! Prevent navigation and trigger Dev Mode toggle
 e.preventDefault();
 e.stopPropagation();
 if (logoClickTimer) clearTimeout(logoClickTimer);
 logoClicks = 0;

 if (isToggling) return;
 isToggling = true;
 setTimeout(() => { isToggling = false; }, 800);

 const isCurrentlyUnlocked = localStorage.getItem('practice_mode_unlocked') === 'true';
 if (isCurrentlyUnlocked) {
 (window as any).NoviCodes.lockAll();
 } else {
 (window as any).NoviCodes.unlockAll();
 }
 } else {
 // First click: wait 350ms before clearing counter if no second click follows
 if (logoClickTimer) clearTimeout(logoClickTimer);
 logoClickTimer = setTimeout(() => {
 logoClicks = 0;
 }, 1200);
 }
 });
 });

 // 2. Keyboard shortcut Ctrl + Alt + D
 window.addEventListener('keydown', (e) => {
 if (e.ctrlKey && e.altKey && (e.key === 'd' || e.key === 'D' || e.code === 'KeyD')) {
 e.preventDefault();
 e.stopPropagation();
 if (isToggling) return;
 isToggling = true;
 setTimeout(() => { isToggling = false; }, 800);

 const isCurrentlyUnlocked = localStorage.getItem('practice_mode_unlocked') === 'true';
 if (isCurrentlyUnlocked) {
 (window as any).NoviCodes.lockAll();
 } else {
 (window as any).NoviCodes.unlockAll();
 }
 }
 }, { capture: true });
 }

 // Initialize keyboard shortcuts & triggers
 if (document.readyState === 'loading') {
 document.addEventListener('DOMContentLoaded', () => initDevKitShortcuts());
 } else {
 initDevKitShortcuts();
 }
 }

 // Hydrate all user stats badges on page load & listen for real-time events
 if (document.readyState === 'loading') {
 document.addEventListener('DOMContentLoaded', () => updateAllHeaderStats());
 } else {
 updateAllHeaderStats();
 }

 // Real-time event listeners for instant reactive sync
 window.addEventListener('novicodes:xp_updated', () => updateAllHeaderStats());
 window.addEventListener('storage', () => updateAllHeaderStats());
 window.addEventListener('pageshow', () => updateAllHeaderStats());
</script>

