---
// UserProfileModal.astro - Master Interactive SweetAlert2 Modals Hub (Universal across all pages)
---

<script>
 import { getUserXPAndRank, updateAllHeaderStats } from '../scripts/xpEngine';

 declare global {
 interface Window {
 openUserProfileModal: () => void;
 openCertificateHub: () => void;
 openDojoHub: () => void;
 openStreakModal: () => void;
 showCertLockWarning: (title: string, completedCount: number, maxCount: number) => void;
 confirmResetProgress: () => void;
 getUserXPAndRank: typeof getUserXPAndRank;
 updateHeaderStats: typeof updateAllHeaderStats;
 Swal: any;
 }
 }

 window.getUserXPAndRank = getUserXPAndRank;
 window.updateHeaderStats = updateAllHeaderStats;

 // ── 1. Learner Profile & Developer Rank Modal ──
 window.openUserProfileModal = function() {
 const stats = getUserXPAndRank();
 const progressPct = Math.min(Math.round((stats.totalXP / stats.maxXP) * 100), 100);

 const ranks = [
 { title: 'Web Explorer', level: 'Level 00 • Web Architecture' },
 { title: 'Code Apprentice', level: 'Levels 01–03 • HTML, CSS & JS' },
 { title: 'DOM Challenger', level: 'Level 04 • JS Widget Dojo' },
 { title: 'React Engineer', level: 'Level 05 • React Component Dojo' },
 { title: 'Python Backend Engineer', level: 'Level 06 • Python Backend Basics' },
 { title: 'Principal Polymath', level: 'Level 07 • Specialized Tracks' },
 { title: 'Async UI Specialist', level: 'Level 08 • Async UI & Loading' },
 { title: 'React Auth Specialist', level: 'Level 09 • User Logins & Auth' },
 { title: 'Master Web Developer', level: 'Level 10 • SaaS Dashboard UI' }
 ];

 const currentRankTitle = stats.rankTitle;

 const rankLadderHTML = ranks.map((r, idx) => {
 const isCurrent = currentRankTitle === r.title || 
 (r.title === 'DOM Challenger' && currentRankTitle === 'Dojo Master') ||
 (r.title === 'React Engineer' && currentRankTitle === 'Fullstack Master') ||
 (r.title === 'Principal Polymath' && ['Cloud Specialist', 'Database Architect', 'Next.js Engineer', 'TypeScript Specialist', 'CSS Motion Specialist', 'Principal Polymath'].includes(currentRankTitle)) ||
 (r.title === 'Async UI Specialist' && ['Async UI Specialist', 'API Integration Specialist'].includes(currentRankTitle)) ||
 (r.title === 'React Auth Specialist' && ['React Auth Specialist', 'Security Engineer'].includes(currentRankTitle)) ||
 (r.title === 'Master Web Developer' && ['Master Web Developer', 'SaaS UI Architect'].includes(currentRankTitle));
 
 const bg = isCurrent ? 'background: var(--card-bg, #FFFFFF); border: 1px solid var(--accent-oxide, #A33B24);' : 'background: var(--canvas-base, #F1EEE7); border: 1px solid var(--border-subtle, #D5D0C6);';
 const badgeStyle = isCurrent ? 'background: var(--accent-oxide, #A33B24); color: #F8F6F1;' : 'background: var(--border-hairline, #E5E1D8); color: var(--text-muted, #686760);';
 const badgeText = isCurrent ? 'ACTIVE' : 'LOCKED';

 return `
 <div style="${bg} padding: 8px 12px; border-radius: 2px; display: flex; align-items: center; justify-content: space-between; gap: 8px; flex-wrap: wrap;">
 <div style="text-align: left;">
 <div style="font-family: var(--font-mono, monospace); font-size: 0.72rem; color: var(--text-muted, #686760); text-transform: uppercase;">0${idx + 1}. // ${r.level}</div>
 <div style="font-weight: 600; font-size: 0.88rem; color: ${isCurrent ? 'var(--accent-oxide, #A33B24)' : 'var(--text-title, #20211F)'};">${r.title}</div>
 </div>
 <span style="${badgeStyle} font-family: var(--font-mono, monospace); font-size: 0.68rem; font-weight: 600; padding: 2px 6px; border-radius: 2px; text-transform: uppercase; letter-spacing: 0.04em;">${badgeText}</span>
 </div>
 `;
 }).join('');

 if (typeof window.Swal !== 'undefined') {
 window.Swal.fire({
 title: 'Learner Profile & Curriculum Record',
 html: `
 <div style="font-family: var(--font-sans, sans-serif); text-align: center; max-width: 100%; box-sizing: border-box;">
 
 <!-- Rank Banner -->
 <div style="background: var(--carbon, #20211F); color: #F8F6F1; padding: 18px 16px; border-radius: 2px; margin-bottom: 16px; border: 1px solid var(--border-subtle, #D5D0C6); text-align: left;">
 <div style="font-family: var(--font-mono, monospace); font-size: 0.72rem; color: #BAB4A6; text-transform: uppercase; letter-spacing: 0.05em;">DEVELOPER RANK // VERIFIED STATUS</div>
 <div style="font-family: var(--font-serif, serif); font-size: 1.45rem; font-weight: 500; margin: 2px 0 6px 0; color: #FFFFFF;">${stats.rankTitle}</div>
 <div style="font-family: var(--font-mono, monospace); font-size: 0.82rem; color: #D5D0C6;">TOTAL BOUNTY: ${stats.totalXP.toLocaleString()} / ${stats.maxXP.toLocaleString()} XP (${progressPct}%)</div>
 
 <!-- Progress Bar -->
 <div style="background: rgba(255,255,255,0.15); height: 4px; border-radius: 2px; margin-top: 12px; overflow: hidden;">
 <div style="background: var(--accent-oxide, #A33B24); height: 100%; width: ${progressPct}%; transition: width 0.4s ease;"></div>
 </div>
 </div>

 <!-- Section: Breakdown Grid -->
 <div style="text-align: left; margin-bottom: 8px;">
 <div style="font-family: var(--font-mono, monospace); font-size: 0.72rem; font-weight: 600; color: var(--text-muted, #686760); text-transform: uppercase; letter-spacing: 0.05em;">
 01 / CURRICULUM LEVEL BREAKDOWN
 </div>
 </div>

 <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 8px; text-align: left; margin-bottom: 16px;">
 <div style="background: var(--canvas-base, #F1EEE7); border: 1px solid var(--border-subtle, #D5D0C6); padding: 8px 10px; border-radius: 2px;">
 <div style="font-family: var(--font-mono, monospace); font-size: 0.68rem; color: var(--text-muted, #686760);">Level 00: Web Architecture</div>
 <div style="font-family: var(--font-mono, monospace); font-size: 0.82rem; font-weight: 600; color: var(--text-title, #20211F);">${(stats.l0XP || 0).toLocaleString()} / 250 XP</div>
 </div>
 <div style="background: var(--canvas-base, #F1EEE7); border: 1px solid var(--border-subtle, #D5D0C6); padding: 8px 10px; border-radius: 2px;">
 <div style="font-family: var(--font-mono, monospace); font-size: 0.68rem; color: var(--text-muted, #686760);">Levels 01–03: Foundations</div>
 <div style="font-family: var(--font-mono, monospace); font-size: 0.82rem; font-weight: 600; color: var(--text-title, #20211F);">${((stats.isL1 ? 300 : 0) + (stats.isL2 ? 300 : 0) + (stats.isL3 ? 400 : 0))} / 1,000 XP</div>
 </div>
 <div style="background: var(--canvas-base, #F1EEE7); border: 1px solid var(--border-subtle, #D5D0C6); padding: 8px 10px; border-radius: 2px;">
 <div style="font-family: var(--font-mono, monospace); font-size: 0.68rem; color: var(--text-muted, #686760);">Level 04: JS Widget Dojo</div>
 <div style="font-family: var(--font-mono, monospace); font-size: 0.82rem; font-weight: 600; color: var(--text-title, #20211F);">${stats.l4Completed * 100} / 1,500 XP</div>
 </div>
 <div style="background: var(--canvas-base, #F1EEE7); border: 1px solid var(--border-subtle, #D5D0C6); padding: 8px 10px; border-radius: 2px;">
 <div style="font-family: var(--font-mono, monospace); font-size: 0.68rem; color: var(--text-muted, #686760);">Level 05: React Component Dojo</div>
 <div style="font-family: var(--font-mono, monospace); font-size: 0.82rem; font-weight: 600; color: var(--text-title, #20211F);">${stats.l5Completed * 150} / 2,250 XP</div>
 </div>
 <div style="background: var(--canvas-base, #F1EEE7); border: 1px solid var(--border-subtle, #D5D0C6); padding: 8px 10px; border-radius: 2px;">
 <div style="font-family: var(--font-mono, monospace); font-size: 0.68rem; color: var(--text-muted, #686760);">Level 06: Python Backend Basics</div>
 <div style="font-family: var(--font-mono, monospace); font-size: 0.82rem; font-weight: 600; color: var(--text-title, #20211F);">${stats.l6Completed * 200} / 3,000 XP</div>
 </div>
 <div style="background: var(--canvas-base, #F1EEE7); border: 1px solid var(--border-subtle, #D5D0C6); padding: 8px 10px; border-radius: 2px;">
 <div style="font-family: var(--font-mono, monospace); font-size: 0.68rem; color: var(--text-muted, #686760);">Level 07: Specialized Tracks</div>
 <div style="font-family: var(--font-mono, monospace); font-size: 0.82rem; font-weight: 600; color: var(--text-title, #20211F);">${(stats.l7XP || 0).toLocaleString()} / 7,800 XP</div>
 </div>
 <div style="background: var(--canvas-base, #F1EEE7); border: 1px solid var(--border-subtle, #D5D0C6); padding: 8px 10px; border-radius: 2px;">
 <div style="font-family: var(--font-mono, monospace); font-size: 0.68rem; color: var(--text-muted, #686760);">Level 08: Async UI & Skeletons</div>
 <div style="font-family: var(--font-mono, monospace); font-size: 0.82rem; font-weight: 600; color: var(--text-title, #20211F);">${(stats.l8Completed || 0) * 250} / 1,500 XP</div>
 </div>
 <div style="background: var(--canvas-base, #F1EEE7); border: 1px solid var(--border-subtle, #D5D0C6); padding: 8px 10px; border-radius: 2px;">
 <div style="font-family: var(--font-mono, monospace); font-size: 0.68rem; color: var(--text-muted, #686760);">Level 09: User Logins & Auth</div>
 <div style="font-family: var(--font-mono, monospace); font-size: 0.82rem; font-weight: 600; color: var(--text-title, #20211F);">${(stats.l9Completed || 0) * 250} / 1,500 XP</div>
 </div>
 <div style="background: var(--canvas-base, #F1EEE7); border: 1px solid var(--border-subtle, #D5D0C6); padding: 8px 10px; border-radius: 2px;">
 <div style="font-family: var(--font-mono, monospace); font-size: 0.68rem; color: var(--text-muted, #686760);">Level 10: SaaS Dashboard UI</div>
 <div style="font-family: var(--font-mono, monospace); font-size: 0.82rem; font-weight: 600; color: var(--text-title, #20211F);">${(stats.l10Completed || 0) * 500} / 3,000 XP</div>
 </div>
 <div style="background: var(--canvas-base, #F1EEE7); border: 1px solid var(--border-subtle, #D5D0C6); padding: 8px 10px; border-radius: 2px; grid-column: 1 / -1;">
 <div style="font-family: var(--font-mono, monospace); font-size: 0.68rem; color: var(--text-muted, #686760);">Daily Exercises & Retention Streaks</div>
 <div style="font-family: var(--font-mono, monospace); font-size: 0.82rem; font-weight: 600; color: var(--accent-oxide, #A33B24);">+${(stats.dailyQuestXP + stats.streakBonusXP).toLocaleString()} XP (${stats.streakCount}-Day Streak)</div>
 </div>
 </div>

 <!-- Section: Rank Progression Roadmap -->
 <div style="text-align: left; margin-bottom: 16px;">
 <div style="font-family: var(--font-mono, monospace); font-size: 0.72rem; font-weight: 600; color: var(--text-muted, #686760); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 8px;">
 02 / DEVELOPER RANK PROGRESSION
 </div>
 <div style="display: flex; flex-direction: column; gap: 6px;">
 ${rankLadderHTML}
 </div>
 </div>

 <!-- Section: Creator Support Card -->
 <div style="background: var(--canvas-base, #F1EEE7); border: 1px solid var(--border-subtle, #D5D0C6); border-radius: 2px; padding: 14px; margin-bottom: 16px; text-align: left;">
 <div style="display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 6px;">
 <span style="font-family: var(--font-mono, monospace); font-size: 0.72rem; font-weight: 600; color: var(--accent-oxide, #A33B24); text-transform: uppercase;">
 03 / SUSTAINING THE OPEN ACCESS PROJECT
 </span>
 <span style="font-family: var(--font-mono, monospace); font-size: 0.68rem; color: var(--text-muted, #686760);">
 100% Free & Ad-Free
 </span>
 </div>
 <p style="font-size: 0.84rem; color: var(--text-body, #20211F); margin: 0 0 12px 0; line-height: 1.5;">
 NoviCodes is an independent, ad-free learning resource. If these 103 hands-on lessons help your engineering path, consider supporting hosting and authoring:
 </p>
 <div style="display: flex; gap: 8px; flex-wrap: wrap;">
 <a href="https://ko-fi.com/ralabs" target="_blank" rel="noopener noreferrer" style="flex: 1; min-width: 130px; background: var(--card-bg, #FFFFFF); color: var(--text-title, #20211F); text-decoration: none; padding: 8px 12px; border-radius: 2px; border: 1px solid var(--border-subtle, #D5D0C6); font-family: var(--font-mono, monospace); font-size: 0.76rem; font-weight: 600; display: inline-flex; align-items: center; justify-content: center; gap: 6px;">
 <span>SUPPORT // KO-FI (GLOBAL) →</span>
 </a>
 <a href="https://trakteer.id/ra-labs" target="_blank" rel="noopener noreferrer" style="flex: 1; min-width: 130px; background: var(--card-bg, #FFFFFF); color: var(--text-title, #20211F); text-decoration: none; padding: 8px 12px; border-radius: 2px; border: 1px solid var(--border-subtle, #D5D0C6); font-family: var(--font-mono, monospace); font-size: 0.76rem; font-weight: 600; display: inline-flex; align-items: center; justify-content: center; gap: 6px;">
 <span>SUPPORT // TRAKTEER (IDR) →</span>
 </a>
 </div>
 </div>

 <!-- Reset Progress Action -->
 <div style="border-top: 1px solid var(--border-hairline, #E5E1D8); padding-top: 12px; text-align: center;">
 <button onclick="window.confirmResetProgress()" style="background: transparent; border: 1px solid var(--border-subtle, #D5D0C6); color: var(--accent-oxide, #A33B24); padding: 6px 14px; border-radius: 2px; font-family: var(--font-mono, monospace); font-weight: 600; font-size: 0.74rem; cursor: pointer; text-transform: uppercase;">
 [ RESET PROGRESS DATA ]
 </button>
 </div>
 </div>
 `,
 showConfirmButton: false,
 showCloseButton: true,
 customClass: {
 popup: 'responsive-profile-modal'
 }
 });
 }
 };

 // ── 2. Proof-of-Work Certificates Modal (Universal) ──
 window.openCertificateHub = function() {
 const stats = getUserXPAndRank();
 const isUnlocked = localStorage.getItem('practice_mode_unlocked') === 'true';

 const isL4Earned = isUnlocked || stats.l4Completed >= 15;
 const isL5Earned = isUnlocked || stats.l5Completed >= 15;
 const isL6Earned = isUnlocked || stats.l6Completed >= 15;
 const isL7Earned = isUnlocked || (stats.l7BranchA >= 6 || stats.l7BranchB >= 6 || stats.l7BranchC >= 6 || stats.l7Completed >= 6);
 const isL8Earned = isUnlocked || (stats.l8Completed || 0) >= 6;
 const isL9Earned = isUnlocked || (stats.l9Completed || 0) >= 6;
 const isL10Earned = isUnlocked || (stats.l10Completed || 0) >= 6;

 const renderCertItem = (title: string, sub: string, url: string, isEarned: boolean, completedCount: number, maxCount: number) => {
 if (isEarned) {
 return `
 <a href="${url}" class="hub-modal-card" style="display: flex; align-items: center; justify-content: space-between; background: var(--canvas-base, #F1EEE7); border: 1px solid var(--border-subtle, #D5D0C6); padding: 12px 16px; border-radius: 2px; text-decoration: none; color: #20211F; transition: all 0.15s ease;">
 <div style="text-align: left; flex: 1;">
 <div style="font-weight: 600; font-size: 0.90rem;">${title}</div>
 <div style="font-size: 0.74rem; font-family: var(--font-mono, monospace); color: var(--text-muted, #686760);">${sub}</div>
 </div>
 <span class="badge-action" style="font-family: var(--font-mono, monospace); font-size: 0.76rem; font-weight: 600; color: var(--accent-oxide, #A33B24);">VIEW &rarr;</span>
 </a>
 `;
 } else {
 return `
 <div onclick="window.showCertLockWarning('${title}', ${completedCount}, ${maxCount})" class="hub-modal-card" style="display: flex; align-items: center; justify-content: space-between; background: var(--canvas-base, #F1EEE7); border: 1px dashed var(--border-subtle, #D5D0C6); padding: 12px 16px; border-radius: 2px; cursor: pointer; color: var(--text-muted, #686760); transition: all 0.15s ease;">
 <div style="text-align: left; flex: 1;">
 <div style="font-weight: 600; font-size: 0.90rem; color: var(--text-muted, #686760);">${title}</div>
 <div style="font-size: 0.74rem; font-family: var(--font-mono, monospace); color: var(--text-muted, #686760);">${sub} • ${completedCount}/${maxCount} COMPLETED</div>
 </div>
 <span class="badge-action" style="font-family: var(--font-mono, monospace); font-size: 0.72rem; font-weight: 600; color: var(--text-muted, #686760); background: var(--border-hairline, #E5E1D8); padding: 2px 6px; border-radius: 2px;">LOCKED</span>
 </div>
 `;
 }
 };

 const l4Item = renderCertItem('Level 04 Certificate', 'DOM & Vanilla JavaScript Widgets', '/2. partB/certificate.html', isL4Earned, stats.l4Completed, 15);
 const l5Item = renderCertItem('Level 05 Certificate', 'React Component Architecture', '/3. partC/certificate.html', isL5Earned, stats.l5Completed, 15);
 const l6Item = renderCertItem('Level 06 Certificate', 'Python Backend & REST APIs', '/5. partE/certificate.html', isL6Earned, stats.l6Completed, 15);
 const l7Item = renderCertItem('Level 07 Certificate', 'Specialized Developer Tracks', '/6. partF/certificate.html', isL7Earned, stats.l7Completed, 6);
 const l8Item = renderCertItem('Level 08 Certificate', 'Async UI & Loading States', '/7. partG/certificate.html', isL8Earned, stats.l8Completed || 0, 6);
 const l9Item = renderCertItem('Level 09 Certificate', 'User Logins & Private Member Pages', '/8. partH/certificate.html', isL9Earned, stats.l9Completed || 0, 6);
 const l10Item = renderCertItem('Level 10 Certificate', 'Modern SaaS Dashboard UI', '/9. partI/certificate.html', isL10Earned, stats.l10Completed || 0, 6);

 if (typeof window.Swal !== 'undefined') {
 window.Swal.fire({
 title: 'Proof-of-Work Certificates',
 customClass: {
 popup: 'responsive-profile-modal responsive-cert-hub-modal'
 },
 html: `
 <div style="text-align: center; font-family: var(--font-sans, sans-serif); padding: 6px 0;">
 <p style="color: var(--text-muted, #686760); font-size: 0.88rem; margin-bottom: 16px; line-height: 1.5;">
 Select an unlocked milestone to view, print, or download your official Proof of Work:
 </p>
 
 <div style="display: flex; flex-direction: column; gap: 8px;">
 ${l4Item}
 ${l5Item}
 ${l6Item}
 ${l7Item}
 ${l8Item}
 ${l9Item}
 ${l10Item}
 </div>
 </div>
 `,
 showConfirmButton: false,
 showCloseButton: true
 });
 } else {
 window.location.href = isL10Earned ? '/9. partI/certificate.html' : '/2. partB/certificate.html';
 }
 };

 // ── 3. Certificate Lock Warning Modal ──
 window.showCertLockWarning = function(title: string, completedCount: number, maxCount: number) {
 if (typeof window.Swal !== 'undefined') {
 window.Swal.fire({
 title: `${title} Locked`,
 html: `
 <div style="font-family: var(--font-sans, sans-serif); text-align: center;">
 <p style="color: var(--text-muted, #686760); font-size: 0.90rem; line-height: 1.5; margin-bottom: 12px;">
 Complete all lessons in <strong>${title}</strong> to unlock your verified Certificate of Mastery.
 </p>
 <div style="font-family: var(--font-mono, monospace); font-size: 0.80rem; font-weight: 600; color: var(--accent-oxide, #A33B24); background: var(--canvas-base, #F1EEE7); border: 1px solid var(--border-subtle, #D5D0C6); padding: 6px 12px; border-radius: 2px; display: inline-block;">
 PROGRESS: ${completedCount} / ${maxCount} LESSONS COMPLETED
 </div>
 </div>
 `,
 confirmButtonColor: '#A33B24',
 confirmButtonText: 'CLOSE',
 showCloseButton: true,
 customClass: {
 popup: 'responsive-profile-modal'
 }
 });
 }
 };

 // ── 4. Practical Dojo Level Selection Hub Modal ──
 window.openDojoHub = function() {
 const rawPath = decodeURIComponent(window.location.pathname).toLowerCase();
 const isL4 = rawPath.includes('partb/hub.html') || rawPath.includes('2. partb/hub.html');
 const isL5 = rawPath.includes('partc/hub.html') || rawPath.includes('3. partc/hub.html');
 const isL6 = rawPath.includes('parte/hub.html') || rawPath.includes('5. parte/hub.html');
 const isL7 = rawPath.includes('partf/hub.html') || rawPath.includes('6. partf/hub.html');
 const isL8 = rawPath.includes('partg/hub.html') || rawPath.includes('7. partg/hub.html');
 const isL9 = rawPath.includes('parth/hub.html') || rawPath.includes('8. parth/hub.html');
 const isL10 = rawPath.includes('parti/hub.html') || rawPath.includes('9. parti/hub.html');

 let activeL4 = 1;
 for (let i = 1; i <= 15; i++) {
 if (localStorage.getItem(`partB_lesson${i}_remake_complete`) === 'true') {
 activeL4 = Math.min(i + 1, 15);
 }
 }

 let activeL5 = 1;
 for (let i = 1; i <= 15; i++) {
 if (localStorage.getItem(`partC_lesson${i}_remake_complete`) === 'true') {
 activeL5 = Math.min(i + 1, 15);
 }
 }

 let activeL6 = 1;
 for (let i = 1; i <= 15; i++) {
 if (localStorage.getItem(`partE_lesson${i}_remake_complete`) === 'true') {
 activeL6 = Math.min(i + 1, 15);
 }
 }

 let activeL8 = 1;
 for (let i = 1; i <= 6; i++) {
 if (localStorage.getItem(`partG_lesson${i}_remake_complete`) === 'true') {
 activeL8 = Math.min(i + 1, 6);
 }
 }

 let activeL9 = 1;
 for (let i = 1; i <= 6; i++) {
 if (localStorage.getItem(`partH_lesson${i}_remake_complete`) === 'true') {
 activeL9 = Math.min(i + 1, 6);
 }
 }

 let activeL10 = 1;
 for (let i = 1; i <= 6; i++) {
 if (localStorage.getItem(`partI_lesson${i}_remake_complete`) === 'true') {
 activeL10 = Math.min(i + 1, 6);
 }
 }

 const renderDojoItem = (title: string, sub: string, url: string, isActive: boolean, iconSvg: string) => {
                if (isActive) {
                    return `
                        <div onclick="if(typeof Swal !== 'undefined') Swal.close()" class="hub-modal-card" style="display: flex; align-items: center; gap: 12px; justify-content: space-between; background: var(--canvas-base, #F1EEE7); border: 2px solid var(--accent-oxide, #A33B24); padding: 12px 14px; border-radius: 2px; cursor: pointer; color: #20211F; transition: all 0.15s ease;">
                            <div style="display: flex; align-items: center; gap: 10px; flex: 1; text-align: left;">
                                <div style="display: flex; align-items: center; justify-content: center; width: 34px; height: 34px; border-radius: 2px; background: rgba(163,59,36,0.1); color: var(--accent-oxide, #A33B24); flex-shrink: 0;">${iconSvg}</div>
                                <div>
                                    <div style="font-weight: 600; font-size: 0.88rem; color: var(--accent-oxide, #A33B24);">${title}</div>
                                    <div style="font-size: 0.72rem; font-family: var(--font-mono, monospace); color: var(--text-muted, #686760);">${sub}</div>
                                </div>
                            </div>
