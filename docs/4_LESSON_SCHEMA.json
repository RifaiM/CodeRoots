{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DevDojoLessonSchema",
  "type": "object",
  "required": [
    "trackId",
    "lessonId",
    "title",
    "description",
    "difficulty",
    "estimatedMinutes",
    "steps"
  ],
  "properties": {
    "trackId": {
      "type": "string",
      "enum": [
        "concepts-l0",
        "html-l1",
        "css-l2",
        "js-l3",
        "practical-l4",
        "frameworks-l5",
        "python-l6",
        "cloud-l7"
      ]
    },
    "lessonId": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "title": {
      "type": "string",
      "maxLength": 80
    },
    "description": {
      "type": "string",
      "maxLength": 300
    },
    "difficulty": {
      "type": "string",
      "enum": ["Beginner", "Intermediate", "Advanced"]
    },
    "estimatedMinutes": {
      "type": "integer",
      "minimum": 1
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "stepId",
          "title",
          "instructionsMarkdown",
          "initialCode",
          "solutionCode",
          "validation"
        ],
        "properties": {
          "stepId": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "instructionsMarkdown": {
            "type": "string"
          },
          "initialCode": {
            "type": "string"
          },
          "solutionCode": {
            "type": "string"
          },
          "hint": {
            "type": "string"
          },
          "validation": {
            "type": "object",
            "required": ["type", "rules"],
            "properties": {
              "type": {
                "type": "string",
                "enum": ["dom-query", "regex-match", "console-output", "python-eval"]
              },
              "rules": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["selectorOrRegex", "expected", "errorMessage"],
                  "properties": {
                    "selectorOrRegex": {
                      "type": "string"
                    },
                    "expected": {
                      "type": "string"
                    },
                    "errorMessage": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
